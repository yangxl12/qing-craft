@import "./styles/tokens.wxss";
@import "./styles/primitives.wxss";
@import "./styles/utilities.wxss";

page {
  background: var(--ui-bg);
  color: var(--ui-text);
  font-family: var(--font-body);
  font-size: var(--type-body-size);
  line-height: var(--type-body-line);
}

button { margin: 0; padding: 0; border-radius: var(--radius-md); font-size: var(--type-body-size); font-weight: 600; }
button::after { border: 0; }
.safe-top { height: env(safe-area-inset-top); min-height: 40rpx; }
.display { font-family: var(--font-display); font-weight: 500; letter-spacing: .08em; }
.btn-primary { height: 96rpx; line-height: 96rpx; background: var(--ink); color: var(--paper); }
.btn-secondary { height: 82rpx; line-height: 82rpx; background: var(--ui-surface); color: var(--ink); border: 1rpx solid var(--ui-border); }
.icon-btn { width: 88rpx; height: 88rpx; line-height: 88rpx; background: var(--ui-surface); color: var(--ink); }
.muted { color: var(--ink-soft); }
.eyebrow { font-size: 22rpx; letter-spacing: .18em; color: var(--celadon-deep); font-weight: 600; }
.panel { background: var(--ui-surface); border: 1rpx solid var(--ui-border); border-radius: var(--radius-lg); box-shadow: var(--elevation-1); }
