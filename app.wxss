page {
  --paper: #f5f7f2;
  --ash: #e9eee9;
  --ink: #202822;
  --ink-soft: #66716b;
  --celadon: #84a99a;
  --celadon-deep: #52796a;
  --clay: #b59d83;
  --ember: #e36b3e;
  --cobalt: #315e73;
  background: var(--ash);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button { margin: 0; padding: 0; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; }
button::after { border: 0; }
.safe-top { height: env(safe-area-inset-top); min-height: 40rpx; }
.display { font-family: "Songti SC", "STSong", serif; font-weight: 600; letter-spacing: .08em; }
.btn-primary { height: 96rpx; line-height: 96rpx; background: var(--ink); color: var(--paper); }
.btn-secondary { height: 82rpx; line-height: 82rpx; background: rgba(255,255,255,.64); color: var(--ink); border: 1rpx solid rgba(32,40,34,.12); }
.icon-btn { width: 72rpx; height: 72rpx; line-height: 72rpx; background: rgba(245,247,242,.88); color: var(--ink); }
.muted { color: var(--ink-soft); }
.eyebrow { font-size: 22rpx; letter-spacing: .18em; color: var(--celadon-deep); font-weight: 700; }
.panel { background: rgba(245,247,242,.92); border: 1rpx solid rgba(32,40,34,.1); border-radius: 32rpx; box-shadow: 0 16rpx 50rpx rgba(32,40,34,.08); }
