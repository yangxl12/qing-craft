<view class="gallery"><view class="safe-top"></view><view class="top"><button class="icon-btn" bindtap="back">‹</button><view class="display">我的作品</view><button class="icon-btn" bindtap="start">＋</button></view>
 <view class="intro"><view class="eyebrow">LOCAL COLLECTION · 本机作品集</view><view class="display heading">手作留下的，<br/>不止一个结果。</view></view>
 <view class="tabs"><view data-id="all" bindtap="chooseTab" class="{{tab==='all'?'active':''}}">全部 {{works.length}}</view><view data-id="draft" bindtap="chooseTab" class="{{tab==='draft'?'active':''}}">草稿</view><view data-id="completed" bindtap="chooseTab" class="{{tab==='completed'?'active':''}}">已完成</view></view>
 <view wx:if="{{works.length}}" class="grid"><view wx:for="{{works}}" wx:key="workId" wx:if="{{tab==='all'||tab===item.status}}" class="work-card" data-id="{{item.workId}}" bindtap="open"><view class="thumb status-{{item.status}}"><view class="mini-work shape-{{item.shapeId}}"></view><view class="stage-chip">{{item.status==='completed'?'已完成':'工序 '+(item.stageIndex+1)+'/7'}}</view></view><view class="work-name display">{{item.title}}</view><view class="work-meta">{{item.shapeId}} · {{item.clayId}}</view></view></view>
 <view wx:else class="empty"><view class="empty-rings"><view></view></view><view class="display">窑里还空着</view><text>先从一团泥开始，做你的第一件作品。</text><button class="btn-primary" bindtap="start">开始捏陶</button></view>
</view>
