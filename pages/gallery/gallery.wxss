.gallery-page { overflow-x: hidden; }
.gallery-page.is-selecting .gallery-body {
  padding-bottom: calc(216rpx + env(safe-area-inset-bottom));
}

.gallery-toolbar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--space-4);
  border-bottom: 1rpx solid var(--ui-border);
}
.gallery-tabs { min-width: 0; gap: 0; }
.gallery-tab {
  width: auto !important;
  min-width: 0;
  flex: 1;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-weight: 400;
  white-space: nowrap;
}
.gallery-tab::after { border: 0; }
.gallery-toolbar__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2);
}
.gallery-organize,
.gallery-create { flex: none; white-space: nowrap; }
.selection-hint {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  color: var(--ui-text-secondary);
  border-bottom: 1rpx solid var(--ui-border);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}
.selection-hint > text { min-width: 0; }
.selection-toggle-all { flex: none; }

.gallery-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--space-6);
  padding-top: var(--space-6);
}
.work-card {
  width: 100% !important;
  min-width: 0;
  min-height: 392rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  display: block;
  color: var(--ui-text);
  text-align: left;
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
  border-radius: var(--radius-md);
  box-shadow: var(--elevation-1);
  transition: transform var(--motion-fast) var(--ease-enter), border-color var(--motion-base) var(--ease-enter), background var(--motion-base) var(--ease-enter);
}
.work-card::after { border: 0; }
.work-card--pressed { transform: translateY(2rpx) scale(0.985); background: var(--ui-pressed-surface); }
.work-card.is-selected {
  border: 2rpx solid var(--ui-action);
  background: var(--ui-selected-surface);
}
.work-thumb {
  position: relative;
  height: 232rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--ui-preview-background);
}
.work-thumb.is-complete { background: var(--ui-preview-background-complete); }
.work-thumb.has-cover::after {
  content: "";
  position: absolute;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background: var(--ui-media-overlay);
}
.work-cover-image {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center center;
}
.mini-work {
  width: 104rpx;
  height: 136rpx;
  border-radius: 38%;
  background: var(--ui-pottery-preview);
  clip-path: polygon(27% 0, 73% 0, 80% 18%, 70% 40%, 86% 74%, 82% 100%, 18% 100%, 14% 74%, 30% 40%, 20% 18%);
  box-shadow: 12rpx 18rpx 24rpx var(--ui-pottery-shadow);
}
.work-thumb.is-complete .mini-work { background: var(--ui-pottery-preview-complete); }
.shape-bowl { height: 88rpx; clip-path: polygon(8% 10%, 92% 10%, 84% 65%, 70% 100%, 30% 100%, 16% 65%); }
.shape-plate { height: 52rpx; clip-path: ellipse(50% 48% at 50% 50%); }
.shape-jar { clip-path: polygon(30% 0, 70% 0, 78% 17%, 92% 48%, 82% 100%, 18% 100%, 8% 48%, 22% 17%); }
.stage-chip {
  position: absolute;
  z-index: 2;
  left: var(--space-3);
  bottom: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-xs);
  color: var(--ui-text-secondary);
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}
.work-thumb.is-complete .stage-chip {
  color: var(--ui-media-text);
  background: var(--ui-media-chip);
  border-color: var(--ui-border);
}
.card-check {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--ui-text-secondary);
  border-radius: var(--radius-full);
  background: var(--ui-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-check.is-checked { border-color: var(--ui-action); background: var(--ui-action); }
.work-name {
  padding: var(--space-4) var(--space-4) var(--space-1);
  overflow: hidden;
  color: var(--ui-text);
  font-family: var(--font-display);
  font-size: var(--type-body-size);
  line-height: var(--type-body-line);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.work-meta,
.work-time {
  padding: 0 var(--space-4);
  overflow: hidden;
  color: var(--ui-text-secondary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.work-time { padding-bottom: var(--space-4); }

.gallery-empty {
  margin-top: var(--space-10);
  padding: var(--space-12) var(--space-8);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.gallery-empty--first { margin-top: var(--space-12); }
.empty-moon {
  position: relative;
  width: 144rpx;
  height: 144rpx;
  margin-bottom: var(--space-8);
  border: 2rpx solid var(--ui-action);
  border-radius: var(--radius-full);
  box-shadow: inset 0 0 0 12rpx var(--ui-selected-surface);
}
.empty-title {
  font-family: var(--font-display);
  font-size: var(--type-h2-size);
  line-height: var(--type-h2-line);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.gallery-empty > text {
  margin: var(--space-3) 0 var(--space-8);
  color: var(--ui-text-secondary);
  font-size: var(--type-body-sm-size);
  line-height: var(--type-body-sm-line);
}

.gallery-action-bar {
  position: fixed;
  z-index: var(--z-nav);
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: var(--space-6);
}
.selection-count {
  min-width: 0;
  flex: 1;
  color: var(--ui-text-secondary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}
.selection-count text {
  color: var(--ui-danger);
  font-family: var(--font-data);
  font-size: var(--type-h3-size);
  font-weight: 600;
}
.gallery-delete { width: 240rpx !important; flex: none; }

.reduce-motion .work-card { transition: none; }

@media (max-width: 340px) {
  .ui-page-heading { gap: var(--space-4); }
  .ui-page-mark { width: 56rpx; height: 56rpx; }
  .gallery-toolbar { grid-template-columns: minmax(0, 1fr); padding-bottom: var(--space-2); }
  .gallery-toolbar__actions { justify-self: stretch; }
  .gallery-grid { gap: var(--space-4); }
  .work-thumb { height: 216rpx; }
  .gallery-action-bar { gap: var(--space-4); }
  .gallery-delete { width: 216rpx !important; }
}
