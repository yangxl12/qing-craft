.gallery{min-height:100vh;padding:0 30rpx 100rpx;box-sizing:border-box;background:linear-gradient(#eef2ed,#dfe7e1)}.top{height:100rpx;display:flex;align-items:center;justify-content:space-between}.top>.display{font-size:30rpx}.intro{padding:44rpx 10rpx 34rpx}.heading{font-size:56rpx;line-height:1.35;margin-top:16rpx}.tabs{display:flex;gap:42rpx;padding:20rpx 10rpx;border-bottom:1rpx solid rgba(32,40,34,.12)}.tabs view{font-size:23rpx;color:#748078;padding-bottom:14rpx}.tabs .active{color:#202822;font-weight:700;border-bottom:5rpx solid #84a99a}.grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-top:28rpx}.work-card{background:#f5f7f2;border-radius:26rpx;overflow:hidden;box-shadow:0 12rpx 30rpx rgba(32,40,34,.07)}.thumb{height:270rpx;background:linear-gradient(150deg,#aebcb3,#677269);position:relative;display:flex;align-items:center;justify-content:center}.status-completed{background:linear-gradient(150deg,#424c47,#252b28)}.mini-work{width:120rpx;height:154rpx;background:linear-gradient(100deg,#708f82,#c2d5cc,#5d7c70);clip-path:polygon(27% 0,73% 0,80% 18%,70% 40%,86% 74%,82% 100%,18% 100%,14% 74%,30% 40%,20% 18%);border-radius:38%;box-shadow:12rpx 20rpx 26rpx rgba(0,0,0,.28)}.shape-bowl{height:100rpx;clip-path:polygon(8% 10%,92% 10%,84% 65%,70% 100%,30% 100%,16% 65%)}.shape-plate{height:56rpx;clip-path:ellipse(50% 48% at 50% 50%)}.shape-jar{clip-path:polygon(30% 0,70% 0,78% 17%,92% 48%,82% 100%,18% 100%,8% 48%,22% 17%)}.stage-chip{position:absolute;left:14rpx;bottom:14rpx;background:rgba(31,38,34,.65);color:#fff;border-radius:999rpx;padding:8rpx 14rpx;font-size:17rpx}.work-name{font-size:28rpx;padding:20rpx 18rpx 6rpx}.work-meta{font-size:19rpx;color:#7a857e;padding:0 18rpx 22rpx}.empty{text-align:center;padding-top:160rpx}.empty-rings{width:230rpx;height:100rpx;border:2rpx solid #9baba1;border-radius:50%;margin:0 auto 46rpx;display:flex;align-items:center;justify-content:center}.empty-rings view{width:140rpx;height:54rpx;border:2rpx solid #b1bdb5;border-radius:50%}.empty>.display{font-size:42rpx}.empty>text{display:block;color:#748078;font-size:23rpx;margin:20rpx 0 50rpx}.empty button{width:360rpx;margin:auto}
