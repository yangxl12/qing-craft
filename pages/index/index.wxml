<view class="home {{entrance ? 'is-in' : ''}}">
  <view class="paper-grain"></view>
  <view class="safe-top"></view>

  <view class="topbar">
    <view class="brand">
      <view class="brand-seal display">窑</view>
      <view class="brand-copy">
        <view class="brand-name display">掌心窑</view>
        <view class="brand-en">PALM KILN</view>
      </view>
    </view>
    <button class="settings-btn" bindtap="settings" aria-label="工坊设置" hover-class="settings-btn--pressed">
      <view class="settings-glyph"><text></text><text></text><text></text></view>
    </button>
  </view>

  <view class="intro">
    <view class="intro-kicker"><text></text>宋韵陶艺工房</view>
    <view class="display title">一捧泥，<text>成一件心中器。</text></view>
    <view class="subtitle">循七道工序，在方寸之间慢慢塑成。</view>
  </view>

  <view class="hero-art" aria-label="月窗前陈设的天青釉瓷瓶">
    <image class="hero-image" src="/assets/home-song-celadon.jpg" mode="aspectFill"></image>
    <view class="hero-wash"></view>
    <view class="hero-caption">
      <view class="caption-rule"></view>
      <view>
        <view class="caption-title display">汝窑天青意象</view>
        <view class="caption-sub">雨过天青 · 温润如玉</view>
      </view>
    </view>
    <view class="hero-seal display">天青</view>
  </view>

  <view class="actions">
    <button wx:if="{{hasDraft}}" class="draft-card" bindtap="continueWork" hover-class="draft-card--pressed">
      <view class="draft-main">
        <view class="draft-kicker">续作 · 本机草稿</view>
        <view class="draft-title display">{{draftTitle}}</view>
      </view>
      <view class="draft-go">续作 <text>›</text></view>
    </button>

    <button class="start-btn" bindtap="start" hover-class="start-btn--pressed">
      <view class="start-copy">
        <view class="start-title">开始创作</view>
        <view class="start-sub">选器形、择泥料，开启七道工序</view>
      </view>
      <view class="start-arrow">→</view>
    </button>
  </view>

  <view class="bottom-nav">
    <view class="nav active"><text class="nav-dot"></text>创作</view>
    <view class="nav" bindtap="gallery">本机作品</view>
  </view>
</view>
