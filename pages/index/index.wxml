<view class="home {{entrance ? 'is-in' : ''}}">
  <view class="paper-grain"></view>
  <view class="safe-top" style="height:{{statusBarHeight}}px"></view>

  <view class="topbar" style="height:{{navigationBarHeight}}px">
    <view class="brand" aria-label="泥火青花">
      <image class="brand-logo" src="/assets/yao.png" mode="aspectFill"></image>
      <view class="brand-name display">泥火青花</view>
    </view>
  </view>

  <view class="intro">
    <view class="display title">一捧泥，<text>成一件心中器。</text></view>
    <view class="top-links">
      <button class="top-link" bindtap="gallery" aria-label="打开本机作品">作品</button>
      <button class="top-link" bindtap="settings" aria-label="打开工坊设置">设置</button>
    </view>
  </view>

  <view class="hero-art" aria-label="月窗前陈设的天青釉瓷瓶">
    <image class="hero-image" src="/assets/home-song-celadon.jpg" mode="aspectFill"></image>
    <view class="hero-wash"></view>
    <view class="hero-caption">
      <view class="caption-rule"></view>
      <view>
        <view class="caption-title display">汝窑天青意象</view>
        <view class="caption-sub">雨过天青 · 温润如玉</view>
      </view>
    </view>
    <view class="hero-seal display">天青</view>
  </view>

  <view class="actions">
    <button class="action action-primary" bindtap="start" hover-class="action--pressed">
      <text>开始</text><text class="action-arrow">→</text>
    </button>
    <button wx:if="{{hasDraft}}" class="action action-secondary" bindtap="continueWork" hover-class="action--pressed">
      <text>续作</text><text class="action-arrow">↗</text>
    </button>
    <button wx:else class="action action-secondary" bindtap="gallery" hover-class="action--pressed">
      <text>作品</text><text class="action-arrow">↗</text>
    </button>
  </view>
</view>
