.home {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 var(--page-gutter) calc(var(--space-8) + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  opacity: 0;
  transform: translateY(var(--space-3));
  transition: opacity var(--motion-stage) var(--ease-enter), transform var(--motion-stage) var(--ease-enter);
}
.home.is-in { opacity: 1; transform: none; }
.paper-grain {
  position: absolute;
  inset: 0;
  opacity: 0.34;
  pointer-events: none;
  background-image: var(--ui-paper-grain);
}
.home-safe-top,
.home-topbar,
.home-intro,
.hero-art,
.home-actions { position: relative; z-index: 1; }
.home-safe-top { min-height: 0; flex: none; }
.home-topbar {
  min-height: 88rpx;
  flex: none;
  display: flex;
  align-items: center;
}
.brand { display: flex; align-items: center; gap: var(--space-3); white-space: nowrap; }
.brand-logo {
  width: 64rpx;
  height: 64rpx;
  display: block;
  border-radius: var(--radius-sm);
  box-shadow: var(--elevation-1);
}
.brand-name {
  color: var(--ui-text);
  font-family: var(--font-display);
  font-size: var(--type-body-size);
  line-height: var(--type-body-line);
  font-weight: 500;
  letter-spacing: 0.08em;
}

.home-intro {
  min-height: 96rpx;
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-6) 0 var(--space-3);
}
.home-title {
  min-width: 0;
  flex: 1;
  color: var(--ui-text);
  font-family: var(--font-display);
  font-size: var(--type-h3-size);
  line-height: var(--type-h3-line);
  font-weight: 500;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.home-title text { color: var(--ui-action); }
.top-links { display: flex; flex: none; gap: var(--space-2); }
.top-link {
  width: 88rpx !important;
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--ui-border);
  border-radius: var(--radius-sm);
  color: var(--ui-text-secondary);
  background: var(--ui-surface);
  font-size: var(--type-body-sm-size);
  line-height: 88rpx;
  font-weight: 500;
  transition: transform var(--motion-fast) var(--ease-enter), background var(--motion-fast) var(--ease-enter);
}
.top-link::after { border: 0; }
.top-link:active { transform: scale(0.97); background: var(--ui-pressed-surface); }

.hero-art {
  flex: 1;
  min-height: 360rpx;
  margin: var(--space-4) 0 var(--space-6);
  overflow: hidden;
  border-radius: var(--radius-hero) var(--radius-hero) var(--radius-sm) var(--radius-hero);
  background: var(--ui-hero-placeholder);
  box-shadow: var(--elevation-2);
}
.hero-image { width: 100%; height: 100%; display: block; }
.hero-wash { position: absolute; inset: 0; pointer-events: none; background: var(--ui-media-overlay); }
.hero-caption {
  position: absolute;
  left: var(--space-8);
  bottom: var(--space-6);
  display: flex;
  align-items: center;
  gap: var(--space-4);
  color: var(--ui-media-text);
}
.caption-rule { width: 4rpx; height: 64rpx; border-radius: var(--radius-full); background: var(--ui-media-text-muted); }
.caption-title {
  font-family: var(--font-display);
  font-size: var(--type-body-lg-size);
  line-height: var(--type-body-lg-line);
  font-weight: 500;
  letter-spacing: 0.06em;
}
.caption-sub {
  margin-top: var(--space-1);
  color: var(--ui-media-text-muted);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}
.hero-seal {
  position: absolute;
  right: var(--space-6);
  top: var(--space-6);
  width: 48rpx;
  padding: var(--space-2) 0;
  box-sizing: border-box;
  border: 2rpx solid var(--ui-action);
  border-radius: var(--radius-xs);
  color: var(--ui-action);
  background: var(--ui-surface);
  font-family: var(--font-display);
  font-size: var(--type-micro-size);
  line-height: var(--type-micro-line);
  text-align: center;
}

.home-actions {
  flex: none;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  gap: var(--space-4);
}
.home-action { width: 100% !important; }

.home.reduce-motion {
  opacity: 1;
  transform: none;
  transition: none;
}
.reduce-motion .top-link { transition: none; }

@media (max-height: 760px) {
  .home-intro { padding-top: var(--space-3); padding-bottom: var(--space-2); }
  .hero-art { min-height: 320rpx; margin-top: var(--space-2); margin-bottom: var(--space-4); }
}

@media (max-width: 340px) {
  .home-intro { gap: var(--space-2); }
  .home-title { font-size: var(--type-body-lg-size); line-height: var(--type-body-lg-line); }
  .top-links { gap: var(--space-1); }
}
