.home {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 36rpx calc(32rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 86% 8%, rgba(73, 117, 158, .16), transparent 30%),
    linear-gradient(180deg, #f5f8fb 0%, #edf2f6 58%, #e7edf1 100%);
  opacity: 0;
  transform: translateY(12rpx);
  transition: opacity .55s ease, transform .55s ease;
}
.home.is-in { opacity: 1; transform: none; }
.paper-grain { position: absolute; inset: 0; opacity: .28; pointer-events: none; background-image: repeating-linear-gradient(17deg, rgba(31, 58, 83, .018) 0, rgba(31, 58, 83, .018) 1rpx, transparent 1rpx, transparent 9rpx), repeating-linear-gradient(102deg, rgba(255, 255, 255, .22) 0, rgba(255, 255, 255, .22) 1rpx, transparent 1rpx, transparent 12rpx); }
.safe-top, .topbar, .intro, .hero-art, .actions { position: relative; z-index: 1; }
.safe-top { min-height: 0; flex: none; }
.topbar { min-height: 88rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.top-links { margin-left: auto; display: flex; flex: none; gap: 8rpx; }
.top-link { width: auto !important; min-width: 68rpx; height: 50rpx; line-height: 48rpx; padding: 0 14rpx; border-radius: 15rpx; color: #536779; background: rgba(255, 255, 255, .5); border: 1rpx solid rgba(38, 78, 112, .12); font-size: 18rpx; font-weight: 500; letter-spacing: .08em; }
.brand { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 14rpx; white-space: nowrap; }
.brand-logo { width: 64rpx; height: 64rpx; display: block; border-radius: 17rpx; box-shadow: 0 7rpx 18rpx rgba(46, 83, 119, .16); }
.brand-name { color: #173d63; font-size: 27rpx; line-height: 1; letter-spacing: .14em; }
.intro { flex: none; min-height: 78rpx; padding: 30rpx 4rpx 14rpx; display: flex; align-items: center; gap: 20rpx; }
.title { min-width: 0; color: #1b3043; font-size: 29rpx; line-height: 1.35; font-weight: 500; letter-spacing: .035em; white-space: nowrap; }
.title text { color: #3f6f9a; }
.hero-art { flex: 1; min-height: 360rpx; margin-top: 24rpx; margin-bottom: 124rpx; overflow: hidden; border-radius: 42rpx 42rpx 12rpx 42rpx; background: #d6e0e8; box-shadow: 0 30rpx 70rpx rgba(39, 67, 91, .16); }
.hero-image { width: 100%; height: 100%; display: block; }
.hero-wash { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(18, 42, 62, 0) 58%, rgba(16, 36, 52, .68) 100%); }
.hero-caption { position: absolute; left: 30rpx; bottom: 27rpx; display: flex; align-items: center; gap: 18rpx; color: #fff; }
.caption-rule { width: 2rpx; height: 56rpx; background: rgba(224, 236, 244, .76); }
.caption-title { font-size: 27rpx; line-height: 1.2; font-weight: 500; letter-spacing: .13em; }
.caption-sub { margin-top: 7rpx; color: rgba(255, 255, 255, .72); font-size: 17rpx; letter-spacing: .16em; }
.hero-seal { position: absolute; right: 24rpx; top: 24rpx; width: 44rpx; padding: 10rpx 0; border: 1rpx solid rgba(38, 84, 126, .52); color: #315f88; background: rgba(241, 247, 251, .72); font-size: 18rpx; line-height: 1.3; text-align: center; }
.actions { position: absolute; z-index: 3; left: 36rpx; right: 36rpx; bottom: calc(32rpx + env(safe-area-inset-bottom)); display: flex; gap: 18rpx; }
.action { width: auto !important; flex: 1; height: 88rpx; padding: 0 26rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; letter-spacing: .12em; transition: transform .16s ease, opacity .16s ease; }
.action-primary { color: #f6f9fb; background: #183e62; box-shadow: 0 17rpx 38rpx rgba(24, 62, 98, .2); }
.action-secondary { color: #274d70; background: rgba(255, 255, 255, .62); border: 1rpx solid rgba(38, 78, 112, .15); }
.action-arrow { font-size: 29rpx; font-weight: 400; letter-spacing: 0; opacity: .72; }
.action--pressed { transform: scale(.975); opacity: .88; }
@media (max-height: 760px) {
  .intro { padding-top: 16rpx; padding-bottom: 8rpx; }
  .title { font-size: 27rpx; }
  .hero-art { min-height: 300rpx; margin-top: 16rpx; margin-bottom: 112rpx; }
  .actions { bottom: calc(22rpx + env(safe-area-inset-bottom)); }
  .action { height: 80rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .home, .action { transition: none; }
}
