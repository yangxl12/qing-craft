.home {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 36rpx 164rpx;
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle at 88% 7%, rgba(183, 201, 193, .26), transparent 30%), linear-gradient(180deg, #f4f2ec 0%, #eeece5 70%, #e8e7df 100%);
  opacity: 0;
  transform: translateY(12rpx);
  transition: opacity .6s ease, transform .6s ease;
}

.home.is-in { opacity: 1; transform: none; }

.paper-grain {
  position: absolute;
  inset: 0;
  opacity: .32;
  pointer-events: none;
  background-image: repeating-linear-gradient(17deg, rgba(43, 54, 49, .018) 0, rgba(43, 54, 49, .018) 1rpx, transparent 1rpx, transparent 8rpx), repeating-linear-gradient(102deg, rgba(255, 255, 255, .16) 0, rgba(255, 255, 255, .16) 1rpx, transparent 1rpx, transparent 11rpx);
}

.safe-top, .topbar, .intro, .hero-art, .actions { position: relative; z-index: 1; }
.topbar { height: 104rpx; padding-right: 118rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 18rpx; }

.brand-seal {
  width: 58rpx;
  height: 58rpx;
  border-radius: 5rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #914b40;
  color: #f4ede3;
  font-size: 30rpx;
  line-height: 1;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, .18);
}

.brand-name { color: #25302c; font-size: 30rpx; line-height: 1.05; letter-spacing: .18em; }
.brand-en { margin-top: 8rpx; color: #7c827e; font-size: 15rpx; line-height: 1; letter-spacing: .28em; }

.settings-btn {
  width: 66rpx !important;
  height: 66rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .42);
  border: 1rpx solid rgba(37, 48, 44, .12);
  transition: transform .18s ease, background .18s ease;
}

.settings-btn--pressed { transform: scale(.94); background: rgba(255, 255, 255, .75); }
.settings-glyph { width: 30rpx; display: flex; flex-direction: column; gap: 7rpx; }
.settings-glyph text { display: block; height: 2rpx; background: #34433d; }
.settings-glyph text:nth-child(1) { width: 20rpx; align-self: flex-end; }
.settings-glyph text:nth-child(2) { width: 30rpx; }
.settings-glyph text:nth-child(3) { width: 14rpx; align-self: flex-end; }

.intro { padding: 42rpx 6rpx 30rpx; }
.intro-kicker { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; color: #65716c; font-size: 19rpx; letter-spacing: .24em; }
.intro-kicker text { width: 42rpx; height: 1rpx; background: #788e85; }
.title { color: #202a26; font-size: 58rpx; line-height: 1.28; font-weight: 500; letter-spacing: .04em; }
.title text { color: #516a61; }
.subtitle { margin-top: 16rpx; color: #757b77; font-size: 23rpx; line-height: 1.6; letter-spacing: .08em; }

.hero-art {
  height: 560rpx;
  overflow: hidden;
  border-radius: 42rpx 42rpx 10rpx 42rpx;
  background: #d8d6cf;
  box-shadow: 0 28rpx 70rpx rgba(44, 53, 49, .16);
}

.hero-image { width: 100%; height: 100%; display: block; }
.hero-wash { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(23, 31, 28, 0) 56%, rgba(23, 31, 28, .66) 100%), linear-gradient(90deg, rgba(245, 241, 233, .08), transparent 42%); }
.hero-caption { position: absolute; left: 30rpx; bottom: 27rpx; display: flex; align-items: center; gap: 18rpx; color: #fff; }
.caption-rule { width: 2rpx; height: 58rpx; background: rgba(224, 236, 232, .74); }
.caption-title { font-size: 27rpx; line-height: 1.2; font-weight: 500; letter-spacing: .13em; text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .18); }
.caption-sub { margin-top: 7rpx; color: rgba(255, 255, 255, .72); font-size: 17rpx; letter-spacing: .16em; }

.hero-seal {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 44rpx;
  padding: 10rpx 0;
  box-sizing: border-box;
  border: 1rpx solid rgba(115, 68, 60, .72);
  color: #7e4940;
  background: rgba(242, 236, 226, .64);
  font-size: 18rpx;
  line-height: 1.3;
  text-align: center;
  letter-spacing: .08em;
}

.actions { margin-top: 28rpx; }
.draft-card, .start-btn { width: 100%; box-sizing: border-box; text-align: left; transition: transform .18s ease, opacity .18s ease; }

.draft-card {
  width: 100% !important;
  min-height: 112rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx 22rpx 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, .52);
  border: 1rpx solid rgba(50, 64, 58, .12);
  box-shadow: 0 10rpx 32rpx rgba(47, 58, 53, .05);
}

.draft-card--pressed, .start-btn--pressed { transform: scale(.985); opacity: .9; }
.draft-main { min-width: 0; }
.draft-kicker { color: #738079; font-size: 18rpx; line-height: 1; letter-spacing: .18em; }
.draft-title { max-width: 440rpx; margin-top: 12rpx; overflow: hidden; color: #26322d; font-size: 28rpx; line-height: 1.15; white-space: nowrap; text-overflow: ellipsis; }
.draft-go { flex: none; color: #526961; font-size: 21rpx; letter-spacing: .08em; }
.draft-go text { margin-left: 6rpx; font-size: 32rpx; vertical-align: -2rpx; }

.start-btn {
  width: 100% !important;
  min-height: 112rpx;
  padding: 23rpx 24rpx 23rpx 30rpx;
  border-radius: 12rpx 12rpx 36rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #293832;
  color: #f4f1e9;
  box-shadow: 0 18rpx 46rpx rgba(34, 48, 42, .18);
}

.start-title { font-size: 29rpx; line-height: 1.2; font-weight: 600; letter-spacing: .08em; }
.start-sub { margin-top: 9rpx; color: rgba(233, 239, 235, .58); font-size: 18rpx; line-height: 1.2; letter-spacing: .06em; }
.start-arrow { width: 62rpx; height: 62rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #9bb1a8; color: #24322d; font-size: 30rpx; font-weight: 400; }

.bottom-nav {
  position: fixed;
  z-index: 10;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 132rpx;
  background: rgba(240, 239, 232, .94);
  border-top: 1rpx solid rgba(37, 48, 44, .08);
  box-shadow: 0 -16rpx 46rpx rgba(47, 57, 52, .04);
}

.nav { position: relative; padding: 24rpx 12rpx; color: #7b817d; font-size: 22rpx; line-height: 1; letter-spacing: .08em; }
.nav.active { color: #27342f; font-weight: 600; }
.nav-dot { position: absolute; top: 8rpx; left: 50%; width: 7rpx; height: 7rpx; border-radius: 50%; background: #914b40; transform: translateX(-50%); }

@media (max-height: 760px) {
  .intro { padding-top: 24rpx; padding-bottom: 22rpx; }
  .hero-art { height: 500rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .home, .draft-card, .start-btn, .settings-btn { transition: none; }
}
