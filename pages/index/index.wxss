.home{min-height:100vh;box-sizing:border-box;padding:0 40rpx 150rpx;overflow:hidden;position:relative;opacity:0;transform:translateY(14rpx);transition:opacity .45s,transform .45s}.home.is-in{opacity:1;transform:none}.topbar{height:100rpx;display:flex;align-items:center;justify-content:space-between}.season{font-size:20rpx;color:#7c8881;margin-top:8rpx;letter-spacing:.12em}.hero{height:800rpx;position:relative}.hero-copy{position:relative;z-index:3;padding-top:42rpx}.title{font-size:74rpx;line-height:1.2}.title text{color:#52796a}.subtitle{font-size:26rpx;margin-top:28rpx;color:#66716b;letter-spacing:.05em}.window-light{position:absolute;width:600rpx;height:740rpx;right:-270rpx;top:-40rpx;background:linear-gradient(137deg,rgba(255,255,255,.9),rgba(255,255,255,0) 54%);transform:skewX(-8deg);z-index:2;pointer-events:none}.pot-scene{position:absolute;left:-40rpx;right:-40rpx;bottom:0;height:540rpx;background:linear-gradient(180deg,#cbd6ce 0,#aab9ae 43%,#6f675b 44%,#383832 100%);border-radius:48rpx;overflow:hidden;box-shadow:0 24rpx 80rpx rgba(32,40,34,.18)}.shelf{height:96rpx;position:absolute;top:54rpx;left:44rpx;right:44rpx;border-bottom:12rpx solid rgba(67,59,49,.72);display:flex;gap:52rpx;align-items:flex-end;padding-left:32rpx}.mini-pot{width:64rpx;height:48rpx;background:#d7ddd3;border-radius:16rpx 16rpx 28rpx 28rpx;box-shadow:inset 10rpx 0 12rpx rgba(255,255,255,.35)}.p2{height:68rpx;border-radius:30rpx 30rpx 18rpx 18rpx}.p3{width:82rpx;height:54rpx}.wheel{position:absolute;width:560rpx;height:156rpx;border-radius:50%;background:#9b8f7f;left:50%;bottom:34rpx;transform:translateX(-50%);box-shadow:0 30rpx 30rpx rgba(0,0,0,.25),inset 0 12rpx 0 #c7b8a0}.wheel-ring{position:absolute;inset:22rpx;border-radius:50%;border:2rpx solid rgba(71,66,58,.28)}.wheel-ring.r2{inset:48rpx}.pot{position:absolute;z-index:2;width:250rpx;height:258rpx;left:50%;bottom:106rpx;transform:translateX(-50%);background:radial-gradient(ellipse at 30% 35%,#fff 0,#ecece4 24%,#c9cec4 68%,#969d94 100%);border-radius:38% 38% 24% 24%/18% 18% 12% 12%;clip-path:polygon(26% 0,74% 0,78% 10%,72% 25%,85% 48%,92% 82%,82% 100%,18% 100%,8% 82%,15% 48%,28% 25%,22% 10%);box-shadow:10rpx 30rpx 32rpx rgba(26,29,25,.34)}.pot-rim{position:absolute;top:0;left:50%;width:108rpx;height:30rpx;border-radius:50%;background:#858e84;transform:translateX(-50%);box-shadow:inset 0 9rpx 0 #cdd2ca}.pot-shine{position:absolute;left:62rpx;top:60rpx;width:22rpx;height:120rpx;background:rgba(255,255,255,.38);filter:blur(8rpx);border-radius:50%}.process-ring{position:absolute;z-index:3;left:50%;bottom:14rpx;width:600rpx;height:180rpx;transform:translateX(-50%);display:flex;justify-content:space-around;align-items:flex-end;pointer-events:none}.process-dot{width:46rpx;height:46rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#474841;color:#d9ddd7;font-size:20rpx;border:2rpx solid rgba(255,255,255,.18)}.process-dot:nth-child(2),.process-dot:nth-child(6){margin-bottom:44rpx}.process-dot:nth-child(3),.process-dot:nth-child(5){margin-bottom:72rpx}.process-dot:nth-child(4){margin-bottom:84rpx}.process-dot.active{background:#84a99a;color:#fff;box-shadow:0 0 0 10rpx rgba(132,169,154,.18)}.actions{margin-top:34rpx}.start{width:100%;display:flex;align-items:center;justify-content:space-between;padding:0 38rpx}.start text{font-size:22rpx;color:#cdd9d1;font-weight:400}.draft{width:100%;padding:28rpx 30rpx;margin-bottom:20rpx;text-align:left;position:relative}.draft-meta{display:flex;justify-content:space-between;font-size:22rpx;color:#52796a}.draft-state{color:#7b877f}.draft-title{font-size:34rpx;margin-top:12rpx}.draft-arrow{position:absolute;right:30rpx;bottom:30rpx;color:#52796a;font-size:24rpx}.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:118rpx;padding-bottom:env(safe-area-inset-bottom);background:rgba(245,247,242,.95);display:flex;align-items:center;justify-content:center;gap:120rpx;border-top:1rpx solid rgba(32,40,34,.08);z-index:10}.nav{color:#78847d;font-size:24rpx;padding:24rpx;position:relative}.nav.active{color:#202822;font-weight:700}.nav-mark{display:block;width:30rpx;height:6rpx;border-radius:4rpx;background:#84a99a;position:absolute;top:8rpx;left:50%;transform:translateX(-50%)}
