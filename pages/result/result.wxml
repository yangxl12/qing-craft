<view class="result">
 <view class="result-bg" aria-hidden="true">
  <image class="result-bg-image" src="/assets/studio-decoration-workshop.jpg" mode="aspectFill"></image>
  <view class="result-bg-grade"></view>
 </view>
 <view class="safe-top" style="height:{{navTop}}px"></view>
 <view class="top">
  <view class="nav-btn" role="button" aria-label="返回首页" bindtap="backHome"><text>‹</text></view>
  <view class="nav-center">
   <view class="nav-rule" aria-hidden="true"></view>
   <view class="top-title display">成品展台</view>
   <view class="nav-rule" aria-hidden="true"></view>
  </view>
  <view class="nav-btn" role="button" aria-label="查看作品信息" bindtap="toggleInfo">
   <view class="nav-dots" aria-hidden="true"><view></view><view></view><view></view></view>
  </view>
 </view>
 <view class="reveal">
  <view class="eyebrow">七道工序 · 已完成</view>
  <view class="display name">{{work.title}}</view>
  <view class="note">拖动细看，釉色已在光里定住。</view>
 </view>
 <view class="scene">
  <view class="spotlight" aria-hidden="true"></view>
  <canvas wx:if="{{!fallback}}" id="resultCanvas" type="webgl" class="result-canvas" disable-scroll="true" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"></canvas>
  <view wx:else class="result-pot">
   <view class="result-fallback-pattern">{{workInfo.primaryGlyph}}</view>
   <view wx:if="{{work.decorationComposition.inscription}}" class="result-fallback-mark">{{work.decorationComposition.inscription.text}}</view>
  </view>
  <view class="plinth" aria-hidden="true">
   <view class="plinth-shadow"></view>
   <view class="plinth-foot"></view>
   <view class="plinth-body"></view>
   <view class="plinth-lip"></view>
   <view class="plinth-plate"></view>
   <view class="plinth-contact"></view>
 </view>
 </view>
 <view class="scene-spacer"></view>
 <canvas id="posterCanvas" type="2d" class="poster-canvas"></canvas>
 <view class="actions">
  <button class="action-primary" bindtap="exportWork" loading="{{exporting}}">生成作品图</button>
  <button class="action-secondary" bindtap="exportPoster">纪念海报</button>
  <button class="action-share" open-type="share" aria-label="分享这件作品">↗</button>
 </view>
 <block wx:if="{{infoOpen}}">
  <view class="info-mask" bindtap="toggleInfo" aria-label="关闭作品信息"></view>
  <view class="info-sheet" catchtap="noop">
   <view class="sheet-handle" aria-hidden="true"></view>
   <view class="sheet-head">
    <view class="sheet-seal display" aria-hidden="true">器</view>
    <view class="display sheet-title">这件作品</view>
   </view>
   <view class="sheet-divider" aria-hidden="true"><view class="sheet-diamond"></view></view>
   <view class="info-row"><text>名称</text><text>{{work.title}}</text></view>
   <view class="info-row"><text>器物</text><text>{{workInfo.shape}} · {{workInfo.clay}} · {{workInfo.glaze}}</text></view>
   <view class="info-row"><text>风格</text><text>{{workInfo.style}}</text></view>
   <view class="info-row"><text>纹样</text><text>{{workInfo.motifs}}</text></view>
   <view class="info-row"><text>工艺</text><text>{{workInfo.techniques}}</text></view>
   <view class="meaning-card"><text>纹样小记</text><view>{{workInfo.meaning}}</view></view>
   <view class="info-row inscription-row"><text>款识</text><text>{{workInfo.inscription}}</text></view>
   <button class="sheet-cta" bindtap="copy">沿用纹样再做一件</button>
   <view class="sheet-mini-row">
    <button class="sheet-mini" bindtap="rename">修改名称</button>
    <button class="sheet-mini danger" bindtap="remove">删除作品</button>
   </view>
  </view>
 </block>
 <view wx:if="{{preview}}" class="preview" style="padding-top:{{navTop}}px">
  <view class="preview-top">
   <view class="preview-back" role="button" aria-label="返回成品展台" bindtap="closePreview"><text>‹</text><text>返回</text></view>
   <view class="preview-type display">{{previewType}}</view>
  </view>
  <image src="{{preview}}" mode="aspectFit"></image>
  <button class="save" bindtap="saveImage">保存到相册</button>
 </view>
</view>
