.result {
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #526159;
  color: #f5f7f2;
  transition: background 0.3s;
  display: flex;
  flex-direction: column;
}
.light-museum {
  background: #191e1c;
}
.light-window {
  background: #aebcb4;
  color: #202822;
}
/* 展台区：顶栏与灯光条之间的可视区域，flex 自适应高度 */
.scene {
  position: relative;
  flex: 1;
  min-height: 0;
  z-index: 1;
}
.scene-spacer {
  flex: none;
  height: 270rpx;
}
.result-canvas {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  z-index: 2;
}
/* 与引擎的器底可见接触线共用 70%，不同器形都会稳稳落在台面上。 */
.plinth {
  position: absolute;
  left: 50%;
  top: 70%;
  transform: translateX(-50%);
  width: 640rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at 50% 44%,
    #4a463f 0%,
    #3c3933 55%,
    #2c2a26 100%
  );
  box-shadow:
    0 34rpx 50rpx rgba(0, 0, 0, 0.45),
    inset 0 14rpx 0 rgba(255, 255, 255, 0.08);
}
.plinth:after {
  content: "";
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 300rpx;
  height: 62rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(8, 10, 9, 0.5), rgba(8, 10, 9, 0) 72%);
}
.shine {
  position: absolute;
  right: -100rpx;
  top: -80rpx;
  width: 560rpx;
  height: 1100rpx;
  background: linear-gradient(
    145deg,
    rgba(255, 255, 240, 0.3),
    transparent 55%
  );
  transform: skewX(-12deg);
}
.top {
  position: relative;
  z-index: 5;
  height: 90rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.top button {
  width: 66rpx;
  height: 66rpx;
  line-height: 66rpx;
  background: rgba(23, 28, 25, 0.42);
  color: #fff;
}
.top .display {
  font-size: 28rpx;
}
.reveal {
  position: absolute;
  z-index: 4;
  top: 160rpx;
  left: 34rpx;
  text-shadow: 0 3rpx 16rpx rgba(0, 0, 0, 0.28);
}
.reveal .eyebrow {
  color: #d5e5dd;
}
.name {
  font-size: 50rpx;
  margin-top: 8rpx;
}
.note {
  font-size: 22rpx;
  margin-top: 10rpx;
  opacity: 0.72;
}
.lights {
  position: absolute;
  z-index: 5;
  left: 50%;
  bottom: 300rpx;
  transform: translateX(-50%);
  display: flex;
  padding: 7rpx;
  border-radius: 999rpx;
  background: rgba(25, 29, 26, 0.55);
  white-space: nowrap;
}
.lights view {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #d7ded9;
}
.lights view.active {
  background: #f5f7f2;
  color: #202822;
}
.actions {
  position: absolute;
  z-index: 6;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1.4fr 1fr 0.55fr;
  gap: 12rpx;
}
.actions button {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 23rpx;
}
.primary {
  background: #f5f7f2;
  color: #202822;
}
.secondary,
.share {
  background: rgba(28, 34, 30, 0.72);
  color: #f5f7f2;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.info {
  position: absolute;
  z-index: 10;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  padding: 22rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  color: #202822;
}
.handle {
  width: 70rpx;
  height: 7rpx;
  border-radius: 8rpx;
  background: #ccd3ce;
  margin: 0 auto 24rpx;
}
.info-title {
  font-size: 38rpx;
  margin-bottom: 18rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 19rpx 0;
  border-bottom: 1rpx solid #dde2dd;
}
.info-row text:first-child {
  color: #78847d;
}
.info-buttons {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}
.info-buttons button {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  background: #e2e8e3;
  color: #202822;
  font-size: 21rpx;
}
.info-buttons .danger {
  color: #a54b37;
}
.preview {
  position: absolute;
  z-index: 30;
  inset: 0;
  background: #17201c;
  padding: calc(30rpx + env(safe-area-inset-top)) 26rpx
    calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}
.preview-top {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.preview-top button {
  width: 62rpx;
  height: 62rpx;
  line-height: 62rpx;
  background: #34423b;
  color: #fff;
}
.preview image {
  width: 100%;
  flex: 1;
}
.save {
  height: 90rpx;
  line-height: 90rpx;
  background: #f5f7f2;
  color: #202822;
}
.poster-canvas {
  position: absolute;
  width: 1px;
  height: 1px;
  left: -9999px;
}
.result-pot {
  position: absolute;
  z-index: 2;
  width: 260rpx;
  height: 350rpx;
  left: 50%;
  top: 52%;
  transform: translate(-50%, -50%);
  background: linear-gradient(100deg, #52796a, #a9c4b8, #476f60);
  clip-path: polygon(
    27% 0,
    73% 0,
    80% 16%,
    70% 40%,
    87% 70%,
    84% 100%,
    16% 100%,
    13% 70%,
    30% 40%,
    20% 16%
  );
  border-radius: 38%;
  box-shadow: 20rpx 30rpx 38rpx rgba(0, 0, 0, 0.38);
}
.result-fallback-pattern {
  position: absolute;
  left: 50%;
  top: 45%;
  transform: translate(-50%, -50%);
  color: #214f69;
  font-family: "Songti SC", serif;
  font-size: 82rpx;
  text-shadow: 0 2rpx 0 rgba(255,255,255,.18);
}
.result-fallback-mark {
  position: absolute;
  right: 34rpx;
  bottom: 38rpx;
  max-width: 80rpx;
  padding: 5rpx;
  border: 3rpx solid #a84f43;
  color: #a84f43;
  font-family: "Songti SC", serif;
  font-size: 15rpx;
  line-height: 1.15;
  white-space: pre-line;
}
.decor-info {
  max-height: 76vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.decor-info .info-row text:last-child {
  max-width: 70%;
  text-align: right;
  white-space: pre-line;
}
.meaning-card {
  margin: 18rpx 0 4rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  color: #3f5148;
  background: #e3ebe5;
}
.meaning-card text {
  display: block;
  margin-bottom: 7rpx;
  color: #52796a;
  font-size: 18rpx;
  font-weight: 700;
}
.meaning-card view {
  font-size: 20rpx;
  line-height: 1.5;
}
.continue-pattern {
  width: 100%;
  height: 88rpx;
  margin-top: 22rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #496f5f;
  font-size: 22rpx;
  line-height: 88rpx;
  font-weight: 700;
}
.continue-pattern:after { border: 0; }
.decor-info .info-buttons button { height: 88rpx; line-height: 88rpx; }
