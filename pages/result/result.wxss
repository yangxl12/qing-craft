.result {
  position: relative;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--ui-text);
  background: var(--color-workshop-bg);
  isolation: isolate;
}

.result button { margin: 0; box-sizing: border-box; font-family: var(--font-body); }
.result button::after { border: 0; }
.result button:active { transform: translateY(2rpx) scale(0.98); }
.result button[disabled] { opacity: var(--ui-disabled-opacity); pointer-events: none; }

.result-bg { position: absolute; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; }
.result-bg-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.result-bg-grade { position: absolute; inset: 0; background: linear-gradient(180deg, var(--ui-workshop-scrim-strong) 0, var(--ui-workshop-scrim) 25%, transparent 54%, var(--ui-workshop-scrim-strong) 100%), radial-gradient(64% 58% at 50% 48%, transparent 0, transparent 54%, var(--ui-workshop-scrim) 100%); }

.result > app-nav { position: relative; z-index: 60; flex: none; }

.reveal {
  position: relative;
  z-index: 20;
  flex: none;
  padding: var(--space-4) var(--page-gutter) var(--space-6);
  background: linear-gradient(180deg, var(--ui-workshop-scrim-strong), transparent);
  text-align: center;
}

.reveal::after { content: ""; position: absolute; left: 50%; bottom: var(--space-2); width: 128rpx; height: 4rpx; border-radius: var(--radius-full); background: linear-gradient(90deg, var(--color-on-dark), var(--color-celadon-300)); transform: translateX(-50%); }
.reveal .eyebrow { color: var(--color-on-dark-muted); font-size: var(--type-caption-size); line-height: var(--type-caption-line); letter-spacing: 0.06em; }
.name { margin-top: var(--space-1); overflow: hidden; color: var(--color-on-dark); font-size: var(--type-h1-size); line-height: var(--type-h1-line); font-weight: 500; letter-spacing: 0.04em; text-overflow: ellipsis; white-space: nowrap; }

.scene { position: relative; z-index: 10; min-height: 0; flex: 1; overflow: hidden; }
.result-canvas { position: absolute; z-index: 12; inset: 0; width: 100%; height: 100%; }
.spotlight { position: absolute; z-index: 2; left: 50%; top: 4%; width: 72%; height: 76%; border-radius: 50%; background: radial-gradient(ellipse, var(--ui-workshop-highlight) 0, transparent 68%); filter: blur(14rpx); transform: translateX(-50%); }

.result-pot { position: absolute; z-index: 12; left: 50%; bottom: 112rpx; width: 320rpx; height: 430rpx; border-radius: 32% 32% 44% 44% / 16% 16% 40% 40%; display: flex; align-items: center; justify-content: center; color: var(--color-cobalt); background: linear-gradient(100deg, var(--color-celadon-500), var(--color-on-dark) 48%, var(--color-celadon-300)); box-shadow: inset 24rpx 0 38rpx var(--ui-workshop-highlight), 0 28rpx 54rpx var(--ui-workshop-shadow); transform: translateX(-50%); }
.result-pot::before { content: ""; position: absolute; left: 50%; top: -18rpx; width: 118rpx; height: 46rpx; border-radius: 50%; background: var(--color-workshop-surface); box-shadow: inset 0 10rpx 12rpx var(--ui-workshop-shadow), 0 0 0 10rpx var(--color-on-dark-muted); transform: translateX(-50%); }
.result-fallback-pattern { font-family: var(--font-display); font-size: var(--type-display-size); line-height: var(--type-display-line); }
.result-fallback-mark { position: absolute; right: 48rpx; bottom: 56rpx; color: var(--color-cinnabar); font-family: var(--font-display); font-size: var(--type-body-sm-size); }

.plinth { position: absolute; z-index: 11; left: 50%; bottom: 44rpx; width: 520rpx; height: 120rpx; transform: translateX(-50%); }
.plinth-shadow { position: absolute; left: 8%; right: 0; bottom: 0; height: 34rpx; border-radius: 50%; background: var(--ui-workshop-shadow); filter: blur(12rpx); transform: skewX(-10deg); }
.plinth-top { position: absolute; left: 3%; right: 3%; top: 8rpx; height: 56rpx; border-radius: 50%; background: radial-gradient(ellipse at 42% 30%, var(--ui-workshop-highlight), var(--color-workshop-surface) 50%, var(--color-workshop-bg) 100%); border: 1rpx solid var(--ui-workshop-border); }
.plinth-rim { position: absolute; z-index: 2; left: 6%; right: 6%; top: 42rpx; height: 42rpx; border-radius: 0 0 var(--radius-lg) var(--radius-lg); background: var(--color-workshop-surface); border: 1rpx solid var(--ui-workshop-border); }
.plinth-contact { position: absolute; z-index: 3; left: 25%; right: 25%; top: 12rpx; height: 24rpx; border-radius: 50%; background: var(--ui-workshop-shadow); filter: blur(6rpx); }
.plinth-apron { position: absolute; z-index: 1; left: 13%; right: 13%; top: 62rpx; height: 38rpx; border-radius: 0 0 var(--radius-md) var(--radius-md); background: var(--ui-workshop-panel); border: 1rpx solid var(--ui-workshop-border); }
.plinth-feet { position: absolute; left: 17%; right: 17%; bottom: 4rpx; display: flex; justify-content: space-between; }
.plinth-foot { width: 60rpx; height: 34rpx; border-radius: 0 0 var(--radius-sm) var(--radius-sm); background: var(--color-workshop-surface); }
.plinth-cloud,
.plinth-cloud-pearl { display: none; }

.poster-canvas { position: fixed; left: -2200px; top: -2200px; width: 1080px; height: 1440px; opacity: 0; pointer-events: none; }

.result-actions-wrap {
  position: relative;
  z-index: 40;
  flex: none;
  padding: var(--space-3) var(--page-gutter) calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--ui-workshop-panel);
  border-top: 1rpx solid var(--ui-workshop-border);
  box-shadow: 0 -18rpx 48rpx var(--ui-workshop-shadow);
  backdrop-filter: blur(18rpx);
}

.actions { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) 88rpx; gap: var(--space-3); }
.actions > button { min-width: 0 !important; min-height: 88rpx; padding: 0 var(--space-4); gap: var(--space-2); border-radius: var(--radius-md); font-size: var(--type-body-size); line-height: var(--type-body-line); font-weight: 600; }
.action-primary { color: var(--ui-action-text) !important; background: var(--color-celadon-300) !important; box-shadow: var(--elevation-1); }
.action-secondary { color: var(--color-on-dark) !important; background: var(--ui-workshop-panel-soft) !important; border: 1rpx solid var(--ui-workshop-border) !important; }
.action-share { width: 88rpx !important; padding: 0 !important; color: var(--color-on-dark) !important; background: var(--ui-workshop-panel-soft) !important; border: 1rpx solid var(--ui-workshop-border) !important; border-radius: var(--radius-full) !important; }
.action-feedback { min-height: 44rpx; margin-top: var(--space-2); display: flex; align-items: center; justify-content: center; gap: var(--space-2); color: var(--ui-kiln-muted); font-size: var(--type-caption-size); line-height: var(--type-caption-line); text-align: center; }

.info-mask { position: fixed; z-index: 90; inset: 0; background: var(--ui-overlay); }
.info-sheet { position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; max-height: 78vh; padding: var(--space-2) var(--page-gutter) 0; box-sizing: border-box; display: flex; flex-direction: column; color: var(--color-text); background: var(--ui-porcelain-panel-solid); border-top: 1rpx solid var(--ui-porcelain-border); border-radius: var(--radius-lg) var(--radius-lg) 0 0; box-shadow: var(--elevation-3); animation: result-sheet-in var(--motion-overlay) var(--ease-enter) both; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: var(--space-2) auto; border-radius: var(--radius-full); background: var(--color-border); }
.sheet-head { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.sheet-heading-copy { display: flex; align-items: center; gap: var(--space-3); }
.sheet-seal { width: 56rpx; height: 56rpx; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; color: var(--ui-accent-text); background: var(--ui-accent); font-size: var(--type-h3-size); line-height: var(--type-h3-line); box-shadow: inset 0 0 0 2rpx var(--ui-accent-text); }
.sheet-title { font-size: var(--type-h2-size); line-height: var(--type-h2-line); font-weight: 500; }
.sheet-close { width: 80rpx !important; min-width: 80rpx !important; height: 80rpx; padding: 0; color: var(--color-text) !important; background: var(--ui-surface-subtle) !important; border-radius: var(--radius-full) !important; }
.sheet-divider { width: 120rpx; height: 4rpx; margin-bottom: var(--space-3); border-radius: var(--radius-full); background: linear-gradient(90deg, var(--color-text), var(--color-celadon-300)); }
.info-scroll { min-height: 0; flex: 1; }
.info-row { min-height: 80rpx; padding: var(--space-3) 0; box-sizing: border-box; display: grid; grid-template-columns: 120rpx minmax(0, 1fr); align-items: start; gap: var(--space-4); border-bottom: 1rpx solid var(--ui-border); }
.info-row > text:first-child { color: var(--color-text-secondary); font-size: var(--type-caption-size); line-height: var(--type-caption-line); }
.info-row > text:last-child { min-width: 0; color: var(--color-text); font-size: var(--type-body-sm-size); line-height: var(--type-body-sm-line); text-align: right; overflow-wrap: anywhere; }
.meaning-card { margin: var(--space-4) 0; padding: var(--space-4); color: var(--color-text); background: var(--ui-surface-subtle); border-radius: var(--radius-md); }
.meaning-card > text { color: var(--color-text-secondary); font-size: var(--type-caption-size); line-height: var(--type-caption-line); }
.meaning-card > view { margin-top: var(--space-2); font-size: var(--type-body-sm-size); line-height: var(--type-body-sm-line); }
.sheet-cta { width: 100% !important; min-height: 88rpx; margin-top: var(--space-4) !important; color: var(--ui-action-text) !important; background: var(--ui-action) !important; border-radius: var(--radius-md) !important; font-size: var(--type-body-size) !important; font-weight: 600; }
.sheet-mini-row { margin-top: var(--space-3); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-3); }
.sheet-mini { min-width: 0 !important; min-height: 88rpx; padding: 0 var(--space-3) !important; gap: var(--space-2); color: var(--color-text) !important; background: var(--ui-surface) !important; border: 1rpx solid var(--ui-border) !important; border-radius: var(--radius-md) !important; font-size: var(--type-body-sm-size) !important; }
.sheet-mini.danger { color: var(--ui-danger) !important; border-color: var(--ui-danger) !important; }
.sheet-safe-space { height: calc(var(--space-6) + env(safe-area-inset-bottom)); }

.preview { position: fixed; z-index: 120; inset: 0; display: flex; flex-direction: column; color: var(--ui-text); background: var(--ui-content-backdrop); animation: preview-in var(--motion-overlay) var(--ease-enter) both; }
.preview > app-nav { flex: none; }
.preview-body { min-height: 0; flex: 1; }
.preview-frame { margin: var(--space-6) var(--page-gutter) 0; padding: var(--space-3); background: var(--ui-surface); border: 1rpx solid var(--ui-border); border-radius: var(--radius-md); box-shadow: var(--elevation-1); }
.preview-frame > image { display: block; width: 100%; height: 55vh; border-radius: var(--radius-sm); background: var(--ui-surface-subtle); }
.preview-copy { padding: var(--space-6) var(--page-gutter) var(--space-3); }
.preview-title { color: var(--ui-text); font-size: var(--type-h2-size); line-height: var(--type-h2-line); }
.preview-copy > text { display: block; margin-top: var(--space-2); color: var(--ui-text-secondary); font-size: var(--type-body-sm-size); line-height: var(--type-body-sm-line); }
.preview-status { min-height: 48rpx; margin: 0 var(--page-gutter) var(--space-3); display: flex; align-items: center; justify-content: center; gap: var(--space-2); color: var(--color-info); font-size: var(--type-caption-size); line-height: var(--type-caption-line); text-align: center; }
.preview-status.is-success { color: var(--color-success); }
.save { width: calc(100% - 64rpx) !important; min-height: 88rpx; margin: 0 var(--page-gutter) !important; gap: var(--space-2); color: var(--ui-action-text) !important; background: var(--ui-action) !important; border-radius: var(--radius-md) !important; font-size: var(--type-body-size) !important; font-weight: 600; }
.preview-safe-space { height: calc(var(--space-6) + env(safe-area-inset-bottom)); }

@keyframes result-sheet-in { from { opacity: 0; transform: translateY(36rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes preview-in { from { opacity: 0; } to { opacity: 1; } }

.reduce-motion .info-sheet,
.reduce-motion .preview,
.reduce-motion button { animation: none !important; transition: none !important; }

@media (max-width: 340px) {
  .actions { grid-template-columns: minmax(0, 1fr) 88rpx; }
  .action-primary { grid-column: 1 / -1; }
  .action-secondary { grid-column: 1; }
  .action-share { grid-column: 2; }
  .reveal { padding-left: 24rpx; padding-right: 24rpx; padding-bottom: var(--space-4); }
  .plinth { width: 470rpx; }
  .info-sheet { padding-left: 24rpx; padding-right: 24rpx; }
  .preview-frame { margin-left: 24rpx; margin-right: 24rpx; }
  .preview-copy { padding-left: 24rpx; padding-right: 24rpx; }
  .preview-status { margin-left: 24rpx; margin-right: 24rpx; }
  .save { width: calc(100% - 48rpx) !important; margin-left: 24rpx !important; margin-right: 24rpx !important; }
}

@media (max-height: 700px) {
  .reveal { padding-top: var(--space-2); padding-bottom: var(--space-3); }
  .reveal .eyebrow { display: none; }
  .name { font-size: var(--type-h2-size); line-height: var(--type-h2-line); }
  .result-actions-wrap { padding-top: var(--space-2); padding-bottom: calc(var(--space-2) + env(safe-area-inset-bottom)); }
  .plinth { bottom: var(--space-3); }
  .preview-frame > image { height: 48vh; }
}
