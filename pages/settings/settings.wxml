<view class="settings-page ui-content-page {{settings.reduceMotion ? 'reduce-motion' : ''}}">
  <app-nav title="工坊设置" theme="light" back-label="返回首页"></app-nav>

  <view class="settings-body ui-content-body">
    <view class="ui-page-heading">
      <view class="ui-page-mark" aria-hidden="true">设</view>
      <view class="ui-page-heading__main">
        <view class="ui-page-kicker">工坊偏好</view>
        <view class="ui-page-title">按你的节奏创作</view>
      </view>
      <view class="ui-page-description">触感、提示和画面细节都会立即应用到创作台。</view>
    </view>

    <view class="settings-status" aria-role="status" aria-label="{{saveState || '偏好保存在本机，改动即时生效'}}">
      <ui-icon wx:if="{{saveState}}" name="check" size="28" tone="dark" decorative></ui-icon>
      <text>{{saveState || '偏好保存在本机，改动即时生效'}}</text>
    </view>

    <view class="settings-group ui-section-card" aria-label="触感与动效">
      <view class="group-heading">
        <view class="group-title">触感与动效</view>
        <view class="group-note">按你的使用习惯调整反馈</view>
      </view>

      <label class="setting-row">
        <view class="row-text">
          <view class="row-label">轻触反馈</view>
          <text>切换重要工具与完成工序时轻震</text>
        </view>
        <switch color="var(--ui-action)" checked="{{settings.haptics}}" data-key="haptics" aria-label="轻触反馈，当前{{settings.haptics ? '已开启' : '已关闭'}}" bindchange="toggle"/>
      </label>

      <label class="setting-row">
        <view class="row-text">
          <view class="row-label">减少动态效果</view>
          <text>停止自动转盘、扫光与环境动效</text>
        </view>
        <switch color="var(--ui-action)" checked="{{settings.reduceMotion}}" data-key="reduceMotion" aria-label="减少动态效果，当前{{settings.reduceMotion ? '已开启' : '已关闭'}}" bindchange="toggle"/>
      </label>
    </view>

    <view class="settings-group ui-section-card" aria-label="引导强度">
      <view class="group-heading">
        <view class="group-title">引导强度</view>
        <view class="group-note">帮助入口在所有模式下都可使用</view>
      </view>

      <radio-group class="choice-list" bindchange="setGuidance">
        <label
          wx:for="{{guidanceOptions}}"
          wx:key="value"
          class="setting-choice {{settings.guidance === item.value ? 'is-selected' : ''}}"
        >
          <radio
            class="choice-radio"
            value="{{item.value}}"
            checked="{{settings.guidance === item.value}}"
            color="var(--ui-action)"
            aria-label="{{item.label}}，{{item.description}}，{{settings.guidance === item.value ? '已选中' : '未选中'}}"
          />
          <view class="choice-copy">
            <view class="choice-label">{{item.label}}</view>
            <text>{{item.description}}</text>
          </view>
        </label>
      </radio-group>
    </view>

    <view class="settings-group ui-section-card" aria-label="画质">
      <view class="group-heading">
        <view class="group-title">画质</view>
        <view class="group-note">作品数据不会因画质变化而改变</view>
      </view>

      <radio-group class="quality-options" bindchange="setQuality">
        <label
          wx:for="{{qualityOptions}}"
          wx:key="value"
          class="quality-choice {{settings.quality === item.value ? 'is-selected' : ''}}"
        >
          <radio
            value="{{item.value}}"
            checked="{{settings.quality === item.value}}"
            color="var(--ui-action)"
            aria-label="画质{{item.label}}，{{settings.quality === item.value ? '已选中' : '未选中'}}"
          />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
      <view class="quality-tip">“流畅”适合较旧设备，“精细”会增加实时渲染负载。</view>
    </view>

    <view class="privacy-card ui-section-card">
      <view class="privacy-head">
        <view class="privacy-icon" aria-hidden="true"><ui-icon name="info" size="36" tone="dark" decorative></ui-icon></view>
        <view class="privacy-title">作品留在本机</view>
      </view>
      <text>当前版本无需登录。只有你主动保存图片或分享时，才会调用对应的微信能力。</text>
    </view>
  </view>
</view>
