.settings-page{min-height:100vh;box-sizing:border-box;padding:0 32rpx 100rpx;background:linear-gradient(160deg,#eef2ed,#dce6df)}.top{height:100rpx;display:flex;align-items:center;justify-content:space-between}.top>.display{font-size:30rpx}.spacer{width:72rpx}.intro{padding:50rpx 10rpx}.intro .display{font-size:52rpx;line-height:1.42;margin-top:18rpx}.group{margin-top:24rpx;background:#f5f7f2;border-radius:30rpx;padding:12rpx 26rpx}.group-title{font-size:21rpx;color:#52796a;letter-spacing:.12em;font-weight:700;padding:22rpx 0}.row{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-top:1rpx solid #dde3de}.row view view{font-weight:700}.row text{display:block;color:#748078;font-size:21rpx;margin-top:7rpx}.choices>view{padding:23rpx;border-top:1rpx solid #dde3de;border-left:6rpx solid transparent}.choices>view.active{border-left-color:#84a99a;background:#edf3ef}.choices view view{font-weight:700}.choices text{display:block;color:#748078;font-size:21rpx;margin-top:6rpx}.quality{display:flex;gap:10rpx;padding-bottom:18rpx}.quality view{flex:1;text-align:center;padding:20rpx;background:#e5eae6;border-radius:18rpx}.quality view.active{background:#52796a;color:#fff}.tip{font-size:20rpx;color:#748078;padding:8rpx 0 18rpx}.privacy{margin:36rpx 10rpx;padding:30rpx;border-left:6rpx solid #84a99a}.privacy .display{font-size:30rpx}.privacy text{display:block;color:#66716b;line-height:1.7;margin-top:12rpx;font-size:22rpx}
