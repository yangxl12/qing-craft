.settings-page { overflow-x: hidden; }
.settings-status {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--ui-text-secondary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.settings-group { margin-top: var(--space-6); padding: 0 var(--space-8); }
.group-heading { padding: var(--space-8) 0 var(--space-4); }
.group-title {
  font-size: var(--type-body-lg-size);
  line-height: var(--type-body-lg-line);
  font-weight: 600;
}
.group-note {
  margin-top: var(--space-1);
  color: var(--ui-text-secondary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.setting-row {
  min-height: 112rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  padding: var(--space-4) 0;
  border-top: 1rpx solid var(--ui-border);
}
.setting-row:active { background: var(--ui-pressed-surface); }
.row-text { min-width: 0; flex: 1; }
.row-label {
  font-size: var(--type-body-size);
  line-height: var(--type-body-line);
  font-weight: 600;
}
.row-text text,
.choice-copy text {
  display: block;
  margin-top: var(--space-1);
  color: var(--ui-text-secondary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.choice-list { display: block; padding-bottom: var(--space-4); }
.setting-choice {
  position: relative;
  min-height: 112rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4);
  border-top: 1rpx solid var(--ui-border);
  transition: background var(--motion-base) var(--ease-enter), box-shadow var(--motion-base) var(--ease-enter);
}
.setting-choice:active { background: var(--ui-pressed-surface); }
.setting-choice.is-selected {
  background: var(--ui-selected-surface);
  box-shadow: inset 4rpx 0 0 var(--ui-action);
}
.choice-radio { flex: none; }
.choice-copy { min-width: 0; flex: 1; }
.choice-label {
  font-size: var(--type-body-size);
  line-height: var(--type-body-line);
  font-weight: 600;
}

.quality-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-3);
  padding-bottom: var(--space-4);
}
.quality-choice {
  min-width: 0;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-3);
  color: var(--ui-text-secondary);
  background: var(--ui-surface-subtle);
  border: 1rpx solid var(--ui-border);
  border-radius: var(--radius-sm);
  font-size: var(--type-body-sm-size);
  line-height: var(--type-body-sm-line);
  transition: transform var(--motion-fast) var(--ease-enter), background var(--motion-base) var(--ease-enter), border-color var(--motion-base) var(--ease-enter);
}
.quality-choice:active { transform: scale(0.98); }
.quality-choice.is-selected {
  color: var(--ui-text);
  background: var(--ui-selected-surface);
  border: 2rpx solid var(--ui-action);
  font-weight: 600;
}
.quality-tip {
  padding: 0 0 var(--space-6);
  color: var(--ui-text-secondary);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.privacy-card { margin-top: var(--space-8); padding: var(--space-8); }
.privacy-head { display: flex; align-items: center; gap: var(--space-4); }
.privacy-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-action);
  background: var(--ui-selected-surface);
}
.privacy-title {
  font-family: var(--font-display);
  font-size: var(--type-h3-size);
  line-height: var(--type-h3-line);
  font-weight: 500;
  letter-spacing: 0.04em;
}
.privacy-card > text {
  display: block;
  margin-top: var(--space-4);
  color: var(--ui-text-secondary);
  font-size: var(--type-body-sm-size);
  line-height: var(--type-body-sm-line);
}

.reduce-motion .setting-choice,
.reduce-motion .quality-choice { transition: none; }

@media (max-width: 340px) {
  .settings-group { padding: 0 var(--space-6); }
  .ui-page-heading { gap: var(--space-4); }
  .ui-page-mark { width: 56rpx; height: 56rpx; }
}
