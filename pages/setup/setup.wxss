.setup{min-height:100vh;box-sizing:border-box;padding:0 36rpx 150rpx;background:linear-gradient(155deg,#f5f7f2,#e2e9e3 65%,#d4ded7)}.top{height:100rpx;display:flex;align-items:center;justify-content:space-between}.steps{display:flex;gap:10rpx}.step{width:62rpx;height:6rpx;background:rgba(32,40,34,.14);border-radius:8rpx}.step.on{background:#52796a}.count{font-size:22rpx;color:#66716b;width:72rpx;text-align:right}.content{padding-top:48rpx}.heading{font-size:62rpx;margin-top:18rpx}.desc{margin-top:18rpx;line-height:1.7}.shape-scroll{width:calc(100vw - 36rpx);margin-top:44rpx;margin-right:-36rpx}.shape-row{display:flex;gap:20rpx;padding:6rpx 36rpx 34rpx 0}.shape-card{width:276rpx;flex:none;box-sizing:border-box;padding:24rpx;background:rgba(255,255,255,.58);border:2rpx solid transparent;border-radius:32rpx;transition:.18s}.shape-card.selected{border-color:#52796a;background:#f8faf6;transform:translateY(-4rpx);box-shadow:0 18rpx 42rpx rgba(58,87,75,.14)}.shape-glyph{height:194rpx;display:flex;align-items:center;justify-content:center;font-size:90rpx;color:#7f968c;background:radial-gradient(circle,#edf2ed,#d9e3dc);border-radius:22rpx}.shape-name{font-size:34rpx;font-weight:700;margin-top:20rpx}.shape-story{font-size:23rpx;line-height:1.6;color:#66716b;height:76rpx;margin-top:8rpx}.minutes{font-size:21rpx;color:#52796a;margin-top:14rpx}.mode-title{font-weight:700;margin-top:18rpx}.mode-row{display:flex;gap:18rpx;margin-top:18rpx}.mode{flex:1;padding:22rpx;border:2rpx solid rgba(32,40,34,.1);border-radius:22rpx;background:rgba(255,255,255,.4)}.mode.selected{border-color:#52796a;background:#edf3ef}.mode view{font-weight:700}.mode text{display:block;font-size:21rpx;color:#66716b;margin-top:8rpx}.clay-list{margin-top:44rpx;display:flex;flex-direction:column;gap:18rpx}.clay-card{display:flex;align-items:center;padding:24rpx;border:3rpx solid transparent}.clay-card.selected{border-color:#52796a}.clay-swatch{width:112rpx;height:112rpx;border-radius:50%;position:relative;box-shadow:inset -14rpx -14rpx 22rpx rgba(32,40,34,.16)}.clay-swatch view{position:absolute;width:42rpx;height:42rpx;border-radius:50%;right:0;bottom:0;border:5rpx solid #f5f7f2}.clay-copy{flex:1;margin-left:26rpx}.clay-copy view{font-size:32rpx;font-weight:700}.clay-copy view text{font-size:20rpx;color:#66716b;font-weight:400;margin-left:12rpx}.clay-copy>text{font-size:23rpx;color:#66716b;display:block;margin-top:8rpx}.check{width:50rpx;color:#52796a;font-size:36rpx}.knead-page{text-align:center}.knead-zone{height:600rpx;display:flex;align-items:center;justify-content:center;flex-direction:column}.clay-ball{width:310rpx;height:260rpx;border-radius:47% 53% 48% 52%;background:radial-gradient(circle at 32% 28%,#f0eee7,#bab4a7 56%,#8f8778);box-shadow:0 46rpx 50rpx rgba(48,48,42,.22);transition:.18s}.clay-ball.k1{transform:scaleY(.92) rotate(-2deg)}.clay-ball.k2{transform:scaleY(.86) rotate(2deg)}.clay-ball.k3,.clay-ball.k4{transform:scaleY(.8)}.fingerprint{width:96rpx;height:58rpx;border:8rpx double rgba(90,82,73,.18);border-radius:50%;margin:60rpx auto}.knead-count{margin-top:54rpx;color:#52796a}.skip{background:transparent;color:#52796a;font-weight:500;font-size:24rpx}.footer{position:fixed;left:36rpx;right:36rpx;bottom:calc(32rpx + env(safe-area-inset-bottom))}.footer button{width:100%}
