<view class="studio {{reduceMotion?'reduce-motion':''}} {{stageIndex===1?'decor-stage':''}} {{decorTrayOpen?'decor-menu-open':'decor-menu-closed'}} {{decorFullscreen?'decor-fullscreen':''}}">
  <view wx:if="{{stageIndex===0}}" class="shaping-workshop-bg" aria-hidden="true">
    <image
      class="shaping-workshop-image"
      src="/assets/studio-shaping-workshop-day.jpg"
      mode="aspectFill"
    ></image>
    <view class="shaping-workshop-grade"></view>
  </view>
  <view wx:elif="{{stageIndex===1}}" class="decor-workshop-bg" aria-hidden="true">
    <image class="decor-workshop-image" src="/assets/studio-decoration-workshop.jpg" mode="aspectFill"></image>
    <view class="decor-workshop-grade"></view>
  </view>
  <view wx:else class="workshop-bg">
    <view class="wall-plaster"></view>
    <view class="wall-glow"></view>
    <view class="window-bloom"></view>
    <view class="window-light">
      <view class="lattice lattice-vertical"></view>
      <view class="lattice lattice-horizontal-one"></view>
      <view class="lattice lattice-horizontal-two"></view>
      <view class="window-paper"></view>
    </view>
    <view class="light-beam"></view>
    <view class="timber timber-left"></view>
    <view class="timber timber-top"></view>
    <view class="timber timber-diagonal"></view>
    <view class="kiln-arch"><view class="kiln-mouth"></view><view class="kiln-ember"></view></view>
    <view class="pottery-rack">
      <view class="rack-shelf shelf-upper"></view>
      <view class="rack-shelf shelf-lower"></view>
      <view class="rack-pot rack-pot-one"></view>
      <view class="rack-pot rack-pot-two"></view>
      <view class="rack-pot rack-pot-three"></view>
    </view>
    <view class="table-plane">
      <view class="table-grain"></view>
      <view class="perspective-line line-left"></view>
      <view class="perspective-line line-right"></view>
    </view>
    <view class="stage-floor-shadow"></view>
    <view class="vignette"></view>
  </view>

  <view class="safe-top" style="height:{{statusBarHeight}}px"></view>
  <view class="topbar">
    <view
      wx:if="{{stageIndex===1}}"
      class="decor-fullscreen-trigger"
      role="button"
      aria-label="{{decorFullscreen?'退出全屏视图':'进入瓷器全屏视图'}}"
      bindtap="toggleDecorFullscreen"
    ><text>{{decorFullscreen?'退出':'全屏'}}</text><view>{{decorFullscreen?'↙':'⛶'}}</view></view>
    <view class="work-title">
      <view>{{stageName}} · {{stageIndex+1}} / 7</view>
      <text class="{{saveState==='已保存'?'saved':''}}">{{saveState}}</text>
    </view>
    <view class="top-actions">
      <view class="top-action top-exit" role="button" aria-label="退出创作台" bindtap="close">退出</view>
      <view class="top-action top-reset" role="button" aria-label="视角回正" bindtap="resetCamera">回正</view>
      <view class="circle {{!canUndo?'disabled':''}}" role="button" aria-label="撤销" bindtap="undo">↶</view>
      <view class="circle {{!canRedo?'disabled':''}}" role="button" aria-label="重做" bindtap="redo">↷</view>
      <view class="circle" role="button" aria-label="查看手势帮助" bindtap="help">?</view>
    </view>
  </view>

  <view class="stage-area">
    <view class="pottery-spotlight"></view>
    <canvas
      wx:if="{{!fallback}}"
      id="potteryCanvas"
      class="canvas"
      type="webgl"
      disable-scroll="true"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
      bindtouchcancel="touchEnd"
    ></canvas>
    <view
      wx:else
      class="fallback"
      style="--base-screen-percent:{{baseScreenPercent}}%;"
      catchtouchstart="touchStart"
      catchtouchmove="touchMove"
      catchtouchend="touchEnd"
      catchtouchcancel="touchEnd"
    >
      <view class="fallback-pot shape-{{work.shapeId}} stage-{{stageIndex}}"></view>
      <view wx:if="{{decorationCount||stampCount}}" class="fallback-decor fired-{{firedPreview}}">
        <text>{{selectedDecorationName||'纹'}}</text>
        <small>{{decorationCount}} 层 · {{stampCount}} 印</small>
      </view>
      <view wx:if="{{work.decorationComposition.inscription}}" class="fallback-inscription">
        {{work.decorationComposition.inscription.text}}
      </view>
      <view class="fallback-note">轻量剖面模式</view>
    </view>

    <view
      id="wheelRoot"
      class="wheel-root {{wheelPaused?'wheel-paused':''}} wheel-{{wheelState}}"
      style="--wheel-period:{{wheelPeriodMs}}ms; --contact-shadow-width:{{contactShadowWidth}}rpx;"
    >
      <view id="wheelContact" class="wheel-contact-anchor"></view>
      <view class="contact-shadow"></view>
      <view class="wheel-head">
        <view class="wheel-head-spin">
          <view class="machined-rings"></view>
          <view class="slip-mark"></view>
          <view class="wheel-glint"></view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{stageIndex===1&&selectedDecoration&&!fallback&&!decorFullscreen}}"
      id="decorToolPanel"
      class="decor-tool-panel {{decorToolsCollapsed?'collapsed':''}}"
      style="{{decorToolStyle}}"
    >
      <view class="decor-tool-head">
        <view
          class="decor-tool-drag"
          catchtouchstart="startDecorToolDrag"
          catchtouchmove="moveDecorToolPanel"
          catchtouchend="endDecorToolDrag"
          catchtouchcancel="endDecorToolDrag"
        >
          <view class="decor-drag-icon" aria-hidden="true"><view></view><view></view><view></view><view></view><view></view><view></view></view>
          <view class="decor-tool-title"><text>纹样调校</text></view>
        </view>
        <view
          class="decor-tool-fold"
          role="button"
          aria-label="{{decorToolsCollapsed?'展开操作按钮':'收起操作按钮'}}"
          catchtap="toggleDecorTools"
        ><view class="decor-tool-chevron {{decorToolsCollapsed?'down':'up'}}"></view></view>
      </view>
      <view
        class="decor-tool-actions {{decorToolsCollapsed?'is-collapsed':''}}"
        aria-hidden="{{decorToolsCollapsed}}"
      >
        <view class="decor-tool-command danger" role="button" aria-label="删除当前图案" bindtap="deleteSelectedDecoration"><view class="decor-delete-icon" aria-hidden="true"><view></view></view></view>
        <view class="decor-tool-command {{!canUndo?'disabled':''}}" role="button" aria-label="撤回上一步" bindtap="undo"><text aria-hidden="true">↶</text></view>
        <view class="decor-tool-command" role="button" aria-label="复制当前图案" bindtap="copySelectedDecoration"><view class="decor-copy-icon" aria-hidden="true"><view></view><view></view></view></view>
        <view class="decor-axis-command">
          <view role="button" aria-label="减小当前图案横向尺寸" data-axis="x" data-direction="-1" bindtap="adjustDecorAxis">−</view>
          <text aria-hidden="true">↔</text>
          <view role="button" aria-label="增大当前图案横向尺寸" data-axis="x" data-direction="1" bindtap="adjustDecorAxis">＋</view>
        </view>
        <view class="decor-axis-command">
          <view role="button" aria-label="减小当前图案纵向尺寸" data-axis="y" data-direction="-1" bindtap="adjustDecorAxis">−</view>
          <text aria-hidden="true">↕</text>
          <view role="button" aria-label="增大当前图案纵向尺寸" data-axis="y" data-direction="1" bindtap="adjustDecorAxis">＋</view>
        </view>
        <view class="decor-tool-command flip" role="button" aria-label="上下翻转当前图案" bindtap="flipSelectedDecoration"><text aria-hidden="true">⇅</text></view>
      </view>
    </view>

    <view wx:if="{{stageIndex===0}}" class="gesture-map">
      <view class="gesture-map-title">手势塑形</view>
      <view class="gesture-row"><view class="arrow-pair">←　→</view><text>拉伸</text></view>
      <view class="gesture-row"><view class="arrow-pair">→　←</view><text>压缩</text></view>
      <view class="gesture-row"><view class="arrow-single">↕</view><text>抹平高低</text></view>
      <view class="gesture-camera"><view class="finger-pair"><view></view><view></view></view><text>双指环看</text></view>
    </view>

    <view wx:if="{{stageIndex===0}}" class="wall-caliper {{wallAdjusting?'active':''}}">
      <view class="wall-caliper-head">
        <view class="caliper-glyph"><view></view><view></view></view>
        <text>泥壁厚度</text>
        <view class="wall-state">{{wallThicknessLabel}}</view>
        <text class="wall-value">{{wallThicknessText}}</text>
      </view>
      <view class="wall-slider-row">
        <text>薄</text>
        <slider
          class="wall-slider"
          min="{{wallThicknessMin}}"
          max="{{wallThicknessMax}}"
          step="1"
          value="{{wallThicknessValue}}"
          activeColor="#a8ccb8"
          backgroundColor="rgba(218,232,223,.22)"
          block-color="#eef4ef"
          block-size="16"
          aria-label="调整泥壁厚度，当前{{wallThicknessText}}"
          bindchanging="changeWallThickness"
          bindchange="finishWallThickness"
        ></slider>
        <text>厚</text>
      </view>
      <view class="wall-link">上拉变薄 · 下压回厚</view>
    </view>

    <view wx:if="{{stageIndex===0}}" class="form-switcher" aria-label="受力形态">
      <view
        wx:for="{{shapingForms}}"
        wx:key="id"
        class="form-chip {{shapingForm===item.id?'active':''}}"
        role="button"
        aria-label="选择{{item.name}}塑形"
        data-id="{{item.id}}"
        bindtap="chooseShapingForm"
      >{{item.name}}</view>
    </view>

    <view wx:if="{{stageIndex===0}}" class="material-dock">
      <view wx:if="{{shapeMenuOpen}}" class="choice-popover shape-popover">
        <view class="choice-title">器形</view>
        <view class="choice-grid">
          <view
            wx:for="{{shapeOptions}}"
            wx:key="id"
            class="choice-item {{work.shapeId===item.id?'active':''}}"
            role="button"
            aria-label="选择{{item.glyph}}"
            data-id="{{item.id}}"
            bindtap="chooseBaseShape"
          >{{item.glyph}}</view>
        </view>
      </view>
      <view wx:if="{{clayMenuOpen}}" class="choice-popover clay-popover">
        <view class="choice-title">泥料</view>
        <view
          wx:for="{{clayOptions}}"
          wx:key="id"
          class="clay-choice {{work.clayId===item.id?'active':''}}"
          role="button"
          aria-label="选择{{item.name}}"
          data-id="{{item.id}}"
          bindtap="chooseClay"
        >
          <view class="clay-dot" style="background:{{item.wet}}"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="dock-row">
        <view class="dock-trigger {{shapeMenuOpen?'open':''}}" role="button" aria-label="展开器形选择" bindtap="toggleShapeMenu">
          <text>器形</text><view>{{shapeName}}</view><small>{{shapeMenuOpen?'−':'+'}}</small>
        </view>
        <view class="dock-trigger {{clayMenuOpen?'open':''}}" role="button" aria-label="展开泥料选择" bindtap="toggleClayMenu">
          <text>泥料</text><view>{{clayName}}</view><small>{{clayMenuOpen?'−':'+'}}</small>
        </view>
      </view>
    </view>

    <view class="hint panel" wx:if="{{showHelp||(showHint&&stageIndex!==0)}}" bindtap="hideHint">
      <text>{{showHelp?cameraHelp:hint}}</text>
      <small>轻触收起</small>
    </view>

    <view wx:if="{{(stageIndex===1||stageIndex===4)&&selectedDecoration}}" class="decor-selection-label">
      <text>{{selectedDecorationName}}</text>
      <small>{{selectedDecorationRole}} · {{selectedAnchorName}}</small>
    </view>
  </view>

  <view wx:if="{{stageIndex===0}}" class="stage-footer">
    <view class="stage-footer-title">{{stageName}}</view>
    <button
      class="stage-next"
      aria-label="进入下一道工序：{{nextStageName}}"
      bindtap="completeStage"
    >
      <text>{{nextStageName}}</text>
      <view class="stage-next-icon">→</view>
    </button>
  </view>

  <view wx:elif="{{stageIndex===1}}" class="decor-tray {{decorTrayOpen?'expanded':'collapsed'}}">
    <view
      class="decor-tray-toggle"
      role="button"
      aria-label="{{decorTrayOpen?'收起全部装饰菜单':'展开全部装饰菜单'}}"
      bindtap="toggleDecorTray"
    ><view>{{decorTrayOpen?'⌄':'⌃'}}</view><text>{{decorTrayOpen?'收起':'展开'}}</text></view>

    <view wx:if="{{decorTrayOpen}}" class="decor-panel-grid">
      <view class="decor-library-panel">
        <view class="decor-catalog-tabs">
          <view
            wx:for="{{decorTabs}}"
            wx:key="id"
            class="{{decorTab===item.id?'active':''}}"
            role="button"
            aria-label="切换到{{item.name}}"
            data-id="{{item.id}}"
            bindtap="selectDecorTab"
          ><small>{{item.seal}}</small><text>{{item.name}}</text></view>
        </view>
        <view class="decor-library-body">
          <scroll-view class="decor-side-menu" scroll-y enhanced show-scrollbar="false">
            <view
              wx:for="{{decorSideMenus}}"
              wx:key="id"
              class="{{decorMenuId===item.id?'active':''}}"
              role="button"
              aria-label="选择{{item.name}}"
              data-id="{{item.id}}"
              bindtap="selectDecorMenu"
            ><view class="decor-side-menu-icon" aria-hidden="true">{{item.icon}}</view></view>
          </scroll-view>
          <scroll-view class="decor-grid-scroll" scroll-y enhanced show-scrollbar="false">
            <view class="decor-grid">
              <view
                wx:for="{{decorCatalogItems}}"
                wx:key="key"
                class="decor-grid-card {{item.checked?'checked':''}}"
                role="checkbox"
                aria-checked="{{item.checked}}"
                aria-label="{{item.checked?'取消':'选择'}}{{item.name}}"
                data-id="{{item.id}}"
                data-key="{{item.key}}"
                bindtap="toggleDecorCatalogItem"
              >
                <view class="motif-art {{item.patternClass}}"><view></view><text>{{item.glyph}}</text><view></view></view>
                <view wx:if="{{item.checked}}" class="decor-check">✓</view>
                <text class="decor-grid-name">{{item.name}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="decor-selected-panel">
        <view class="decor-selected-head"><view><small>已入画</small><text>被选图菜单</text></view><text>{{decorationCount+stampCount}}</text></view>
        <scroll-view class="decor-selected-scroll" scroll-y enhanced show-scrollbar="false">
          <view wx:if="{{decorationLayers.length}}" class="decor-selected-grid">
            <view
              wx:for="{{decorationLayers}}"
              wx:key="id"
              class="decor-selected-card {{item.selected?'active':''}} {{item.visible?'':'hidden'}}"
              role="radio"
              aria-checked="{{item.selected}}"
              aria-label="选中{{item.roleName}}{{item.name}}进行调整"
              data-id="{{item.id}}"
              bindtap="selectDecoration"
            >
              <view class="motif-art {{item.patternClass}}"><view></view><text>{{item.glyph}}</text><view></view></view>
              <view wx:if="{{item.selected}}" class="decor-check">✓</view>
              <view wx:if="{{item.copyNumber}}" class="decor-copy-badge">{{item.copyNumber}}</view>
              <text>{{item.name}}</text>
            </view>
          </view>
          <view wx:else class="decor-selected-empty"><text>尚未入画</text><small>从左侧轻点图案</small></view>
        </scroll-view>
      </view>
    </view>

    <view class="decor-bottom">
      <button class="decor-previous" bindtap="returnToShaping"><view>←</view><text>上一步</text></button>
      <text>{{decorationCount}} 层 · {{stampCount}} 枚落印</text>
      <button class="decor-complete" bindtap="completeStage">完成装饰 <view>→</view></button>
    </view>
  </view>

  <view wx:elif="{{stageIndex===4}}" class="paint-tray">
    <view class="decor-head paint-head">
      <view class="decor-mode-tabs">
        <view class="{{paintPanel==='accent'?'active':''}}" data-id="accent" bindtap="setPaintPanel">点彩</view>
        <view class="{{paintPanel==='inscription'?'active':''}}" data-id="inscription" bindtap="setPaintPanel">写款</view>
      </view>
      <view
        class="fired-peek {{firedPreview?'active':''}}"
        bindtouchstart="previewFiredStart"
        bindtouchend="previewFiredEnd"
        bindtouchcancel="previewFiredEnd"
      >{{firedPreview?'烤后定色':'按住看烤后'}}</view>
    </view>

    <view wx:if="{{paintPanel==='accent'}}" class="accent-panel">
      <view class="panel-copy"><text>给主纹点一处颜色</text><small>釉上彩会叠在前序纹样之上，不会覆盖刻花或青花。</small></view>
      <view class="paint-row">
        <view
          wx:for="{{paintColors}}"
          wx:key="id"
          class="paint-color {{accentColorId===item.id?'active':''}}"
          data-id="{{item.id}}"
          bindtap="choosePaint"
          aria-label="选择{{item.name}}"
        ><view class="paint-color-dot" style="background:{{item.color}}"></view><text>{{item.name}}</text></view>
      </view>
      <view wx:if="{{selectedDecoration}}" class="accent-controls">
        <button data-action="size" bindtap="adjustDecoration">大小</button>
        <button data-action="rotate" bindtap="adjustDecoration">旋转</button>
        <button data-action="repeat" bindtap="adjustDecoration">{{selectedRepeatName}}</button>
        <button class="danger" bindtap="deleteSelectedDecoration">移除点彩</button>
      </view>
    </view>

    <scroll-view wx:else class="inscription-scroll" scroll-y show-scrollbar="false">
      <view class="inscription-kicker">写款收尾</view>
      <view class="inscription-types">
        <view wx:for="{{inscriptionContentTypes}}" wx:key="id" class="{{inscriptionDraft.contentType===item.id?'active':''}}" data-id="{{item.id}}" bindtap="chooseInscriptionContent">{{item.name}}</view>
      </view>
      <textarea
        class="inscription-input {{inscriptionError?'invalid':''}}"
        value="{{inscriptionDraft.text}}"
        maxlength="20"
        auto-height="true"
        placeholder="写下名字、日期或祝语"
        aria-label="写款内容，最多十二个字"
        bindinput="inputInscription"
      ></textarea>
      <view wx:if="{{inscriptionError}}" class="inscription-error">{{inscriptionError}}</view>
      <scroll-view wx:if="{{inscriptionDraft.contentType==='blessing'}}" class="blessing-scroll" scroll-x show-scrollbar="false">
        <view class="blessing-row"><view wx:for="{{blessings}}" wx:key="*this" data-text="{{item}}" bindtap="chooseBlessing">{{item}}</view></view>
      </scroll-view>

      <view class="inscription-options">
        <view class="option-line"><text>版式</text><scroll-view scroll-x><view><button wx:for="{{inscriptionLayouts}}" wx:key="id" class="{{inscriptionDraft.layoutId===item.id?'active':''}}" data-kind="layout" data-id="{{item.id}}" bindtap="chooseInscriptionOption">{{item.name}}</button></view></scroll-view></view>
        <view class="option-line"><text>表现</text><scroll-view scroll-x><view><button wx:for="{{inscriptionStyles}}" wx:key="id" class="{{inscriptionDraft.styleId===item.id?'active':''}}" data-kind="style" data-id="{{item.id}}" bindtap="chooseInscriptionOption">{{item.name}}</button></view></scroll-view></view>
        <view class="option-line"><text>字形</text><scroll-view scroll-x><view><button wx:for="{{inscriptionTypefaces}}" wx:key="id" class="{{inscriptionDraft.typefaceId===item.id?'active':''}}" data-kind="typeface" data-id="{{item.id}}" bindtap="chooseInscriptionOption">{{item.name}}</button></view></scroll-view></view>
        <view class="option-line"><text>落点</text><scroll-view scroll-x><view><button wx:for="{{inscriptionAnchors}}" wx:key="id" class="{{inscriptionDraft.anchor===item.id?'active':''}}" data-kind="anchor" data-id="{{item.id}}" bindtap="chooseInscriptionOption">{{item.name}}</button></view></scroll-view></view>
      </view>

      <view wx:if="{{privateMarks.length}}" class="private-marks">
        <text>本机私款</text>
        <view class="private-row">
          <view wx:for="{{privateMarks}}" wx:key="id" data-index="{{index}}" bindtap="applyPrivateMark">
            <text class="private-mark-text">{{item.inscription.text}}</text>
            <small data-index="{{index}}" catchtap="replacePrivateMark">用当前替换</small>
          </view>
        </view>
      </view>
      <view class="inscription-actions">
        <button class="quiet" bindtap="saveCurrentPrivateMark">存为私款</button>
        <button wx:if="{{work.decorationComposition.inscription}}" class="danger" bindtap="removeInscription">移除现款</button>
        <button class="apply-mark" bindtap="applyInscription">落款</button>
      </view>
      <view class="privacy-note">款识只保存在本机，不会写入埋点或日志。</view>
    </scroll-view>

    <view class="decor-bottom paint-bottom">
      <text>{{work.decorationComposition.inscription?'已写款':'写款可跳过'}}</text>
      <button class="decor-complete" bindtap="completeStage">完成彩绘 →</button>
    </view>
  </view>

  <view wx:else class="tray">
    <scroll-view wx:if="{{tools.length}}" class="tool-scroll" scroll-x show-scrollbar="false">
      <view class="tool-row">
        <view wx:for="{{tools}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseTool" class="tool {{tool===item.id?'active':''}}">
          <view>{{item.name}}</view><text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <scroll-view wx:if="{{stageIndex===2}}" class="swatch-scroll" scroll-x show-scrollbar="false">
      <view class="swatch-row">
        <view wx:for="{{glazes}}" wx:key="id" class="swatch-item {{glazeId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="chooseGlaze">
          <view style="background:{{item.fired}}"></view><text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="tray-bottom">
      <view class="tool-hint">{{toolName}}</view>
      <button class="complete" aria-label="进入下一道工序" bindtap="completeStage">
        {{stageIndex===6?'查看成品':'完成'+stageName+' →'}}
      </button>
    </view>
  </view>

  <view wx:if="{{kiln}}" class="kiln-overlay">
    <view class="kiln-door">
      <view class="kiln-glow" style="opacity:{{.25+kilnProgress/130}}"></view>
      <view class="temperature">{{700+kilnProgress*6}}<text>℃</text></view>
      <view class="kiln-copy display">{{kilnText}}</view>
      <view class="kiln-progress"><view style="width:{{kilnProgress}}%"></view></view>
      <button bindtap="skipKiln">跳过等待</button>
    </view>
  </view>
</view>
