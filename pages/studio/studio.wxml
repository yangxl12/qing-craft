<view class="studio tone-dark {{reduceMotion?'reduce-motion':''}} {{showHelp?'show-help':''}} {{kiln?'kiln-active kiln-'+kilnType:''}} {{stageIndex===1||stageIndex===4?'decor-stage':''}} {{stageIndex===4?'paint-stage':''}} {{stageIndex===2?'glaze-stage':''}} {{decorTrayOpen?'decor-menu-open':'decor-menu-closed'}} {{decorFullscreen?'decor-fullscreen':''}}">
  <view wx:if="{{stageIndex===0}}" class="shaping-workshop-bg" aria-hidden="true">
    <image
      class="shaping-workshop-image"
      src="/pages/studio/assets/studio-shaping-workshop-day.jpg"
      mode="aspectFill"
    ></image>
    <view class="shaping-workshop-grade"></view>
  </view>
  <view wx:elif="{{stageIndex===1||stageIndex===2||stageIndex===4}}" class="decor-workshop-bg" aria-hidden="true">
    <image class="decor-workshop-image" src="/assets/studio-decoration-workshop.jpg" mode="aspectFill"></image>
    <view class="decor-workshop-grade"></view>
  </view>
  <view wx:else class="workshop-bg" aria-hidden="true">
    <view class="wall-plaster"></view>
    <view class="wall-glow"></view>
    <view class="window-bloom"></view>
    <view class="window-light">
      <view class="lattice lattice-vertical"></view>
      <view class="lattice lattice-horizontal-one"></view>
      <view class="lattice lattice-horizontal-two"></view>
      <view class="window-paper"></view>
    </view>
    <view class="light-beam"></view>
    <view class="timber timber-left"></view>
    <view class="timber timber-top"></view>
    <view class="timber timber-diagonal"></view>
    <view class="kiln-arch"><view class="kiln-mouth"></view><view class="kiln-ember"></view></view>
    <view class="pottery-rack">
      <view class="rack-shelf shelf-upper"></view>
      <view class="rack-shelf shelf-lower"></view>
      <view class="rack-pot rack-pot-one"></view>
      <view class="rack-pot rack-pot-two"></view>
      <view class="rack-pot rack-pot-three"></view>
    </view>
    <view class="table-plane">
      <view class="table-grain"></view>
      <view class="perspective-line line-left"></view>
      <view class="perspective-line line-right"></view>
    </view>
    <view class="stage-floor-shadow"></view>
    <view class="vignette"></view>
  </view>

  <view wx:if="{{kiln}}" class="kiln-backdrop" aria-hidden="true">
    <image class="kiln-background-image" src="{{kilnBackground}}" mode="aspectFill"></image>
    <view class="kiln-background-grade"></view>
    <view class="kiln-heat-haze ui-motion" style="opacity:{{0.16+kilnProgress/180}}"></view>
    <view class="kiln-vessel-aura heat-{{kilnHeatClass}} ui-motion"></view>
    <view class="kiln-embers ui-motion">
      <view></view><view></view><view></view><view></view><view></view>
    </view>
  </view>

  <view class="safe-top" style="height:{{statusBarHeight}}px"></view>
  <view class="topbar">
    <button class="top-exit" aria-label="退出创作台" bindtap="close">
      <ui-icon name="back" size="36" tone="light" decorative></ui-icon><text>退出</text>
    </button>
    <view class="work-title">
      <view class="work-title-main"><text>{{stageName}}</text><small>{{stageIndex+1}} / 7</small></view>
      <text class="save-state {{saveState==='已保存'?'saved':''}}" aria-role="status">{{saveState}}</text>
    </view>
    <view class="topbar-balance" aria-hidden="true"></view>
  </view>
  <view class="stage-area">
    <view class="pottery-spotlight"></view>
    <view class="stage-tool-rail">
      <button class="stage-tool" aria-label="视角回正" bindtap="resetCamera"><ui-icon name="reset-view" size="38" tone="light" decorative></ui-icon></button>
      <button class="stage-tool" disabled="{{!canUndo}}" aria-disabled="{{!canUndo}}" aria-label="撤销" bindtap="undo"><ui-icon name="undo" size="38" tone="light" decorative></ui-icon></button>
      <button class="stage-tool" disabled="{{!canRedo}}" aria-disabled="{{!canRedo}}" aria-label="重做" bindtap="redo"><ui-icon name="redo" size="38" tone="light" decorative></ui-icon></button>
      <button wx:if="{{stageIndex===0}}" class="stage-tool {{showHelp?'is-active':''}}" aria-label="{{showHelp?'收起手势帮助':'查看手势帮助'}}" bindtap="help"><ui-icon name="help" size="38" tone="light" decorative></ui-icon></button>
    </view>
    <button
      wx:if="{{stageIndex===1||stageIndex===4}}"
      class="decor-fullscreen-trigger"
      aria-label="{{decorFullscreen?'退出全屏视图':'进入瓷器全屏视图'}}"
      bindtap="toggleDecorFullscreen"
    ><ui-icon name="{{decorFullscreen?'exit-fullscreen':'fullscreen'}}" size="38" tone="light" decorative></ui-icon><text>{{decorFullscreen?'退出全屏':'全屏查看'}}</text></button>
    <canvas
      wx:if="{{!fallback}}"
      id="potteryCanvas"
      class="canvas"
      type="webgl"
      aria-role="img"
      aria-label="{{stageName}}器物舞台，按当前工序手势直接操作器物"
      disable-scroll="true"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
      bindtouchcancel="touchEnd"
    ></canvas>
    <view
      wx:else
      class="fallback"
      style="--base-screen-percent:{{baseScreenPercent}}%;"
      aria-role="img"
      aria-label="{{stageName}}轻量器物舞台，按当前工序手势直接操作器物"
      catchtouchstart="touchStart"
      catchtouchmove="touchMove"
      catchtouchend="touchEnd"
      catchtouchcancel="touchEnd"
    >
      <view class="fallback-pot shape-{{work.shapeId}} stage-{{stageIndex}} {{stageIndex>=2?'glazed':''}} glaze-{{glazeId}} kiln-{{kilnHeatClass}}"></view>
      <view wx:if="{{decorationCount||stampCount||sealApplied}}" class="fallback-decor fired-{{firedPreview}}">
        <text>{{selectedDecorationName||'纹'}}</text>
        <small>{{decorationCount}} 层 · {{stampCount}} 印{{sealApplied?' · 题款':''}}</small>
      </view>
      <view wx:if="{{work.decorationComposition.inscription}}" class="fallback-inscription">
        {{work.decorationComposition.inscription.text}}
      </view>
      <view class="fallback-note">轻量剖面模式</view>
    </view>

    <view
      id="wheelRoot"
      class="wheel-root {{wheelPaused?'wheel-paused':''}} wheel-{{wheelState}}"
      style="--wheel-period:{{wheelPeriodMs}}ms; --contact-shadow-width:{{contactShadowWidth}}rpx;"
    >
      <view id="wheelContact" class="wheel-contact-anchor"></view>
      <view class="contact-shadow"></view>
      <view class="wheel-head">
        <view class="wheel-head-spin">
          <view class="machined-rings"></view>
          <view class="slip-mark"></view>
          <view class="wheel-glint"></view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{((stageIndex===1&&hasSelectedDecorItem)||(stageIndex===4&&hasSelectedPaintItem))&&!fallback&&!decorFullscreen}}"
      id="decorToolPanel"
      class="decor-tool-panel {{decorToolsCollapsed?'collapsed':''}}"
      style="{{decorToolStyle}}"
    >
      <view class="decor-tool-head">
        <view
          class="decor-tool-drag"
          aria-role="button"
          aria-label="拖动纹样调校面板"
          catchtouchstart="startDecorToolDrag"
          catchtouchmove="moveDecorToolPanel"
          catchtouchend="endDecorToolDrag"
          catchtouchcancel="endDecorToolDrag"
        >
          <view class="decor-drag-icon" aria-hidden="true"><view></view><view></view><view></view><view></view><view></view><view></view></view>
           <view class="decor-tool-title"><text>{{stageIndex===4?'彩绘调校':(selectedDecorationIsSeal?'题款调校':'纹样调校')}}</text></view>
        </view>
        <button
          class="decor-tool-fold"
          aria-label="{{decorToolsCollapsed?'展开操作按钮':'收起操作按钮'}}"
          catchtap="toggleDecorTools"
        ><ui-icon name="{{decorToolsCollapsed?'expand':'collapse'}}" size="36" tone="light" decorative></ui-icon></button>
      </view>
      <view
        class="decor-tool-actions {{decorToolsCollapsed?'is-collapsed':''}}"
        aria-hidden="{{decorToolsCollapsed}}"
      >
        <button class="decor-tool-command danger" aria-label="删除当前{{selectedDecorationLabel}}" bindtap="deleteSelectedDecoration"><ui-icon name="delete" size="40" decorative></ui-icon></button>
        <button class="decor-tool-command" disabled="{{!canUndo}}" aria-label="撤回上一步" aria-disabled="{{!canUndo}}" bindtap="undo"><ui-icon name="undo" size="40" decorative></ui-icon></button>
        <button wx:if="{{!selectedDecorationIsSeal}}" class="decor-tool-command" aria-label="复制当前图案" bindtap="copySelectedDecoration"><ui-icon name="copy" size="40" decorative></ui-icon></button>
        <view class="decor-axis-command">
          <button aria-label="减小当前{{selectedDecorationLabel}}横向尺寸" data-axis="x" data-direction="-1" bindtap="adjustDecorAxis">−</button>
          <ui-icon name="scale-horizontal" size="36" decorative></ui-icon>
          <button aria-label="增大当前{{selectedDecorationLabel}}横向尺寸" data-axis="x" data-direction="1" bindtap="adjustDecorAxis">＋</button>
        </view>
        <view class="decor-axis-command">
          <button aria-label="减小当前{{selectedDecorationLabel}}纵向尺寸" data-axis="y" data-direction="-1" bindtap="adjustDecorAxis">−</button>
          <ui-icon name="scale-vertical" size="36" decorative></ui-icon>
          <button aria-label="增大当前{{selectedDecorationLabel}}纵向尺寸" data-axis="y" data-direction="1" bindtap="adjustDecorAxis">＋</button>
        </view>
        <button wx:if="{{!selectedDecorationIsSeal}}" class="decor-tool-command flip" aria-label="上下翻转当前图案" bindtap="flipSelectedDecoration"><ui-icon name="flip-vertical" size="40" decorative></ui-icon></button>
      </view>
    </view>

    <view wx:if="{{stageIndex===0&&showHelp}}" class="gesture-map" aria-role="dialog" aria-label="制坯手势帮助">
      <view class="gesture-map-head"><view class="gesture-map-title">手势塑形</view><button aria-label="关闭手势帮助" bindtap="help"><ui-icon name="close" size="32" tone="light" decorative></ui-icon></button></view>
      <view class="gesture-row"><view class="arrow-pair">←　→</view><text>拉伸</text></view>
      <view class="gesture-row"><view class="arrow-pair">→　←</view><text>压缩</text></view>
      <view class="gesture-row"><view class="arrow-single">↕</view><text>抹平高低</text></view>
      <view class="gesture-camera"><view class="finger-pair"><view></view><view></view></view><text>双指环看</text></view>
      <text class="gesture-map-note">双指环看与缩放；回正可重新完整查看器形。</text>
    </view>

    <view wx:if="{{stageIndex===0}}" class="wall-caliper {{wallAdjusting?'active':''}}">
      <view class="wall-caliper-head">
        <view class="caliper-glyph"><view></view><view></view></view>
        <text>泥壁厚度</text>
        <view class="wall-state">{{wallThicknessLabel}}</view>
        <text class="wall-value">{{wallThicknessText}}</text>
      </view>
      <view class="wall-slider-row">
        <text>薄</text>
        <slider
          class="wall-slider"
          min="{{wallThicknessMin}}"
          max="{{wallThicknessMax}}"
          step="1"
          value="{{wallThicknessValue}}"
          activeColor="var(--color-celadon-300)"
          backgroundColor="var(--ui-workshop-border)"
          block-color="var(--color-on-dark)"
          block-size="16"
          aria-label="调整泥壁厚度，当前{{wallThicknessText}}"
          bindchanging="changeWallThickness"
          bindchange="finishWallThickness"
        ></slider>
        <text>厚</text>
      </view>
      <view class="wall-link">上拉变薄 · 下压回厚</view>
    </view>

    <view wx:if="{{stageIndex===0}}" class="form-switcher" aria-label="受力形态">
      <button
        wx:for="{{shapingForms}}"
        wx:key="id"
        class="form-chip {{shapingForm===item.id?'active':''}}"
        aria-label="选择{{item.name}}塑形"
        data-id="{{item.id}}"
        bindtap="chooseShapingForm"
      >{{item.name}}</button>
    </view>

    <view wx:if="{{stageIndex===0}}" class="material-dock">
      <view wx:if="{{shapeMenuOpen}}" class="choice-popover shape-popover">
        <view class="choice-title">器形</view>
        <view class="choice-grid">
          <button
            wx:for="{{shapeOptions}}"
            wx:key="id"
            class="choice-item {{work.shapeId===item.id?'active':''}}"
            aria-label="选择{{item.glyph}}"
            data-id="{{item.id}}"
            bindtap="chooseBaseShape"
          >{{item.glyph}}</button>
        </view>
      </view>
      <view wx:if="{{clayMenuOpen}}" class="choice-popover clay-popover">
        <view class="choice-title">泥料</view>
        <button
          wx:for="{{clayOptions}}"
          wx:key="id"
          class="clay-choice {{work.clayId===item.id?'active':''}}"
          aria-label="选择{{item.name}}"
          data-id="{{item.id}}"
          bindtap="chooseClay"
        >
          <view class="clay-dot" style="background:{{item.wet}}"></view>
          <text>{{item.name}}</text>
        </button>
      </view>
      <view class="dock-row">
        <button class="dock-trigger {{shapeMenuOpen?'open':''}}" aria-label="{{shapeMenuOpen?'收起':'展开'}}器形选择" bindtap="toggleShapeMenu">
          <text>器形</text><view>{{shapeName}}</view><small>{{shapeMenuOpen?'−':'+'}}</small>
        </button>
        <button class="dock-trigger {{clayMenuOpen?'open':''}}" aria-label="{{clayMenuOpen?'收起':'展开'}}泥料选择" bindtap="toggleClayMenu">
          <text>泥料</text><view>{{clayName}}</view><small>{{clayMenuOpen?'−':'+'}}</small>
        </button>
      </view>
    </view>

    <view class="hint panel" wx:if="{{showHint}}" aria-role="status">
      <text>{{showHelp?cameraHelp:hint}}</text>
      <button aria-label="收起提示" bindtap="hideHint"><ui-icon name="close" size="28" tone="light" decorative></ui-icon></button>
    </view>
  </view>

  <view wx:if="{{stageIndex===0}}" class="stage-footer stagebar">
    <button
      class="stagebar-prev"
      aria-label="返回前置设置"
      bindtap="goPreviousStage"
    ><ui-icon name="back" size="32" tone="light" decorative></ui-icon></button>
    <template is="stageProgress" data="{{stageSteps: stageSteps, stageName: stageName, stageIndex: stageIndex}}"></template>
    <button
      class="stagebar-next"
      aria-label="进入下一道工序：{{nextStageName}}"
      bindtap="completeStage"
    ><ui-icon name="forward" size="32" tone="light" decorative></ui-icon></button>
  </view>

  <view wx:elif="{{stageIndex===1}}" class="decor-tray {{decorTrayOpen?'expanded':'collapsed'}}">
    <button
      class="decor-tray-toggle"
      aria-label="{{decorTrayOpen?'收起全部装饰菜单':'展开全部装饰菜单'}}"
      bindtap="toggleDecorTray"
    ><ui-icon name="{{decorTrayOpen?'collapse':'expand'}}" size="32" tone="light" decorative></ui-icon><text>{{decorTrayOpen?'收起':'展开'}}</text></button>

    <view wx:if="{{decorTrayOpen}}" class="decor-panel-grid">
      <view class="decor-library-panel">
        <view class="decor-catalog-tabs">
          <button
            wx:for="{{decorTabs}}"
            wx:key="id"
            class="{{decorTab===item.id?'active':''}}"
            aria-label="切换到{{item.name}}"
            data-id="{{item.id}}"
            bindtap="selectDecorTab"
          ><small>{{item.seal}}</small><text>{{item.name}}</text></button>
        </view>
        <view class="decor-library-body">
          <view wx:if="{{decorTab==='inscription'}}" class="seal-panel">
            <view class="seal-block">
              <view class="seal-block-head">
                <view class="seal-block-title"><small aria-hidden="true">款</small><text>题款内容</text></view>
                <text class="seal-count">{{sealTextLength}}/{{sealTextLimit}}</text>
              </view>
              <input
                class="seal-input"
                value="{{sealText}}"
                maxlength="6"
                placeholder="最多六个字"
                placeholder-class="seal-input-placeholder"
                aria-label="题款内容，最多六个字"
                bindinput="inputSealText"
              />
            </view>

            <view class="seal-block">
              <view class="seal-block-head">
                <view class="seal-block-title"><small aria-hidden="true">色</small><text>款色</text></view>
              </view>
              <view class="seal-color-row" role="radiogroup" aria-role="radiogroup" aria-label="选择题款款色">
                <button
                  wx:for="{{sealColors}}"
                  wx:key="id"
                  class="seal-color {{sealColorId===item.id?'active':''}}"
                  aria-role="radio"
                  aria-checked="{{sealColorId===item.id}}"
                  aria-label="选择{{item.name}}"
                  data-id="{{item.id}}"
                  bindtap="chooseSealColor"
                >
                  <view class="seal-color-chip" style="background:{{item.color}}"></view>
                  <text class="seal-color-name">{{item.name}}</text>
                </button>
              </view>
            </view>

            <view class="seal-block seal-block-final">
              <button class="seal-apply" aria-label="在器身生成题款" bindtap="applySealMark">{{sealApplied?'重新生成题款':'落款成印'}}</button>
              <text class="seal-hint">{{sealApplied?'题款已入被选图菜单 · 选中后可调校或删除':'生成后可在右侧选中、拖动和调校'}}</text>
            </view>
          </view>

          <block wx:else>
            <scroll-view class="decor-side-menu" scroll-y enhanced show-scrollbar="false">
              <button
                wx:for="{{decorSideMenus}}"
                wx:key="id"
                class="decor-side-menu-item {{decorMenuId===item.id?'active':''}}"
                aria-label="选择{{item.name}}类别，{{decorMenuId===item.id?'已选中':'未选中'}}"
                data-id="{{item.id}}"
                bindtap="selectDecorMenu"
              ><view class="decor-side-menu-icon" aria-hidden="true"><ui-icon name="{{item.icon}}" size="34" tone="{{decorMenuId===item.id?'light':'dark'}}" decorative></ui-icon></view><text>{{item.name}}</text></button>
            </scroll-view>
            <scroll-view class="decor-grid-scroll" scroll-y enhanced show-scrollbar="false">
              <view class="decor-grid">
                <button
                  wx:for="{{decorCatalogItems}}"
                  wx:key="key"
                  class="decor-grid-card {{item.checked?'checked':''}}"
                  aria-role="checkbox"
                  aria-checked="{{item.checked}}"
                  aria-label="{{item.checked?'取消':'选择'}}{{item.name}}"
                  data-id="{{item.id}}"
                  data-key="{{item.key}}"
                  bindtap="toggleDecorCatalogItem"
                >
                  <view class="motif-art {{item.patternClass}}"><view></view><text>{{item.glyph}}</text><view></view></view>
                  <view wx:if="{{item.checked}}" class="decor-check"><ui-icon name="check" size="24" tone="light" decorative></ui-icon></view>
                  <text class="decor-grid-name">{{item.name}}</text>
                </button>
              </view>
            </scroll-view>
          </block>
        </view>
      </view>

      <view class="decor-selected-panel">
        <view class="decor-selected-head"><view><small>已入画</small><text>被选图菜单</text></view><text>{{selectedItemCount}}</text></view>
        <scroll-view class="decor-selected-scroll" scroll-y enhanced show-scrollbar="false">
          <view wx:if="{{decorationLayers.length}}" class="decor-selected-grid">
            <button
              wx:for="{{decorationLayers}}"
              wx:key="id"
              class="decor-selected-card {{item.selected?'active':''}} {{item.visible?'':'hidden'}}"
              aria-role="radio"
              aria-checked="{{item.selected}}"
              aria-label="{{item.ariaLabel}}"
              data-id="{{item.id}}"
              bindtap="selectDecoration"
            >
              <view class="motif-art {{item.patternClass}}"><view></view><text>{{item.glyph}}</text><view></view></view>
              <view wx:if="{{item.selected}}" class="decor-check"><ui-icon name="check" size="24" tone="light" decorative></ui-icon></view>
              <view wx:if="{{item.copyNumber}}" class="decor-copy-badge">{{item.copyNumber}}</view>
              <text>{{item.name}}</text>
            </button>
          </view>
          <view wx:else class="decor-selected-empty"><text>尚未入画</text><small>从左侧轻点图案</small></view>
        </scroll-view>
      </view>
    </view>

    <view class="decor-bottom">
      <button class="decor-previous" disabled="{{confirmingReturn}}" aria-disabled="{{confirmingReturn}}" aria-label="{{confirmingReturn?'等待确认':'返回制坯工序'}}" bindtap="returnToShaping"><ui-icon name="back" size="32" tone="light" decorative></ui-icon></button>
      <template is="stageProgress" data="{{stageSteps: stageSteps, stageName: stageName, stageIndex: stageIndex}}"></template>
      <button class="decor-complete" aria-label="完成装饰，进入上釉工序" bindtap="completeStage"><ui-icon name="forward" size="32" tone="light" decorative></ui-icon></button>
    </view>
  </view>

  <view wx:elif="{{stageIndex===2}}" class="glaze-tray">
    <view class="glaze-panel">
      <view class="glaze-title"><text>彩釉</text></view>
      <view class="glaze-grid" role="radiogroup" aria-role="radiogroup" aria-label="选择彩釉">
        <button
          wx:for="{{glazes}}"
          wx:key="id"
          class="glaze-choice {{glazeId===item.id?'active':''}}"
          aria-role="radio"
          aria-checked="{{glazeId===item.id}}"
          aria-label="选择{{item.name}}"
          data-id="{{item.id}}"
          bindtap="chooseGlaze"
        >
          <view class="glaze-sample" style="background:{{item.swatch}}">
            <view class="glaze-sample-sheen"></view>
            <view class="glaze-sample-pool"></view>
          </view>
          <text>{{item.name}}</text>
          <view wx:if="{{glazeId===item.id}}" class="glaze-check" aria-hidden="true"><ui-icon name="check" size="24" decorative></ui-icon></view>
        </button>
      </view>
    </view>
    <view class="glaze-bottom stagebar">
      <button
        class="stagebar-prev"
        aria-label="返回装饰工序"
        bindtap="goPreviousStage"
      ><ui-icon name="back" size="32" tone="light" decorative></ui-icon></button>
      <template is="stageProgress" data="{{stageSteps: stageSteps, stageName: stageName, stageIndex: stageIndex}}"></template>
      <button
        class="stagebar-next"
        aria-label="完成上釉，直接进入高温烤制"
        bindtap="startFiring"
      ><ui-icon name="forward" size="32" tone="light" decorative></ui-icon></button>
    </view>
  </view>

  <view wx:elif="{{stageIndex===4}}" class="decor-tray paint-tray {{decorTrayOpen?'expanded':'collapsed'}}">
    <button
      class="decor-tray-toggle"
      aria-label="{{decorTrayOpen?'收起全部彩绘菜单':'展开全部彩绘菜单'}}"
      bindtap="toggleDecorTray"
    ><ui-icon name="{{decorTrayOpen?'collapse':'expand'}}" size="32" tone="light" decorative></ui-icon><text>{{decorTrayOpen?'收起':'展开'}}</text></button>

    <button
      class="paint-fired-peek {{firedPreview?'active':''}}"
      aria-label="按住查看低温烤花后的定色效果"
      bindtouchstart="previewFiredStart"
      bindtouchend="previewFiredEnd"
      bindtouchcancel="previewFiredEnd"
    ><ui-icon name="kiln" size="32" tone="light" decorative></ui-icon><text>{{firedPreview?'烤后定色':'按住看烤后'}}</text></button>

    <view wx:if="{{decorTrayOpen}}" class="decor-panel-grid paint-panel-grid">
      <view class="decor-library-panel paint-library-panel">
        <view class="decor-catalog-tabs paint-catalog-tabs">
          <button
            wx:for="{{paintTabs}}"
            wx:key="id"
            class="{{paintTab===item.id?'active':''}}"
            aria-label="切换到{{item.name}}"
            data-id="{{item.id}}"
            bindtap="selectPaintTab"
          ><small>{{item.seal}}</small><text>{{item.name}}</text></button>
        </view>

        <view class="decor-library-body paint-library-body">
          <scroll-view class="decor-grid-scroll paint-grid-scroll" scroll-y enhanced show-scrollbar="false">
            <view class="decor-grid paint-grid">
              <button
                wx:for="{{paintCatalogItems}}"
                wx:key="key"
                class="decor-grid-card paint-grid-card {{item.kind==='color'?'pigment-card':''}} {{item.checked?'checked':''}}"
                aria-role="button"
                aria-pressed="{{item.checked}}"
                aria-label="{{item.ariaLabel}}"
                data-id="{{item.id}}"
                data-key="{{item.key}}"
                bindtap="togglePaintCatalogItem"
              >
                <view wx:if="{{item.kind==='color'}}" class="paint-pigment-art">
                  <view class="paint-pigment-dish"><view style="background:{{item.color}}"></view></view>
                  <text>{{item.glyph}}</text>
                </view>
                <view wx:else class="motif-art paint-motif-art {{item.patternClass}}" style="color:{{item.color}}"><view></view><text>{{item.glyph}}</text><view></view></view>
                <view wx:if="{{item.checked}}" class="decor-check"><ui-icon name="check" size="24" tone="light" decorative></ui-icon></view>
                <text class="decor-grid-name">{{item.name}}</text>
              </button>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="decor-selected-panel paint-selected-panel">
        <view class="decor-selected-head"><view><small>釉上设色</small><text>彩绘图层</text></view><text>{{paintLayerCount}}</text></view>
        <scroll-view class="decor-selected-scroll" scroll-y enhanced show-scrollbar="false">
          <view wx:if="{{paintLayers.length}}" class="decor-selected-grid">
            <button
              wx:for="{{paintLayers}}"
              wx:key="id"
              class="decor-selected-card paint-selected-card {{item.selected?'active':''}} {{item.visible?'':'hidden'}}"
              aria-role="radio"
              aria-checked="{{item.selected}}"
              aria-label="{{item.ariaLabel}}"
              data-id="{{item.id}}"
              bindtap="selectDecoration"
            >
              <view class="motif-art paint-motif-art {{item.patternClass}}" style="color:{{item.color}}"><view></view><text>{{item.glyph}}</text><view></view></view>
              <view class="paint-layer-swatch" style="background:{{item.color}}"></view>
              <view wx:if="{{item.selected}}" class="decor-check"><ui-icon name="check" size="24" tone="light" decorative></ui-icon></view>
              <view wx:if="{{item.copyNumber}}" class="decor-copy-badge">{{item.copyNumber}}</view>
              <text>{{item.name}}</text>
            </button>
          </view>
          <view wx:else class="decor-selected-empty paint-selected-empty"><text>尚未上彩</text><small>从左侧挑一枚图案，或直接涂色</small></view>
        </scroll-view>
      </view>
    </view>

    <view class="decor-bottom paint-bottom">
      <button
        class="decor-previous"
      aria-label="返回上釉工序"
      bindtap="goPreviousStage"
    ><ui-icon name="back" size="32" tone="light" decorative></ui-icon></button>
      <template is="stageProgress" data="{{stageSteps: stageSteps, stageName: stageName, stageIndex: stageIndex}}"></template>
      <button class="decor-complete" aria-label="完成彩绘，直接进入低温烤花" bindtap="startRefire"><ui-icon name="forward" size="32" tone="light" decorative></ui-icon></button>
    </view>
  </view>

  <view wx:elif="{{stageIndex===6}}" class="tray">
    <view class="tray-bottom stagebar">
      <button
        class="stagebar-prev"
        aria-label="返回上一道工序"
        bindtap="goPreviousStage"
      ><ui-icon name="back" size="32" tone="light" decorative></ui-icon></button>
      <template is="stageProgress" data="{{stageSteps: stageSteps, stageName: stageName, stageIndex: stageIndex}}"></template>
      <button
        class="stagebar-next"
        aria-label="查看成品"
        bindtap="completeStage"
      ><ui-icon name="forward" size="32" tone="light" decorative></ui-icon></button>
    </view>
  </view>

  <view wx:else class="tray">
    <scroll-view wx:if="{{tools.length}}" class="tool-scroll" scroll-x show-scrollbar="false">
      <view class="tool-row">
        <button wx:for="{{tools}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseTool" class="tool {{tool===item.id?'active':''}}" aria-label="选择{{item.name}}，{{tool===item.id?'已选中':'未选中'}}">
          <ui-icon name="kiln" size="36" tone="light" decorative></ui-icon><text>{{item.name}}</text>
        </button>
      </view>
    </scroll-view>
    <view class="tray-bottom stagebar">
      <button
        class="stagebar-prev"
        aria-label="返回上一道工序"
        bindtap="goPreviousStage"
      ><ui-icon name="back" size="32" tone="light" decorative></ui-icon><text>上一步</text></button>
      <view class="tool-hint">{{toolName}}</view>
      <button
        class="stagebar-next"
        aria-label="进入下一道工序"
        bindtap="completeStage"
      ><text>完成{{stageName}}</text><ui-icon name="forward" size="32" tone="light" decorative></ui-icon></button>
    </view>
  </view>

  <view wx:if="{{kiln}}" class="kiln-hud">
    <view class="kiln-heading" style="top:{{statusBarHeight+18}}px">
      <view class="kiln-title-rule"></view>
      <view class="kiln-title-copy">
        <small>{{kilnType==='low'?'釉上彩 · 定色':'釉火 · 烧成'}}</small>
        <text>{{kilnTitle}}</text>
      </view>
      <view class="kiln-seal">{{kilnSeal}}</view>
    </view>

    <view class="kiln-status-panel">
      <view class="kiln-status-line">
        <view>
          <small>火候</small>
          <text>{{kilnText}}</text>
        </view>
        <view class="kiln-temperature">
          <text>{{kilnTemperature}}</text><small> / {{kilnTargetTemperature}}℃</small>
        </view>
      </view>
      <view class="kiln-progress" aria-label="烧制进度 {{kilnProgress}}%">
        <view class="kiln-progress-fill ui-motion" style="width:{{kilnProgress}}%">
          <view class="kiln-progress-ember"></view>
        </view>
      </view>
      <view class="kiln-scale"><text>入窑</text><text>升焰</text><text>满火</text></view>
    </view>

    <button class="kiln-skip" aria-label="跳过烧制等待，直接进入下一步" bindtap="skipKiln">
      <text>跳过</text><ui-icon name="forward" size="30" tone="light" decorative></ui-icon>
    </button>
  </view>

  <template name="stageProgress">
    <view class="stage-progress" aria-label="七道工序，当前{{stageName}}，第{{stageIndex+1}}道">
      <view class="stage-progress-line" aria-hidden="true"></view>
      <view
        wx:for="{{stageSteps}}"
        wx:key="id"
        class="stage-progress-step is-{{item.state}}"
        aria-label="{{item.name}}，{{item.state==='done'?'已完成':item.state==='current'?'当前工序':'未开始'}}"
      ><view class="stage-progress-mark">{{item.short}}</view></view>
    </view>
  </template>
</view>
