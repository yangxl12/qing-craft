  padding: 20rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  color: #26322c;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.72), transparent 50rpx),
