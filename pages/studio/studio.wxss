.studio {
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #171c1a;
  display: flex;
  flex-direction: column;
}
.shaping-workshop-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  background: #6f6658;
}
.shaping-workshop-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}
.shaping-workshop-grade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(8, 12, 10, 0.2) 0%,
      rgba(8, 12, 10, 0.03) 35%,
      rgba(8, 11, 9, 0.08) 67%,
      rgba(8, 11, 9, 0.24) 100%
    ),
    radial-gradient(
      ellipse at 50% 45%,
      rgba(22, 31, 26, 0.02) 32%,
      rgba(7, 10, 8, 0.22) 100%
    );
  pointer-events: none;
}
.workshop-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  background:
    radial-gradient(
      ellipse at 52% 34%,
      rgba(170, 184, 175, 0.16),
      transparent 36%
    ),
    linear-gradient(180deg, #33413b 0%, #2c3732 48%, #202724 72%, #171c1a 100%);
}
.wall-glow {
  position: absolute;
  left: 50%;
  top: 7%;
  width: 610rpx;
  height: 850rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    ellipse,
    rgba(241, 225, 197, 0.19) 0%,
    rgba(170, 184, 175, 0.07) 42%,
    transparent 72%
  );
}
.window-light {
  position: absolute;
  right: 46rpx;
  top: 132rpx;
  width: 154rpx;
  height: 236rpx;
  opacity: 0.2;
  background: linear-gradient(
    160deg,
    rgba(170, 184, 175, 0.55),
    rgba(170, 184, 175, 0.04)
  );
  border: 6rpx solid rgba(27, 34, 31, 0.66);
  transform: skewY(-5deg);
}
.window-light view:first-child,
.window-light view:last-child {
  position: absolute;
  background: rgba(23, 28, 26, 0.65);
}
.window-light view:first-child {
  left: 48%;
  top: 0;
  bottom: 0;
  width: 5rpx;
}
.window-light view:last-child {
  left: 0;
  right: 0;
  top: 48%;
  height: 5rpx;
}
.timber {
  position: absolute;
  background: linear-gradient(90deg, #32271f, #4b392d 48%, #2a231d);
  box-shadow: 0 10rpx 24rpx rgba(10, 13, 12, 0.24);
  opacity: 0.72;
}
.timber-left {
  left: 26rpx;
  top: 0;
  width: 44rpx;
  height: 63%;
}
.timber-top {
  left: 0;
  right: 0;
  top: 76rpx;
  height: 34rpx;
}
.timber-diagonal {
  right: -92rpx;
  top: 40rpx;
  width: 390rpx;
  height: 30rpx;
  transform: rotate(-35deg);
  transform-origin: right center;
  opacity: 0.42;
}
.kiln-arch {
  position: absolute;
  right: -75rpx;
  top: 35%;
  width: 250rpx;
  height: 290rpx;
  border-radius: 126rpx 126rpx 18rpx 18rpx;
  background: #18201d;
  border: 16rpx solid rgba(75, 57, 45, 0.28);
  opacity: 0.58;
}
.kiln-arch view {
  position: absolute;
  inset: 38rpx 46rpx 0;
  border-radius: 90rpx 90rpx 8rpx 8rpx;
  background: linear-gradient(180deg, #101513, #20221e);
}
.pottery-rack {
  position: absolute;
  left: 68rpx;
  top: 244rpx;
  width: 244rpx;
  height: 238rpx;
  opacity: 0.19;
  filter: blur(1rpx);
}
.rack-shelf {
  position: absolute;
  left: 0;
  width: 100%;
  height: 11rpx;
  border-radius: 6rpx;
  background: #6a5140;
  box-shadow: 0 10rpx 18rpx rgba(9, 12, 11, 0.4);
}
.shelf-upper {
  top: 92rpx;
}
.shelf-lower {
  top: 204rpx;
}
.rack-pot {
  position: absolute;
  bottom: 34rpx;
  background: #675446;
  border-radius: 16rpx 16rpx 34rpx 34rpx;
  box-shadow: inset 8rpx 0 12rpx rgba(241, 225, 197, 0.12);
}
.rack-pot:before {
  content: "";
  position: absolute;
  left: 14%;
  right: 14%;
  top: -7rpx;
  height: 13rpx;
  border-radius: 50%;
  border: 4rpx solid #675446;
}
.rack-pot-one {
  left: 14rpx;
  width: 58rpx;
  height: 50rpx;
}
.rack-pot-two {
  left: 93rpx;
  width: 72rpx;
  height: 64rpx;
}
.rack-pot-three {
  right: 14rpx;
  width: 50rpx;
  height: 42rpx;
}
.table-plane {
  position: absolute;
  left: 0;
  right: 0;
  top: 56%;
  bottom: 0;
  overflow: hidden;
  background: linear-gradient(
    180deg,
    rgba(75, 57, 45, 0.58),
    rgba(23, 28, 26, 0.95)
  );
  border-top: 3rpx solid rgba(151, 125, 101, 0.22);
}
.perspective-line {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: linear-gradient(rgba(170, 184, 175, 0.13), transparent 72%);
  transform-origin: top center;
}
.line-left {
  left: 43%;
  transform: rotate(19deg);
}
.line-right {
  right: 43%;
  transform: rotate(-19deg);
}
.vignette {
  position: absolute;
  inset: -2rpx;
  background: radial-gradient(
    ellipse at 50% 38%,
    transparent 35%,
    rgba(10, 14, 12, 0.52) 100%
  );
  pointer-events: none;
}

/* 窑房天光：青灰灰泥、旧木格窗与暖窑火共同建立前后景深。 */
