.studio {
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: linear-gradient(
    #bdc9c0 0,
    #8f9d93 55%,
    #574e45 56%,
    #302f2b 100%
  );
  display: flex;
  flex-direction: column;
}
.workshop-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
}
.light {
  position: absolute;
  width: 620rpx;
  height: 1000rpx;
  right: -250rpx;
  top: -160rpx;
  background: linear-gradient(
    140deg,
    rgba(255, 255, 241, 0.62),
    rgba(255, 255, 255, 0) 55%
  );
  transform: skewX(-9deg);
}
.shelf-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 220rpx;
  height: 18rpx;
  background: #605a50;
  box-shadow: 0 18rpx 30rpx rgba(34, 36, 31, 0.18);
}
.table {
  position: absolute;
  left: 0;
  right: 0;
  top: 57%;
  bottom: 0;
  background: linear-gradient(110deg, #6b6257, #423f39);
}
/* 舞台区：顶栏与工序带之间的全部可视区域，flex 自适应高度（兼容任意安全区高度） */
.stage-area {
  position: relative;
  flex: 1;
  min-height: 0;
  z-index: 1;
}
.stage-spacer {
  flex: none;
  height: 442rpx;
}
.canvas {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
}
.fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
/* 转盘：静态盘面，中心对齐默认陶坯底部投影位置 */
.wheel {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 76%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  height: 170rpx;
  border-radius: 50%;
  background: #9b8f7f;
  box-shadow:
    0 30rpx 30rpx rgba(0, 0, 0, 0.25),
    inset 0 12rpx 0 #c7b8a0;
}
.wheel-ring {
  position: absolute;
  inset: 24rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(71, 66, 58, 0.28);
}
.wheel-ring.r2 {
  inset: 50rpx;
}
.topbar {
  position: relative;
  z-index: 5;
  height: 94rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #f5f7f2;
}
.top-button,
.circle {
  background: rgba(32, 40, 34, 0.7);
  color: #f5f7f2;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 23rpx;
}
.top-button {
  width: 84rpx;
}
.work-title {
  text-align: center;
}
.work-title view {
  font-size: 28rpx;
}
.work-title text {
  font-size: 18rpx;
  color: #e7bf6c;
}
.work-title text.saved {
  color: #c7d9d0;
}
.top-actions {
  display: flex;
  gap: 8rpx;
}
.circle {
  width: 62rpx;
}
.circle[disabled] {
  opacity: 0.38;
}
.stage-label {
  position: absolute;
  z-index: 4;
  top: 16rpx;
  left: 30rpx;
  color: #f5f7f2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}
.stage-label .eyebrow {
  color: #d5e4dc;
}
.stage-label .display {
  font-size: 44rpx;
  margin-top: 6rpx;
}
.hint {
  position: absolute;
  z-index: 7;
  top: 96rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  max-width: 440rpx;
}
.teacher-mark {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #52796a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-family: "Songti SC", serif;
}
.hint text {
  font-size: 24rpx;
}
.hint small {
  display: block;
  font-size: 18rpx;
  color: #78847d;
  margin-top: 5rpx;
}
.ring-band {
  position: absolute;
  z-index: 4;
  left: 28rpx;
  right: 28rpx;
  bottom: 348rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ring-band:before {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 31rpx;
  border-top: 2rpx solid rgba(245, 247, 242, 0.4);
}
.ring-step {
  position: relative;
  text-align: center;
  color: rgba(245, 247, 242, 0.68);
  width: 86rpx;
}
.ring-step view {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #444942;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  margin: 0 auto;
  font-size: 20rpx;
}
.ring-step text {
  font-size: 17rpx;
  display: block;
  margin-top: 7rpx;
  white-space: nowrap;
}
.ring-step.done view {
  background: #52796a;
  color: white;
}
.ring-step.active view {
  background: #84a99a;
  color: #fff;
  box-shadow: 0 0 0 10rpx rgba(132, 169, 154, 0.23);
  transform: scale(1.08);
}
.ring-step.active text {
  color: white;
  font-weight: 700;
}
.tray {
  position: absolute;
  z-index: 6;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 332rpx;
  padding: 24rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f7f2;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -20rpx 50rpx rgba(32, 40, 34, 0.18);
}
.tool-scroll,
.swatch-scroll {
  width: 100%;
}
.tool-row,
.swatch-row {
  display: flex;
  gap: 18rpx;
  padding: 3rpx 4rpx 20rpx;
}
.tool {
  width: 104rpx;
  flex: none;
  text-align: center;
  color: #66716b;
}
.tool view {
  width: 86rpx;
  height: 86rpx;
  margin: auto;
  border-radius: 26rpx;
  background: #e2e8e3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 31rpx;
  border: 2rpx solid transparent;
}
.tool text {
  font-size: 20rpx;
  display: block;
  margin-top: 9rpx;
}
.tool.active view {
  background: #52796a;
  color: #fff;
  border-color: #385c4f;
}
.tool.active text {
  color: #202822;
  font-weight: 700;
}
.swatch-row {
  gap: 24rpx;
}
.swatch-item {
  width: 82rpx;
  flex: none;
  text-align: center;
}
.swatch-item view {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin: auto;
  border: 7rpx solid #f5f7f2;
  box-shadow: 0 0 0 2rpx rgba(32, 40, 34, 0.14);
}
.swatch-item.active view {
  box-shadow: 0 0 0 5rpx #52796a;
}
.swatch-item text {
  font-size: 18rpx;
  display: block;
  margin-top: 7rpx;
}
.paint-row {
  height: 80rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 0 6rpx 16rpx;
}
.paint-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx #d9dfda;
}
.symmetry {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 22rpx;
  background: #e2e8e3;
  font-size: 21rpx;
  color: #384940;
  margin-left: auto;
}
.tray-bottom {
  height: 94rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  border-top: 1rpx solid rgba(32, 40, 34, 0.09);
  padding-top: 15rpx;
}
.reset {
  height: 70rpx;
  line-height: 70rpx;
  width: 112rpx;
  background: #e3e8e3;
  color: #46524c;
  font-size: 21rpx;
}
.tool-hint {
  font-size: 21rpx;
  color: #66716b;
  flex: 1;
  text-align: center;
}
.complete {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 26rpx;
  background: #202822;
  color: #fff;
  font-size: 23rpx;
  min-width: 230rpx;
}
.fallback-pot {
  width: 250rpx;
  height: 320rpx;
  clip-path: polygon(
    27% 0,
    73% 0,
    80% 16%,
    70% 40%,
    87% 70%,
    84% 100%,
    16% 100%,
    13% 70%,
    30% 40%,
    20% 16%
  );
  border-radius: 40%;
  box-shadow:
    inset 30rpx 0 30rpx rgba(255, 255, 255, 0.34),
    15rpx 28rpx 30rpx rgba(0, 0, 0, 0.25);
}
.fallback-note {
  margin-top: 30rpx;
  color: #fff;
  font-size: 22rpx;
}
.kiln-overlay {
  position: absolute;
  z-index: 20;
  inset: 0;
  background: rgba(24, 22, 20, 0.91);
  display: flex;
  align-items: center;
  justify-content: center;
}
.kiln-door {
  width: 590rpx;
  height: 780rpx;
  border-radius: 300rpx 300rpx 40rpx 40rpx;
  background: #382d29;
  border: 22rpx solid #5b514b;
  position: relative;
  overflow: hidden;
  text-align: center;
  color: #fff;
  box-shadow: inset 0 0 100rpx #0d0c0b;
}
.kiln-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at 50% 70%,
    #ffb04f,
    #e44c23 44%,
    transparent 76%
  );
}
.temperature {
  position: relative;
  font-family: monospace;
  font-size: 80rpx;
  margin-top: 180rpx;
}
.temperature text {
  font-size: 28rpx;
}
.kiln-copy {
  position: relative;
  font-size: 36rpx;
  margin-top: 40rpx;
}
.kiln-progress {
  position: relative;
  width: 400rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 54rpx auto;
  border-radius: 5rpx;
  overflow: hidden;
}
.kiln-progress view {
  height: 100%;
  background: #ffd18e;
}
.kiln-door button {
  position: relative;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  width: 210rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 22rpx;
}
