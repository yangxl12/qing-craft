.studio {
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #171c1a;
  display: flex;
  flex-direction: column;
}
.workshop-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  background:
    radial-gradient(ellipse at 52% 34%, rgba(170, 184, 175, 0.16), transparent 36%),
    linear-gradient(180deg, #33413b 0%, #2c3732 48%, #202724 72%, #171c1a 100%);
}
.wall-glow {
  position: absolute;
  left: 50%;
  top: 7%;
  width: 610rpx;
  height: 850rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    ellipse,
    rgba(241, 225, 197, 0.19) 0%,
    rgba(170, 184, 175, 0.07) 42%,
    transparent 72%
  );
}
.window-light {
  position: absolute;
  right: 46rpx;
  top: 132rpx;
  width: 154rpx;
  height: 236rpx;
  opacity: 0.2;
  background: linear-gradient(160deg, rgba(170, 184, 175, 0.55), rgba(170, 184, 175, 0.04));
  border: 6rpx solid rgba(27, 34, 31, 0.66);
  transform: skewY(-5deg);
}
.window-light view:first-child,
.window-light view:last-child {
  position: absolute;
  background: rgba(23, 28, 26, 0.65);
}
.window-light view:first-child {
  left: 48%;
  top: 0;
  bottom: 0;
  width: 5rpx;
}
.window-light view:last-child {
  left: 0;
  right: 0;
  top: 48%;
  height: 5rpx;
}
.timber {
  position: absolute;
  background: linear-gradient(90deg, #32271f, #4b392d 48%, #2a231d);
  box-shadow: 0 10rpx 24rpx rgba(10, 13, 12, 0.24);
  opacity: 0.72;
}
.timber-left {
  left: 26rpx;
  top: 0;
  width: 44rpx;
  height: 63%;
}
.timber-top {
  left: 0;
  right: 0;
  top: 76rpx;
  height: 34rpx;
}
.timber-diagonal {
  right: -92rpx;
  top: 40rpx;
  width: 390rpx;
  height: 30rpx;
  transform: rotate(-35deg);
  transform-origin: right center;
  opacity: 0.42;
}
.kiln-arch {
  position: absolute;
  right: -75rpx;
  top: 35%;
  width: 250rpx;
  height: 290rpx;
  border-radius: 126rpx 126rpx 18rpx 18rpx;
  background: #18201d;
  border: 16rpx solid rgba(75, 57, 45, 0.28);
  opacity: 0.58;
}
.kiln-arch view {
  position: absolute;
  inset: 38rpx 46rpx 0;
  border-radius: 90rpx 90rpx 8rpx 8rpx;
  background: linear-gradient(180deg, #101513, #20221e);
}
.pottery-rack {
  position: absolute;
  left: 68rpx;
  top: 244rpx;
  width: 244rpx;
  height: 238rpx;
  opacity: 0.19;
  filter: blur(1rpx);
}
.rack-shelf {
  position: absolute;
  left: 0;
  width: 100%;
  height: 11rpx;
  border-radius: 6rpx;
  background: #6a5140;
  box-shadow: 0 10rpx 18rpx rgba(9, 12, 11, 0.4);
}
.shelf-upper {
  top: 92rpx;
}
.shelf-lower {
  top: 204rpx;
}
.rack-pot {
  position: absolute;
  bottom: 34rpx;
  background: #675446;
  border-radius: 16rpx 16rpx 34rpx 34rpx;
  box-shadow: inset 8rpx 0 12rpx rgba(241, 225, 197, 0.12);
}
.rack-pot:before {
  content: "";
  position: absolute;
  left: 14%;
  right: 14%;
  top: -7rpx;
  height: 13rpx;
  border-radius: 50%;
  border: 4rpx solid #675446;
}
.rack-pot-one {
  left: 14rpx;
  width: 58rpx;
  height: 50rpx;
}
.rack-pot-two {
  left: 93rpx;
  width: 72rpx;
  height: 64rpx;
}
.rack-pot-three {
  right: 14rpx;
  width: 50rpx;
  height: 42rpx;
}
.table-plane {
  position: absolute;
  left: 0;
  right: 0;
  top: 56%;
  bottom: 0;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(75, 57, 45, 0.58), rgba(23, 28, 26, 0.95));
  border-top: 3rpx solid rgba(151, 125, 101, 0.22);
}
.perspective-line {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: linear-gradient(rgba(170, 184, 175, 0.13), transparent 72%);
  transform-origin: top center;
}
.line-left {
  left: 43%;
  transform: rotate(19deg);
}
.line-right {
  right: 43%;
  transform: rotate(-19deg);
}
.vignette {
  position: absolute;
  inset: -2rpx;
  background: radial-gradient(ellipse at 50% 38%, transparent 35%, rgba(10, 14, 12, 0.52) 100%);
  pointer-events: none;
}
/* 舞台区：顶栏与工序带之间的全部可视区域，flex 自适应高度（兼容任意安全区高度） */
.stage-area {
  position: relative;
  flex: 1;
  min-height: 0;
  z-index: 1;
}
.pottery-spotlight {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 5%;
  width: 520rpx;
  height: 690rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    ellipse at 43% 40%,
    rgba(241, 225, 197, 0.22),
    rgba(170, 184, 175, 0.07) 48%,
    transparent 73%
  );
  pointer-events: none;
}
.canvas {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  z-index: 2;
}
.fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  pointer-events: auto;
}
/* 转盘完整收在舞台内，底缘与紧随其后的工序带恒定相隔 14px。 */
.wheel-root {
  position: absolute;
  z-index: 3;
  left: 50%;
  bottom: 14px;
  width: 590rpx;
  height: 122rpx;
  transform: translateX(-50%);
  pointer-events: none;
}
.wheel-head {
  position: absolute;
  z-index: 2;
  left: 0;
  top: 0;
  width: 590rpx;
  height: 122rpx;
  overflow: hidden;
  border-radius: 50%;
  background: linear-gradient(180deg, #b9bbb4 0%, #7f8580 52%, #515b56 100%);
  border: 2rpx solid rgba(231, 234, 225, 0.38);
  box-shadow:
    inset 0 10rpx 14rpx rgba(247, 244, 231, 0.3),
    inset 0 -22rpx 24rpx rgba(25, 33, 29, 0.42),
    0 24rpx 34rpx rgba(4, 8, 6, 0.38);
}
.wheel-head-spin {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 590rpx;
  height: 590rpx;
  border-radius: 50%;
  background-color: #92968f;
  background-image: conic-gradient(
    from 16deg,
    rgba(244, 240, 225, 0.26),
    rgba(58, 68, 62, 0.08) 22%,
    rgba(229, 225, 211, 0.16) 49%,
    rgba(44, 55, 49, 0.15) 75%,
    rgba(244, 240, 225, 0.26)
  );
  transform-origin: center;
  animation: wheel-turn var(--wheel-period) linear infinite;
  will-change: transform;
}
.wheel-paused .wheel-head-spin {
  animation-play-state: paused;
}
.machined-rings {
  position: absolute;
  inset: 16rpx;
  border-radius: 50%;
  background: repeating-radial-gradient(
    circle,
    transparent 0,
    transparent 31rpx,
    rgba(38, 48, 43, 0.2) 33rpx,
    rgba(242, 239, 225, 0.11) 35rpx,
    transparent 38rpx
  );
}
.slip-mark {
  position: absolute;
  left: 82rpx;
  top: 72rpx;
  width: 410rpx;
  height: 410rpx;
  border-radius: 50%;
  border-top: 16rpx solid rgba(107, 88, 72, 0.2);
  border-right: 8rpx solid transparent;
  transform: rotate(17deg);
}
.wheel-glint {
  position: absolute;
  left: 132rpx;
  top: 82rpx;
  width: 250rpx;
  height: 92rpx;
  border-radius: 50%;
  border-top: 8rpx solid rgba(248, 244, 226, 0.13);
  transform: rotate(-12deg);
}
.contact-shadow {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: -14rpx;
  width: var(--contact-shadow-width);
  height: 48rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(5, 8, 7, 0.62), rgba(5, 8, 7, 0) 72%);
}
@keyframes wheel-turn {
  from {
    transform: translate(-50%, -50%) scaleY(0.207) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) scaleY(0.207) rotate(360deg);
  }
}
.gesture-map {
  position: absolute;
  z-index: 5;
  top: 120rpx;
  right: 22rpx;
  width: 174rpx;
  padding: 15rpx 13rpx 13rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  color: rgba(241, 240, 229, 0.62);
  background:
    linear-gradient(145deg, rgba(49, 62, 56, 0.88), rgba(20, 27, 24, 0.82)),
    rgba(20, 27, 24, 0.8);
  border: 1rpx solid rgba(183, 207, 194, 0.18);
  box-shadow:
    inset 0 1rpx 0 rgba(245, 241, 224, 0.08),
    0 16rpx 36rpx rgba(4, 8, 6, 0.2);
  backdrop-filter: blur(10rpx);
  pointer-events: none;
}
.gesture-map-title {
  padding: 0 4rpx 9rpx;
  color: rgba(214, 228, 219, 0.72);
  font-size: 16rpx;
  letter-spacing: 0.18em;
}
.gesture-row {
  height: 45rpx;
  display: flex;
  align-items: center;
  border-radius: 11rpx;
}
.gesture-row .arrow-pair,
.gesture-row .arrow-single {
  width: 68rpx;
  text-align: center;
  color: #92b9a8;
  font-family: "Songti SC", serif;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
}
.gesture-row .arrow-single {
  font-size: 31rpx;
}
.gesture-row text {
  font-size: 17rpx;
  white-space: nowrap;
}
.gesture-camera {
  margin-top: 9rpx;
  padding-top: 11rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border-top: 1rpx solid rgba(211, 226, 217, 0.12);
  color: rgba(211, 226, 217, 0.56);
}
.gesture-camera text {
  font-size: 15rpx;
  white-space: nowrap;
}
.finger-pair {
  width: 38rpx;
  height: 26rpx;
  position: relative;
  flex: none;
}
.finger-pair view {
  position: absolute;
  bottom: 0;
  width: 11rpx;
  height: 25rpx;
  border: 2rpx solid #8fb4a3;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  box-sizing: border-box;
}
.finger-pair view:first-child {
  left: 5rpx;
  transform: rotate(-8deg);
}
.finger-pair view:last-child {
  right: 5rpx;
  height: 21rpx;
  transform: rotate(9deg);
}
.topbar {
  position: relative;
  flex: none;
  z-index: 5;
  height: 94rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #f5f7f2;
}
.top-button,
.circle {
  background: rgba(23, 28, 26, 0.78);
  border: 1rpx solid rgba(170, 184, 175, 0.16);
  color: #f5f7f2;
  height: 64rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
}
.top-button {
  position: absolute;
  left: 22rpx;
  width: 84rpx;
  min-width: 0;
  flex: 0 0 84rpx;
  margin: 0 !important;
}
.work-title {
  position: absolute;
  left: 50%;
  width: 230rpx;
  transform: translateX(-50%);
  text-align: center;
  pointer-events: none;
}
.work-title view {
  font-size: 28rpx;
}
.work-title text {
  font-size: 18rpx;
  color: #e7bf6c;
}
.work-title text.saved {
  color: #c7d9d0;
}
.top-actions {
  position: absolute;
  right: 22rpx;
  flex: 0 0 202rpx;
  width: 202rpx;
  display: flex;
  gap: 8rpx;
}
.circle {
  width: 62rpx;
  min-width: 0;
  flex: 0 0 62rpx;
  margin: 0 !important;
}
.circle.disabled {
  opacity: 0.38;
}
.stage-label {
  position: absolute;
  z-index: 4;
  top: 16rpx;
  left: 30rpx;
  color: #f5f7f2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}
.stage-label .eyebrow {
  color: #d5e4dc;
}
.stage-label .display {
  font-size: 44rpx;
  margin-top: 6rpx;
}
.hint {
  position: absolute;
  z-index: 7;
  top: 96rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  max-width: 360rpx;
  box-shadow: 0 14rpx 34rpx rgba(9, 12, 11, 0.18);
}
.teacher-mark {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #52796a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-family: "Songti SC", serif;
}
.hint text {
  font-size: 22rpx;
}
.hint small {
  display: block;
  font-size: 18rpx;
  color: #78847d;
  margin-top: 5rpx;
}
.ring-band {
  position: relative;
  flex: none;
  z-index: 4;
  width: calc(100% - 56rpx);
  height: 98rpx;
  margin: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ring-band:before {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 31rpx;
  border-top: 2rpx solid rgba(245, 247, 242, 0.4);
}
.ring-step {
  position: relative;
  text-align: center;
  color: rgba(245, 247, 242, 0.68);
  width: 86rpx;
}
.ring-step view {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #444942;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  margin: 0 auto;
  font-size: 20rpx;
}
.ring-step text {
  font-size: 17rpx;
  display: block;
  margin-top: 7rpx;
  white-space: nowrap;
}
.ring-step.done view {
  background: #52796a;
  color: white;
}
.ring-step.active view {
  background: #84a99a;
  color: #fff;
  box-shadow: 0 0 0 10rpx rgba(132, 169, 154, 0.23);
  transform: scale(1.08);
}
.ring-step.active text {
  color: white;
  font-weight: 700;
}
.tray {
  position: relative;
  flex: none;
  z-index: 6;
  width: 100%;
  min-height: 318rpx;
  padding: 24rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f7f2;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -20rpx 50rpx rgba(32, 40, 34, 0.18);
}
.tray-shaping {
  min-height: 322rpx;
  padding-top: 18rpx;
}
.shaping-console {
  height: 178rpx;
}
.shaping-console-head {
  height: 54rpx;
  padding: 0 4rpx 8rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
}
.shaping-console-head > view:first-child > text {
  display: block;
  color: #26332d;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
}
.shaping-console-head small {
  display: block;
  margin-top: 2rpx;
  color: #78827d;
  font-size: 16rpx;
}
.shaping-badge {
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 15rpx;
  border-radius: 18rpx;
  color: #456758;
  background: #e2ebe5;
  font-size: 16rpx;
  letter-spacing: 0.08em;
}
.shape-mode-row {
  height: 116rpx;
  display: flex;
  gap: 12rpx;
}
.shape-mode {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 108rpx;
  padding: 10rpx 8rpx 9rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #53615a;
  background: #e8ede9;
  border: 2rpx solid transparent;
  transition: transform 120ms ease, background 120ms ease, border-color 120ms ease;
}
.shape-mode.active {
  color: #f7f8f3;
  background: linear-gradient(145deg, #648b79, #456a5b);
  border-color: #315448;
  box-shadow: 0 9rpx 20rpx rgba(49, 84, 72, 0.2);
  transform: translateY(-3rpx);
}
.form-glyph {
  position: relative;
  width: 52rpx;
  height: 54rpx;
  flex: none;
  color: #799286;
}
.shape-mode.active .form-glyph {
  color: #e9f2ed;
}
.glyph-curve:before,
.glyph-cone:before,
.glyph-square:before {
  content: "";
  position: absolute;
  box-sizing: border-box;
}
.glyph-curve:before {
  left: 6rpx;
  bottom: 9rpx;
  width: 40rpx;
  height: 31rpx;
  border: 5rpx solid currentColor;
  border-bottom: 0;
  border-radius: 26rpx 26rpx 0 0;
}
.glyph-cone:before {
  left: 5rpx;
  top: 7rpx;
  width: 42rpx;
  height: 42rpx;
  background: currentColor;
  clip-path: polygon(50% 0, 100% 100%, 84% 100%, 50% 23%, 16% 100%, 0 100%);
}
.glyph-square:before {
  left: 6rpx;
  bottom: 8rpx;
  width: 40rpx;
  height: 37rpx;
  border: 5rpx solid currentColor;
  border-bottom: 0;
}
.shape-copy {
  min-width: 0;
}
.shape-copy text,
.shape-copy small {
  display: block;
  white-space: nowrap;
}
.shape-copy text {
  font-size: 21rpx;
  font-weight: 700;
}
.shape-copy small {
  margin-top: 4rpx;
  color: #7a8780;
  font-size: 14rpx;
}
.shape-mode.active .shape-copy small {
  color: rgba(239, 246, 242, 0.72);
}
.tool-scroll,
.swatch-scroll {
  width: 100%;
}
.tool-row,
.swatch-row {
  display: flex;
  gap: 18rpx;
  padding: 3rpx 4rpx 20rpx;
}
.tool {
  width: 104rpx;
  flex: none;
  text-align: center;
  color: #66716b;
}
.tool view {
  width: 86rpx;
  height: 86rpx;
  margin: auto;
  border-radius: 26rpx;
  background: #e2e8e3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 31rpx;
  border: 2rpx solid transparent;
}
.tool text {
  font-size: 20rpx;
  display: block;
  margin-top: 9rpx;
}
.tool.active view {
  background: #52796a;
  color: #fff;
  border-color: #385c4f;
}
.tool.active text {
  color: #202822;
  font-weight: 700;
}
.swatch-row {
  gap: 24rpx;
}
.swatch-item {
  width: 82rpx;
  flex: none;
  text-align: center;
}
.swatch-item view {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin: auto;
  border: 7rpx solid #f5f7f2;
  box-shadow: 0 0 0 2rpx rgba(32, 40, 34, 0.14);
}
.swatch-item.active view {
  box-shadow: 0 0 0 5rpx #52796a;
}
.swatch-item text {
  font-size: 18rpx;
  display: block;
  margin-top: 7rpx;
}
.paint-row {
  height: 80rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 0 6rpx 16rpx;
}
.paint-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx #d9dfda;
}
.symmetry {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 22rpx;
  background: #e2e8e3;
  font-size: 21rpx;
  color: #384940;
  margin-left: auto;
}
.tray-bottom {
  height: 94rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  border-top: 1rpx solid rgba(32, 40, 34, 0.09);
  padding-top: 15rpx;
}
.tray-shaping .tray-bottom {
  justify-content: space-between;
}
.reset {
  height: 70rpx;
  line-height: 70rpx;
  width: 146rpx;
  background: #e3e8e3;
  color: #46524c;
  font-size: 21rpx;
}
.tool-hint {
  font-size: 19rpx;
  color: #66716b;
  flex: 1;
  text-align: center;
}
.reduce-motion .shape-mode {
  transition: none;
}
.complete {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 26rpx;
  background: #202822;
  color: #fff;
  font-size: 23rpx;
  min-width: 230rpx;
}
.fallback-pot {
  position: absolute;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent));
  transform: translateX(-50%);
  width: 250rpx;
  height: 320rpx;
  clip-path: polygon(
    27% 0,
    73% 0,
    80% 16%,
    70% 40%,
    87% 70%,
    84% 100%,
    16% 100%,
    13% 70%,
    30% 40%,
    20% 16%
  );
  border-radius: 40%;
  box-shadow:
    inset 30rpx 0 30rpx rgba(255, 255, 255, 0.34),
    15rpx 28rpx 30rpx rgba(0, 0, 0, 0.25);
}
.fallback-note {
  position: absolute;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent) - 54rpx);
  transform: translateX(-50%);
  color: #fff;
  font-size: 22rpx;
}
.kiln-overlay {
  position: absolute;
  z-index: 20;
  inset: 0;
  background: rgba(24, 22, 20, 0.91);
  display: flex;
  align-items: center;
  justify-content: center;
}
.kiln-door {
  width: 590rpx;
  height: 780rpx;
  border-radius: 300rpx 300rpx 40rpx 40rpx;
  background: #382d29;
  border: 22rpx solid #5b514b;
  position: relative;
  overflow: hidden;
  text-align: center;
  color: #fff;
  box-shadow: inset 0 0 100rpx #0d0c0b;
}
.kiln-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at 50% 70%,
    #ffb04f,
    #e44c23 44%,
    transparent 76%
  );
}
.temperature {
  position: relative;
  font-family: monospace;
  font-size: 80rpx;
  margin-top: 180rpx;
}
.temperature text {
  font-size: 28rpx;
}
.kiln-copy {
  position: relative;
  font-size: 36rpx;
  margin-top: 40rpx;
}
.kiln-progress {
  position: relative;
  width: 400rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 54rpx auto;
  border-radius: 5rpx;
  overflow: hidden;
}
.kiln-progress view {
  height: 100%;
  background: #ffd18e;
}
.kiln-door button {
  position: relative;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  width: 210rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 22rpx;
}

/* 制坯工作台：把操作收进四角，让陶坯成为视觉中心。 */
.topbar {
  height: 82rpx;
  padding: 0 20rpx;
}
.top-actions {
  position: absolute;
  left: 20rpx;
  right: auto;
  width: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.top-action,
.circle {
  height: 56rpx;
  min-width: 56rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(245, 247, 242, .82);
  background: rgba(18, 25, 22, .52);
  border: 1rpx solid rgba(188, 207, 197, .14);
  backdrop-filter: blur(12rpx);
  font-size: 19rpx;
  transition: transform 140ms ease, background 140ms ease, opacity 140ms ease;
}
.top-action { padding: 0 16rpx; }
.top-reset { color: rgba(225, 235, 229, .62); background: rgba(18, 25, 22, .34); }
.circle { width: 56rpx; flex: 0 0 56rpx; }
.top-action:active,
.circle:active { transform: scale(.94); background: rgba(80, 112, 97, .58); }

.gesture-map {
  top: 14rpx;
  right: 20rpx;
  width: 150rpx;
  padding: 11rpx 11rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(20, 28, 24, .68);
  box-shadow: 0 12rpx 28rpx rgba(4, 8, 6, .14);
}
.gesture-map-title { padding: 0 3rpx 5rpx; font-size: 14rpx; }
.gesture-row { height: 34rpx; }
.gesture-row .arrow-pair,
.gesture-row .arrow-single { width: 58rpx; font-size: 22rpx; }
.gesture-row text { font-size: 15rpx; }
.gesture-camera { margin-top: 5rpx; padding-top: 7rpx; gap: 6rpx; }
.gesture-camera text { font-size: 14rpx; }
.finger-pair { width: 30rpx; height: 22rpx; }
.finger-pair view { width: 9rpx; height: 21rpx; }
.finger-pair view:last-child { height: 18rpx; }

.form-switcher {
  position: absolute;
  z-index: 6;
  top: 184rpx;
  right: 20rpx;
  width: 150rpx;
  padding: 7rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  background: rgba(20, 28, 24, .48);
  border: 1rpx solid rgba(183, 207, 194, .12);
  backdrop-filter: blur(10rpx);
}
.form-chip {
  height: 36rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(226, 235, 229, .58);
  font-size: 15rpx;
  letter-spacing: .08em;
  transition: color 120ms ease, background 120ms ease, transform 120ms ease;
}
.form-chip.active { color: #f3f7f4; background: rgba(116, 156, 137, .7); }
.form-chip:active { transform: scale(.96); }

.material-dock {
  position: absolute;
  z-index: 8;
  left: 20rpx;
  top: 12rpx;
  bottom: auto;
  width: 322rpx;
}
.dock-row { display: flex; gap: 9rpx; }
.dock-trigger {
  width: 156rpx;
  height: 62rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 19rpx;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 7rpx;
  color: rgba(239, 243, 239, .82);
  background: rgba(20, 28, 24, .58);
  border: 1rpx solid rgba(191, 210, 200, .14);
  box-shadow: 0 12rpx 28rpx rgba(4, 8, 6, .16);
  backdrop-filter: blur(12rpx);
  transition: transform 140ms ease, background 140ms ease;
}
.dock-trigger > text { color: rgba(204, 218, 210, .52); font-size: 14rpx; }
.dock-trigger > view { overflow: hidden; font-size: 17rpx; white-space: nowrap; text-overflow: ellipsis; }
.dock-trigger small { color: #9ab8a9; font-size: 23rpx; font-weight: 300; }
.dock-trigger.open { background: rgba(65, 94, 80, .84); }
.dock-trigger:active { transform: scale(.97); }

.choice-popover {
  position: absolute;
  left: 0;
  top: 74rpx;
  bottom: auto;
  width: 322rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  color: #eaf1ed;
  background: rgba(24, 34, 29, .94);
  border: 1rpx solid rgba(193, 213, 202, .16);
  box-shadow: 0 20rpx 46rpx rgba(3, 7, 5, .28);
  backdrop-filter: blur(18rpx);
  animation: dock-open 160ms ease-out both;
}
.choice-title { margin: 0 2rpx 12rpx; color: rgba(209, 223, 215, .58); font-size: 14rpx; letter-spacing: .18em; }
.choice-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 7rpx; }
.choice-item {
  height: 52rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(234, 241, 237, .66);
  background: rgba(255, 255, 255, .055);
  font-size: 18rpx;
  transition: transform 120ms ease, background 120ms ease;
}
.choice-item.active { color: #fff; background: #52796a; box-shadow: inset 0 0 0 1rpx rgba(223, 239, 230, .24); }
.choice-item:active,
.clay-choice:active { transform: scale(.96); }
.clay-choice {
  height: 54rpx;
  padding: 0 12rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(235, 241, 237, .68);
  font-size: 17rpx;
  transition: transform 120ms ease, background 120ms ease;
}
.clay-choice.active { color: #fff; background: rgba(82, 121, 106, .66); }
.clay-dot { width: 26rpx; height: 26rpx; border-radius: 50%; box-shadow: inset -5rpx -5rpx 10rpx rgba(35, 28, 22, .15), 0 0 0 2rpx rgba(255, 255, 255, .12); }
@keyframes dock-open {
  from { opacity: 0; transform: translateY(10rpx) scale(.98); }
  to { opacity: 1; transform: none; }
}

.hint {
  top: 16rpx;
  left: 20rpx;
  max-width: 390rpx;
  padding: 15rpx 18rpx;
  border-radius: 17rpx;
}
.hint text { display: block; font-size: 19rpx; line-height: 1.45; }
.hint small { font-size: 15rpx; }

.tray-shaping {
  min-height: calc(92rpx + env(safe-area-inset-bottom));
  padding: 0 22rpx env(safe-area-inset-bottom);
  background: transparent;
  border-radius: 0;
  box-shadow: none;
}
.tray-shaping .tray-bottom {
  height: 92rpx;
  padding: 0;
  border-top: 0;
  justify-content: flex-end;
}
.complete-arrow {
  width: 66rpx;
  min-width: 66rpx;
  height: 66rpx;
  line-height: 66rpx;
  padding: 0;
  border-radius: 22rpx;
  color: rgba(250, 251, 248, .88);
  background: rgba(18, 25, 22, .68);
  border: 1rpx solid rgba(192, 211, 201, .17);
  box-shadow: 0 12rpx 30rpx rgba(4, 8, 6, .16);
  font-size: 29rpx;
  font-weight: 400;
}

.reduce-motion .top-action,
.reduce-motion .circle,
.reduce-motion .form-chip,
.reduce-motion .dock-trigger,
.reduce-motion .choice-item,
.reduce-motion .clay-choice { transition: none; }
.reduce-motion .choice-popover { animation: none; }

@media (max-height: 700px) {
  .gesture-map { top: 8rpx; }
  .form-switcher { top: 172rpx; }
  .material-dock { top: 8rpx; bottom: auto; }
  .ring-band { height: 88rpx; }
  .tray-shaping { min-height: calc(80rpx + env(safe-area-inset-bottom)); }
  .tray-shaping .tray-bottom { height: 80rpx; }
}
