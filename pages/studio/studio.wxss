}
.template-copy text,
.template-copy small {
  display: block;
}
.template-copy text {
  font-family: "Songti SC", serif;
  font-size: 23rpx;
  font-weight: 700;
}
.template-copy small {
  height: 52rpx;
  margin-top: 5rpx;
  overflow: hidden;
  color: #77837c;
  font-size: 15rpx;
  line-height: 1.45;
}
.template-card.active .template-copy small {
  color: rgba(242, 248, 244, 0.72);
}
.template-status {
  align-self: end;
  color: #61786d;
  font-size: 14rpx;
  font-weight: 700;
}
.template-card.active .template-status {
  color: #d7e8df;
}
.custom-builder {
  height: 212rpx;
}
.decor-section-tabs {
  height: 94rpx;
  display: flex;
  gap: 8rpx;
}
.decor-section-tabs > view {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 15rpx;
  color: #6d7772;
  background: #e3e8e3;
  font-size: 18rpx;
  font-weight: 700;
}
.decor-section-tabs > view small {
  color: #8b948f;
  font-size: 13rpx;
}
.decor-section-tabs > view.active {
