  transform: rotate(-24deg);
}
.stage-floor-shadow {
  position: absolute;
  left: 50%;
  top: 55%;
  width: 620rpx;
  height: 240rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(5, 8, 6, 0.42), transparent 69%);
  filter: blur(16rpx);
}
.vignette {
  background:
    linear-gradient(
      180deg,
      rgba(7, 10, 8, 0.08),
      transparent 16%,
      transparent 72%,
      rgba(5, 7, 6, 0.3)
    ),
    radial-gradient(
      ellipse at 51% 38%,
      transparent 32%,
      rgba(7, 10, 8, 0.5) 100%
    );
}
/* 舞台区：顶栏与精简底栏之间的全部可视区域，flex 自适应高度。 */
.stage-area {
  position: relative;
  flex: 1;
  min-height: 0;
  z-index: 1;
}
.pottery-spotlight {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 5%;
  width: 520rpx;
  height: 690rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    ellipse at 43% 40%,
    rgba(241, 225, 197, 0.22),
    rgba(170, 184, 175, 0.07) 48%,
    transparent 73%
  );
  pointer-events: none;
}
.canvas {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  /* 陶坯位于转盘之上，低角度环看时底面不会再被 CSS 转盘遮住。 */
  z-index: 4;
}
.fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 4;
  pointer-events: auto;
}
/* 转盘完整收在舞台内，底缘与精简底栏保持恒定间距。 */
.wheel-root {
  position: absolute;
  z-index: 3;
  left: 50%;
  bottom: 24px;
  width: 590rpx;
  height: 122rpx;
  transform: translateX(-50%);
  pointer-events: none;
}
.wheel-contact-anchor {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 2rpx;
  opacity: 0;
  transform: translate(-50%, -50%);
}
.wheel-head {
  position: absolute;
  z-index: 2;
  left: 0;
  top: 0;
  width: 590rpx;
  height: 122rpx;
  overflow: hidden;
  border-radius: 50%;
  background: linear-gradient(180deg, #b9bbb4 0%, #7f8580 52%, #515b56 100%);
  border: 2rpx solid rgba(231, 234, 225, 0.38);
  box-shadow:
    inset 0 10rpx 14rpx rgba(247, 244, 231, 0.3),
    inset 0 -22rpx 24rpx rgba(25, 33, 29, 0.42),
    0 24rpx 34rpx rgba(4, 8, 6, 0.38);
}
.wheel-head-spin {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 590rpx;
  height: 590rpx;
  border-radius: 50%;
  background-color: #92968f;
  background-image: conic-gradient(
    from 16deg,
    rgba(244, 240, 225, 0.26),
    rgba(58, 68, 62, 0.08) 22%,
    rgba(229, 225, 211, 0.16) 49%,
    rgba(44, 55, 49, 0.15) 75%,
    rgba(244, 240, 225, 0.26)
  );
  transform-origin: center;
  animation: wheel-turn var(--wheel-period) linear infinite;
  will-change: transform;
}
.wheel-paused .wheel-head-spin {
  animation-play-state: paused;
}
.machined-rings {
  position: absolute;
  inset: 16rpx;
  border-radius: 50%;
  background: repeating-radial-gradient(
    circle,
    transparent 0,
    transparent 31rpx,
    rgba(38, 48, 43, 0.2) 33rpx,
    rgba(242, 239, 225, 0.11) 35rpx,
    transparent 38rpx
  );
}
.slip-mark {
  position: absolute;
  left: 82rpx;
  top: 72rpx;
  width: 410rpx;
  height: 410rpx;
  border-radius: 50%;
  border-top: 16rpx solid rgba(107, 88, 72, 0.2);
  border-right: 8rpx solid transparent;
  transform: rotate(17deg);
}
.wheel-glint {
  position: absolute;
  left: 132rpx;
  top: 82rpx;
  width: 250rpx;
  height: 92rpx;
  border-radius: 50%;
  border-top: 8rpx solid rgba(248, 244, 226, 0.13);
  transform: rotate(-12deg);
}
.contact-shadow {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: calc(50% - 24rpx);
  width: var(--contact-shadow-width);
  height: 48rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    ellipse,
    rgba(5, 8, 7, 0.62),
    rgba(5, 8, 7, 0) 72%
  );
}
@keyframes wheel-turn {
  from {
    transform: translate(-50%, -50%) scaleY(0.207) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) scaleY(0.207) rotate(360deg);
  }
}
.gesture-map {
  position: absolute;
  z-index: 5;
  top: 120rpx;
  right: 22rpx;
  width: 174rpx;
  padding: 15rpx 13rpx 13rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  color: rgba(241, 240, 229, 0.62);
  background:
    linear-gradient(145deg, rgba(49, 62, 56, 0.88), rgba(20, 27, 24, 0.82)),
    rgba(20, 27, 24, 0.8);
  border: 1rpx solid rgba(183, 207, 194, 0.18);
  box-shadow:
    inset 0 1rpx 0 rgba(245, 241, 224, 0.08),
    0 16rpx 36rpx rgba(4, 8, 6, 0.2);
  backdrop-filter: blur(10rpx);
  pointer-events: none;
}
.gesture-map-title {
  padding: 0 4rpx 9rpx;
  color: rgba(214, 228, 219, 0.72);
  font-size: 16rpx;
  letter-spacing: 0.18em;
}
.gesture-row {
  height: 45rpx;
  display: flex;
  align-items: center;
  border-radius: 11rpx;
}
.gesture-row .arrow-pair,
.gesture-row .arrow-single {
  width: 68rpx;
  text-align: center;
  color: #92b9a8;
  font-family: "Songti SC", serif;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1;
}
.gesture-row .arrow-single {
  font-size: 31rpx;
}
.gesture-row text {
  font-size: 17rpx;
  white-space: nowrap;
}
.gesture-camera {
  margin-top: 9rpx;
  padding-top: 11rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border-top: 1rpx solid rgba(211, 226, 217, 0.12);
  color: rgba(211, 226, 217, 0.56);
}
.gesture-camera text {
  font-size: 15rpx;
  white-space: nowrap;
}
.finger-pair {
  width: 38rpx;
  height: 26rpx;
  position: relative;
  flex: none;
}
.finger-pair view {
  position: absolute;
  bottom: 0;
  width: 11rpx;
  height: 25rpx;
  border: 2rpx solid #8fb4a3;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  box-sizing: border-box;
}
.finger-pair view:first-child {
