  transform: rotate(-8deg);
}
.finger-pair view:last-child {
  right: 5rpx;
  height: 21rpx;
  transform: rotate(9deg);
}
.topbar {
  position: relative;
  flex: none;
  z-index: 5;
  height: 94rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  color: #f5f7f2;
}
.top-button,
.circle {
  background: rgba(23, 28, 26, 0.78);
  border: 1rpx solid rgba(170, 184, 175, 0.16);
  color: #f5f7f2;
  height: 64rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
}
.top-button {
  position: absolute;
  left: 22rpx;
  width: 84rpx;
  min-width: 0;
  flex: 0 0 84rpx;
  margin: 0 !important;
}
.work-title {
  flex: none;
  text-align: left;
  pointer-events: none;
}
.topbar {
  height: 100rpx;
}
.top-action,
.circle {
  height: 88rpx;
  min-width: 88rpx;
}
.circle {
  width: 88rpx;
  flex-basis: 88rpx;
}
.work-title view {
  font-size: 28rpx;
}
.work-title text {
  font-size: 18rpx;
  color: #e7bf6c;
}
.work-title text.saved {
  color: #c7d9d0;
}
.top-actions {
  flex: none;
  display: flex;
  gap: 8rpx;
}
.circle {
  width: 62rpx;
  min-width: 0;
  flex: 0 0 62rpx;
  margin: 0 !important;
}
.circle.disabled {
  opacity: 0.38;
}
.stage-label {
  position: absolute;
  z-index: 4;
  top: 16rpx;
  left: 30rpx;
  color: #f5f7f2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}
.stage-label .eyebrow {
  color: #d5e4dc;
}
.stage-label .display {
  font-size: 44rpx;
  margin-top: 6rpx;
}
.hint {
  position: absolute;
  z-index: 12;
  top: 96rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  max-width: 360rpx;
  box-shadow: 0 14rpx 34rpx rgba(9, 12, 11, 0.18);
}
.teacher-mark {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #52796a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-family: "Songti SC", serif;
}
.hint text {
  font-size: 22rpx;
}
.hint small {
  display: block;
  font-size: 18rpx;
  color: #78847d;
  margin-top: 5rpx;
}
.stage-footer {
  position: relative;
  z-index: 6;
  flex: none;
  width: 100%;
  height: calc(84rpx + env(safe-area-inset-bottom));
  padding: 0 12rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
}
.stage-footer-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  color: rgba(246, 248, 244, 0.92);
  font-family: "Songti SC", "STSong", serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-indent: 0.14em;
  text-align: center;
  white-space: nowrap;
}

/* 工序底栏（装饰页以外各工序共用）：与装饰页底部同构 —— 左「上一步」· 中状态 · 右主按钮。
   按钮用 view 实现，宽度紧贴内容，绝不挤压中间文案。 */
.stagebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.stagebar-prev {
  flex: none;
  height: 56rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 1rpx solid rgba(57, 83, 76, 0.18);
  border-radius: 999rpx;
  color: #45635c;
  background: rgba(247, 247, 238, 0.62);
  font-family: "Songti SC", "STSong", serif;
  font-size: 16rpx;
  line-height: 1;
  white-space: nowrap;
  transition:
    transform 0.15s ease,
    background 0.15s ease;
}
.stagebar-prev view {
  font-size: 17rpx;
  line-height: 1;
}
.stagebar-prev:active {
  transform: scale(0.96);
  background: rgba(247, 247, 238, 0.85);
}
.stagebar-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #71817b;
  font-size: 14rpx;
  text-align: center;
  white-space: nowrap;
}
.stagebar-next {
  flex: none;
  height: 60rpx;
  padding: 0 8rpx 0 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 999rpx;
  color: #f8f6e9;
  background: linear-gradient(145deg, #315d54, #1d403b);
  box-shadow:
    0 8rpx 20rpx rgba(14, 48, 41, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  font-family: "Songti SC", "STSong", serif;
  font-size: 17rpx;
  line-height: 1;
  letter-spacing: 0.08em;
  white-space: nowrap;
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;
}
.stagebar-next view {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  font-size: 20rpx;
  line-height: 44rpx;
  text-align: center;
}
.stagebar-next:active {
  transform: scale(0.97);
}
.reduce-motion .stagebar-prev,
.reduce-motion .stagebar-next {
  transition: none;
}
@media (max-height: 700px) {
  .stagebar-prev {
    height: 50rpx;
  }
  .stagebar-next {
    height: 54rpx;
  }
  .stagebar-next view {
    width: 38rpx;
    height: 38rpx;
    font-size: 18rpx;
    line-height: 38rpx;
  }
}
.tray {
  position: relative;
  flex: none;
  z-index: 6;
  width: 100%;
  min-height: 318rpx;
  padding: 24rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f7f2;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -20rpx 50rpx rgba(32, 40, 34, 0.18);
}
.shaping-console {
  height: 178rpx;
}
.shaping-console-head {
  height: 54rpx;
  padding: 0 4rpx 8rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
}
.shaping-console-head > view:first-child > text {
  display: block;
  color: #26332d;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
}
.shaping-console-head small {
  display: block;
  margin-top: 2rpx;
  color: #78827d;
  font-size: 16rpx;
}
.shaping-badge {
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 15rpx;
  border-radius: 18rpx;
  color: #456758;
  background: #e2ebe5;
  font-size: 16rpx;
  letter-spacing: 0.08em;
}
.shape-mode-row {
  height: 116rpx;
  display: flex;
  gap: 12rpx;
}
.shape-mode {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 108rpx;
  padding: 10rpx 8rpx 9rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: #53615a;
  background: #e8ede9;
  border: 2rpx solid transparent;
  transition:
    transform 120ms ease,
    background 120ms ease,
    border-color 120ms ease;
}
.shape-mode.active {
  color: #f7f8f3;
  background: linear-gradient(145deg, #648b79, #456a5b);
  border-color: #315448;
  box-shadow: 0 9rpx 20rpx rgba(49, 84, 72, 0.2);
  transform: translateY(-3rpx);
}
.form-glyph {
  position: relative;
  width: 52rpx;
  height: 54rpx;
  flex: none;
  color: #799286;
}
.shape-mode.active .form-glyph {
  color: #e9f2ed;
}
.glyph-curve:before,
.glyph-cone:before,
.glyph-square:before {
  content: "";
  position: absolute;
  box-sizing: border-box;
}
.glyph-curve:before {
  left: 6rpx;
  bottom: 9rpx;
  width: 40rpx;
  height: 31rpx;
  border: 5rpx solid currentColor;
  border-bottom: 0;
  border-radius: 26rpx 26rpx 0 0;
}
.glyph-cone:before {
  left: 5rpx;
  top: 7rpx;
  width: 42rpx;
  height: 42rpx;
  background: currentColor;
  clip-path: polygon(50% 0, 100% 100%, 84% 100%, 50% 23%, 16% 100%, 0 100%);
}
.glyph-square:before {
  left: 6rpx;
  bottom: 8rpx;
  width: 40rpx;
  height: 37rpx;
  border: 5rpx solid currentColor;
  border-bottom: 0;
}
.shape-copy {
  min-width: 0;
}
.shape-copy text,
.shape-copy small {
  display: block;
  white-space: nowrap;
}
.shape-copy text {
  font-size: 21rpx;
  font-weight: 700;
}
.shape-copy small {
  margin-top: 4rpx;
  color: #7a8780;
  font-size: 14rpx;
}
.shape-mode.active .shape-copy small {
  color: rgba(239, 246, 242, 0.72);
}
.tool-scroll {
  width: 100%;
}
.tool-row {
  display: flex;
  gap: 18rpx;
  padding: 3rpx 4rpx 20rpx;
}
.tool {
  width: 104rpx;
  flex: none;
  text-align: center;
  color: #66716b;
}
.tool view {
  width: 86rpx;
  height: 86rpx;
  margin: auto;
  border-radius: 26rpx;
  background: #e2e8e3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 31rpx;
  border: 2rpx solid transparent;
}
.tool text {
  font-size: 20rpx;
  display: block;
  margin-top: 9rpx;
}
.tool.active view {
  background: #52796a;
  color: #fff;
  border-color: #385c4f;
}
.tool.active text {
  color: #202822;
  font-weight: 700;
}
.paint-row {
  height: 80rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 0 6rpx 16rpx;
}
.paint-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx #d9dfda;
}
.symmetry {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 22rpx;
  background: #e2e8e3;
  font-size: 21rpx;
  color: #384940;
  margin-left: auto;
}
.tray-bottom {
  height: 94rpx;
  border-top: 1rpx solid rgba(32, 40, 34, 0.09);
  padding-top: 15rpx;
}
/* 浅色工具盘内的「上一步」需要更实的底色保证对比度 */
.tray-bottom .stagebar-prev {
  background: #e9eee9;
}
.tray-bottom .stagebar-prev:active {
  background: #dfe7e0;
}
.reset {
  height: 70rpx;
  line-height: 70rpx;
  width: 146rpx;
  background: #e3e8e3;
  color: #46524c;
  font-size: 21rpx;
}
.tool-hint {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 16rpx;
  color: #66716b;
  text-align: center;
  white-space: nowrap;
}
.reduce-motion .shape-mode {
  transition: none;
}
.fallback-pot {
  position: absolute;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent));
  transform: translateX(-50%);
  width: 250rpx;
  height: 320rpx;
  clip-path: polygon(
    27% 0,
    73% 0,
    80% 16%,
    70% 40%,
    87% 70%,
    84% 100%,
    16% 100%,
    13% 70%,
    30% 40%,
    20% 16%
  );
  border-radius: 40%;
  box-shadow:
    inset 30rpx 0 30rpx rgba(255, 255, 255, 0.34),
    15rpx 28rpx 30rpx rgba(0, 0, 0, 0.25);
  background: #c7c2b6;
}
.fallback-pot.stage-1 {
  background:
    radial-gradient(
      ellipse at 31% 24%,
      rgba(255, 255, 247, 0.88) 0 5%,
      rgba(236, 248, 240, 0.42) 18%,
      transparent 42%
    ),
    linear-gradient(
      104deg,
      #8fa99c 0%,
      #c6d8ce 25%,
      #e5eee5 48%,
      #b9cec2 72%,
      #7f998e 100%
    );
  box-shadow:
    inset 34rpx 0 34rpx rgba(244, 255, 248, 0.5),
    inset -25rpx 0 32rpx rgba(43, 73, 64, 0.2),
    inset 0 -20rpx 25rpx rgba(68, 95, 86, 0.12),
    15rpx 28rpx 30rpx rgba(0, 0, 0, 0.25);
}
.fallback-pot.stage-3,
.fallback-pot.stage-4,
.fallback-pot.stage-5,
.fallback-pot.stage-6 {
  background: #84a99a;
}
.fallback-note {
  position: absolute;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent) - 54rpx);
  transform: translateX(-50%);
  color: #fff;
  font-size: 22rpx;
}
/* 窑烧全屏：背景、真实 WebGL 器物、信息层三层分离，器物始终是视觉中心。 */
.kiln-backdrop {
  position: absolute;
  z-index: 20;
  inset: 0;
  overflow: hidden;
  background: #1c0b05;
}
.kiln-background-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  transform: scale(1.015);
  animation: kiln-breathe 8s ease-in-out infinite alternate;
}
.kiln-background-grade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(8, 3, 1, 0.28), transparent 24%, transparent 65%, rgba(8, 2, 0, 0.58)),
    radial-gradient(ellipse at 50% 48%, transparent 12%, rgba(13, 4, 1, 0.12) 54%, rgba(6, 2, 0, 0.48) 100%);
}
.kiln-low .kiln-background-grade {
  background:
    linear-gradient(180deg, rgba(25, 12, 5, 0.2), transparent 28%, transparent 65%, rgba(19, 7, 2, 0.55)),
    radial-gradient(ellipse at 50% 45%, rgba(255, 169, 85, 0.08), transparent 40%, rgba(18, 7, 2, 0.35) 100%);
}
.kiln-heat-haze {
  position: absolute;
  left: 50%;
  top: 39%;
  width: 560rpx;
  height: 620rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255, 121, 36, 0.45), rgba(214, 47, 13, 0.12) 46%, transparent 74%);
  filter: blur(32rpx);
  animation: kiln-haze 2.8s ease-in-out infinite alternate;
}
.kiln-low .kiln-heat-haze {
  background: radial-gradient(ellipse, rgba(255, 179, 91, 0.34), rgba(207, 88, 31, 0.08) 48%, transparent 74%);
}
.kiln-vessel-aura {
  position: absolute;
  left: 50%;
  top: 46%;
  width: 440rpx;
  height: 560rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  opacity: 0.46;
  background: radial-gradient(ellipse, rgba(255, 206, 132, 0.34), rgba(244, 77, 24, 0.08) 48%, transparent 72%);
  filter: blur(18rpx);
  transition: opacity 0.45s ease, background 0.45s ease;
}
.kiln-vessel-aura.heat-red,
.kiln-vessel-aura.heat-hot {
  opacity: 0.88;
  background: radial-gradient(ellipse, rgba(255, 224, 167, 0.54), rgba(255, 62, 17, 0.22) 48%, transparent 74%);
}
.kiln-embers {
  position: absolute;
  inset: 16% 8% 24%;
  opacity: 0.8;
}
.kiln-low .kiln-embers { opacity: 0.28; }
.kiln-embers view {
  position: absolute;
  left: 18%;
  bottom: 4%;
  width: 5rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #ffd28a;
  box-shadow: 0 0 14rpx rgba(255, 88, 22, 0.95);
  animation: kiln-ember-rise 4.8s linear infinite;
}
.kiln-embers view:nth-child(2) { left: 34%; bottom: 1%; animation-delay: -1.4s; animation-duration: 5.6s; }
.kiln-embers view:nth-child(3) { left: 66%; bottom: 8%; animation-delay: -3.2s; animation-duration: 4.2s; }
.kiln-embers view:nth-child(4) { left: 79%; bottom: 2%; animation-delay: -2.1s; animation-duration: 6.2s; }
.kiln-embers view:nth-child(5) { left: 52%; bottom: 0; animation-delay: -4.4s; animation-duration: 5.1s; }

.kiln-active .safe-top,
.kiln-active .topbar,
.kiln-active > .tray,
.kiln-active > .stage-footer,
.kiln-active > .decor-tray,
.kiln-active > .glaze-tray {
  visibility: hidden;
  pointer-events: none;
}
.kiln-active .stage-area {
  position: absolute;
  z-index: 22;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.kiln-active .canvas,
.kiln-active .fallback { pointer-events: none; }
.kiln-active .wheel-root,
.kiln-active .decor-tool-panel,
.kiln-active .fallback-note,
.kiln-active .fallback-decor,
.kiln-active .fallback-inscription { display: none; }
.kiln-active .pottery-spotlight {
  left: 50%;
  top: 16%;
  width: 560rpx;
  height: 720rpx;
  opacity: 0.62;
  background: radial-gradient(ellipse, rgba(255, 191, 107, 0.24), rgba(255, 73, 20, 0.07) 52%, transparent 74%);
}
.kiln-active .fallback-pot {
  top: 47%;
  bottom: auto;
  width: 270rpx;
  height: 350rpx;
  transform: translate(-50%, -50%);
  transition: filter 0.55s ease, box-shadow 0.55s ease;
}
.kiln-active .fallback-pot.kiln-yellow { filter: sepia(0.8) saturate(1.7) brightness(1.15); }
.kiln-active .fallback-pot.kiln-orange { filter: sepia(1) saturate(2.7) hue-rotate(-12deg) brightness(1.12); }
.kiln-active .fallback-pot.kiln-red { filter: sepia(1) saturate(4.4) hue-rotate(-24deg) brightness(0.98); }
.kiln-active .fallback-pot.kiln-hot {
  filter: sepia(1) saturate(5) hue-rotate(-22deg) brightness(1.24);
  box-shadow: inset 30rpx 0 30rpx rgba(255, 240, 190, 0.36), 0 0 65rpx rgba(255, 58, 14, 0.7);
}

.kiln-hud {
  position: absolute;
  z-index: 24;
  inset: 0;
  color: #fff4df;
  pointer-events: none;
}
.kiln-heading {
  position: absolute;
  left: 28rpx;
  display: grid;
  grid-template-columns: 42rpx auto 54rpx;
  align-items: center;
  gap: 17rpx;
  text-shadow: 0 3rpx 14rpx rgba(20, 3, 0, 0.7);
}
.kiln-title-rule {
  width: 42rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 225, 180, 0.74));
}
.kiln-title-copy small,
.kiln-title-copy text { display: block; }
.kiln-title-copy small {
  margin-bottom: 5rpx;
  color: rgba(255, 224, 181, 0.68);
  font-size: 17rpx;
  letter-spacing: 0.28em;
}
.kiln-title-copy text {
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0.18em;
}
.kiln-seal {
  width: 50rpx;
  height: 50rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 224, 187, 0.72);
  color: #fff0d2;
  background: rgba(128, 28, 13, 0.58);
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 25rpx;
  line-height: 46rpx;
  text-align: center;
  box-shadow: inset 0 0 0 3rpx rgba(79, 13, 6, 0.25), 0 5rpx 18rpx rgba(35, 4, 0, 0.32);
}
.kiln-low .kiln-seal { background: rgba(139, 66, 35, 0.48); }

.kiln-status-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(105rpx + env(safe-area-inset-bottom));
  padding: 20rpx 22rpx 17rpx;
  border: 1rpx solid rgba(255, 222, 179, 0.22);
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(42, 10, 4, 0.7), rgba(22, 5, 2, 0.48));
  box-shadow: inset 0 1rpx rgba(255, 239, 213, 0.1), 0 12rpx 36rpx rgba(12, 2, 0, 0.32);
  backdrop-filter: blur(14rpx);
}
.kiln-low .kiln-status-panel {
  background: linear-gradient(135deg, rgba(65, 28, 12, 0.62), rgba(31, 12, 5, 0.44));
}
.kiln-status-line {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}
.kiln-status-line > view:first-child { min-width: 0; }
.kiln-status-line > view:first-child small,
.kiln-status-line > view:first-child text { display: block; }
.kiln-status-line > view:first-child small {
  margin-bottom: 5rpx;
  color: rgba(255, 220, 171, 0.58);
  font-size: 15rpx;
  letter-spacing: 0.24em;
}
.kiln-status-line > view:first-child text {
  overflow: hidden;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  letter-spacing: 0.08em;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.kiln-temperature {
  flex: none;
  color: #ffdca7;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.kiln-temperature text { font-size: 42rpx; line-height: 1; }
.kiln-temperature small { color: rgba(255, 226, 187, 0.6); font-size: 17rpx; }
.kiln-progress {
  position: relative;
  height: 8rpx;
  margin-top: 19rpx;
  overflow: visible;
  border-radius: 999rpx;
  background: rgba(255, 224, 184, 0.16);
  box-shadow: inset 0 1rpx 3rpx rgba(14, 2, 0, 0.4);
}
.kiln-progress-fill {
  position: relative;
  height: 100%;
  min-width: 2rpx;
  border-radius: inherit;
  background: linear-gradient(90deg, #a83a1c, #f0782e 54%, #ffd18a);
  box-shadow: 0 0 15rpx rgba(255, 92, 24, 0.65);
  transition: width 0.14s linear;
}
.kiln-low .kiln-progress-fill {
  background: linear-gradient(90deg, #9d512f, #e68b4a 58%, #ffe0a6);
}
.kiln-progress-ember {
  position: absolute;
  right: -7rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  transform: translateY(-50%);
  border-radius: 50%;
  background: #fff1c9;
  box-shadow: 0 0 0 5rpx rgba(255, 134, 53, 0.18), 0 0 20rpx #ff6927;
}
.kiln-scale {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  color: rgba(255, 226, 187, 0.48);
  font-size: 14rpx;
  letter-spacing: 0.12em;
}
.kiln-skip {
  position: absolute;
  right: 24rpx;
  bottom: calc(23rpx + env(safe-area-inset-bottom));
  width: 148rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 9rpx 0 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 229, 194, 0.42);
  border-radius: 999rpx;
  color: #fff1d8;
  background: rgba(47, 11, 5, 0.56);
  box-shadow: inset 0 1rpx rgba(255, 242, 218, 0.12), 0 8rpx 24rpx rgba(18, 3, 0, 0.32);
  backdrop-filter: blur(12rpx);
  font-family: "Songti SC", "STSong", serif;
  font-size: 21rpx;
  letter-spacing: 0.16em;
  line-height: 60rpx;
  pointer-events: auto;
  transition: transform 0.15s ease, background 0.15s ease;
}
.kiln-skip::after { border: 0; }
.kiln-skip:active { transform: scale(0.96); background: rgba(92, 26, 11, 0.72); }
.kiln-skip view {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: #6f2818;
  background: #f6d5a8;
  font-family: sans-serif;
  font-size: 19rpx;
  line-height: 36rpx;
  text-align: center;
  text-indent: 0;
}

@keyframes kiln-breathe {
  from { transform: scale(1.015); filter: brightness(0.94) saturate(0.96); }
  to { transform: scale(1.04); filter: brightness(1.08) saturate(1.08); }
}
@keyframes kiln-haze {
  from { transform: translate(-50%, -50%) scale(0.94); }
  to { transform: translate(-50%, -50%) scale(1.05); }
}
@keyframes kiln-ember-rise {
  0% { opacity: 0; transform: translate3d(0, 30rpx, 0) scale(0.6); }
  16% { opacity: 0.95; }
  100% { opacity: 0; transform: translate3d(34rpx, -500rpx, 0) scale(0.15); }
}
.reduce-motion .kiln-background-image,
.reduce-motion .kiln-heat-haze,
.reduce-motion .kiln-embers view { animation: none; }
.reduce-motion .kiln-vessel-aura,
.reduce-motion .kiln-progress-fill,
.reduce-motion .kiln-active .fallback-pot,
.reduce-motion .kiln-skip { transition: none; }

@media (max-height: 700px) {
  .kiln-active .pottery-spotlight { top: 11%; height: 600rpx; }
  .kiln-vessel-aura { top: 43%; height: 470rpx; }
  .kiln-status-panel { bottom: calc(91rpx + env(safe-area-inset-bottom)); padding-top: 15rpx; }
  .kiln-temperature text { font-size: 36rpx; }
  .kiln-title-copy text { font-size: 31rpx; }
  .kiln-skip { bottom: calc(16rpx + env(safe-area-inset-bottom)); height: 56rpx; line-height: 54rpx; }
}

/* 制坯工作台：把操作收进四角，让陶坯成为视觉中心。 */
.topbar {
  height: 82rpx;
  padding: 0 20rpx;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.top-action,
.circle {
  height: 56rpx;
  min-width: 56rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(245, 247, 242, 0.82);
  background: rgba(18, 25, 22, 0.52);
  border: 1rpx solid rgba(188, 207, 197, 0.14);
  backdrop-filter: blur(12rpx);
  font-size: 19rpx;
  transition:
    transform 140ms ease,
    background 140ms ease,
    opacity 140ms ease;
}
.top-action {
  padding: 0 16rpx;
}
.top-reset {
  color: rgba(225, 235, 229, 0.62);
  background: rgba(18, 25, 22, 0.34);
}
.circle {
  width: 56rpx;
  flex: 0 0 56rpx;
}
.top-action:active,
.circle:active {
  transform: scale(0.94);
  background: rgba(80, 112, 97, 0.58);
}

.gesture-map {
  top: 14rpx;
  right: 20rpx;
  width: 150rpx;
  padding: 11rpx 11rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(20, 28, 24, 0.68);
  box-shadow: 0 12rpx 28rpx rgba(4, 8, 6, 0.14);
}
.gesture-map-title {
  padding: 0 3rpx 5rpx;
  font-size: 14rpx;
}
.gesture-row {
  height: 34rpx;
}
.gesture-row .arrow-pair,
.gesture-row .arrow-single {
  width: 58rpx;
  font-size: 22rpx;
}
.gesture-row text {
  font-size: 15rpx;
}
.gesture-camera {
  margin-top: 5rpx;
  padding-top: 7rpx;
  gap: 6rpx;
}
.gesture-camera text {
  font-size: 14rpx;
}
.finger-pair {
  width: 30rpx;
  height: 22rpx;
}
.finger-pair view {
  width: 9rpx;
  height: 21rpx;
}
.finger-pair view:last-child {
  height: 18rpx;
}

.form-switcher {
  position: absolute;
  z-index: 6;
  top: 184rpx;
  right: 20rpx;
  width: 150rpx;
  padding: 7rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  background: rgba(20, 28, 24, 0.48);
  border: 1rpx solid rgba(183, 207, 194, 0.12);
  backdrop-filter: blur(10rpx);
}
.form-chip {
  height: 36rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(226, 235, 229, 0.58);
  font-size: 15rpx;
  letter-spacing: 0.08em;
  transition:
    color 120ms ease,
    background 120ms ease,
    transform 120ms ease;
}
.form-chip.active {
  color: #f3f7f4;
  background: rgba(116, 156, 137, 0.7);
}
.form-chip:active {
  transform: scale(0.96);
}

.material-dock {
  position: absolute;
  z-index: 8;
  left: 20rpx;
  top: 12rpx;
  bottom: auto;
  width: 322rpx;
}
.dock-row {
  display: flex;
  gap: 9rpx;
}
.dock-trigger {
  width: 156rpx;
  height: 62rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 19rpx;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 7rpx;
  color: rgba(239, 243, 239, 0.82);
  background: rgba(20, 28, 24, 0.58);
  border: 1rpx solid rgba(191, 210, 200, 0.14);
  box-shadow: 0 12rpx 28rpx rgba(4, 8, 6, 0.16);
  backdrop-filter: blur(12rpx);
  transition:
    transform 140ms ease,
    background 140ms ease;
}
.dock-trigger > text {
  color: rgba(204, 218, 210, 0.52);
  font-size: 14rpx;
}
.dock-trigger > view {
  overflow: hidden;
  font-size: 17rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dock-trigger small {
  color: #9ab8a9;
  font-size: 23rpx;
  font-weight: 300;
}
.dock-trigger.open {
  background: rgba(65, 94, 80, 0.84);
}
.dock-trigger:active {
  transform: scale(0.97);
}

.choice-popover {
  position: absolute;
  left: 0;
  top: 74rpx;
  bottom: auto;
  width: 322rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  color: #eaf1ed;
  background: rgba(24, 34, 29, 0.94);
  border: 1rpx solid rgba(193, 213, 202, 0.16);
  box-shadow: 0 20rpx 46rpx rgba(3, 7, 5, 0.28);
  backdrop-filter: blur(18rpx);
  animation: dock-open 160ms ease-out both;
}
.choice-title {
  margin: 0 2rpx 12rpx;
  color: rgba(209, 223, 215, 0.58);
  font-size: 14rpx;
  letter-spacing: 0.18em;
}
.choice-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 7rpx;
}
.choice-item {
  height: 52rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(234, 241, 237, 0.66);
  background: rgba(255, 255, 255, 0.055);
  font-size: 18rpx;
  transition:
    transform 120ms ease,
    background 120ms ease;
}
.choice-item.active {
  color: #fff;
  background: #52796a;
  box-shadow: inset 0 0 0 1rpx rgba(223, 239, 230, 0.24);
}
.choice-item:active,
.clay-choice:active {
  transform: scale(0.96);
}
.clay-choice {
  height: 54rpx;
  padding: 0 12rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(235, 241, 237, 0.68);
  font-size: 17rpx;
  transition:
    transform 120ms ease,
    background 120ms ease;
}
.clay-choice.active {
  color: #fff;
  background: rgba(82, 121, 106, 0.66);
}
.clay-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  box-shadow:
    inset -5rpx -5rpx 10rpx rgba(35, 28, 22, 0.15),
    0 0 0 2rpx rgba(255, 255, 255, 0.12);
}

.wall-caliper {
  position: absolute;
  z-index: 7;
  left: 20rpx;
  top: 84rpx;
  width: 300rpx;
  padding: 12rpx 14rpx 10rpx;
  box-sizing: border-box;
  border-radius: 19rpx;
  color: rgba(238, 244, 240, 0.82);
  background: rgba(20, 28, 24, 0.58);
  border: 1rpx solid rgba(191, 210, 200, 0.14);
  box-shadow: 0 12rpx 28rpx rgba(4, 8, 6, 0.16);
  backdrop-filter: blur(12rpx);
  transition:
    background 140ms ease,
    border-color 140ms ease,
    transform 140ms ease;
}
.wall-caliper.active {
  background: rgba(44, 68, 57, 0.86);
  border-color: rgba(174, 211, 192, 0.38);
  transform: translateY(-2rpx);
}
.wall-caliper-head {
  height: 26rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
}
.wall-caliper-head > text {
  font-size: 15rpx;
  letter-spacing: 0.08em;
}
.wall-caliper-head .wall-value {
  margin-left: auto;
  color: #edf5f0;
  font-family: monospace;
  font-size: 16rpx;
  letter-spacing: 0;
}
.wall-state {
  height: 24rpx;
  line-height: 24rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  color: #b9d7c8;
  background: rgba(142, 184, 164, 0.16);
  font-size: 13rpx;
}
.caliper-glyph {
  position: relative;
  width: 26rpx;
  height: 22rpx;
  flex: none;
}
.caliper-glyph view {
  position: absolute;
  top: 3rpx;
  width: 8rpx;
  height: 16rpx;
  border-top: 2rpx solid #9fc4b2;
  border-bottom: 2rpx solid #9fc4b2;
  box-sizing: border-box;
}
.caliper-glyph view:first-child {
  left: 2rpx;
  border-left: 2rpx solid #9fc4b2;
}
.caliper-glyph view:last-child {
  right: 2rpx;
  border-right: 2rpx solid #9fc4b2;
}
.wall-slider-row {
  height: 40rpx;
  display: flex;
  align-items: center;
  gap: 2rpx;
}
.wall-slider-row > text {
  width: 24rpx;
  color: rgba(207, 222, 214, 0.55);
  font-size: 13rpx;
  text-align: center;
}
.wall-slider {
  flex: 1;
  width: 220rpx;
  min-width: 0;
  margin: 0 -5rpx;
}
.wall-link {
  margin-top: -2rpx;
  color: rgba(200, 217, 208, 0.46);
  font-size: 12rpx;
  letter-spacing: 0.05em;
  text-align: center;
}
@keyframes dock-open {
  from {
    opacity: 0;
    transform: translateY(10rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.hint {
  top: 16rpx;
  left: 20rpx;
  max-width: 390rpx;
  padding: 15rpx 18rpx;
  border-radius: 17rpx;
}
.hint text {
  display: block;
  font-size: 19rpx;
  line-height: 1.45;
}
.hint small {
  font-size: 15rpx;
}

.reduce-motion .top-action,
.reduce-motion .circle,
.reduce-motion .form-chip,
.reduce-motion .dock-trigger,
.reduce-motion .choice-item,
.reduce-motion .clay-choice,
.reduce-motion .wall-caliper {
  transition: none;
}
.reduce-motion .choice-popover {
  animation: none;
}

/* 装饰工作台：以一只器形剖面卡作为套版的识别核心，其余控件保持安静。 */
.work-title view {
  color: rgba(247, 249, 245, 0.94);
  font-size: 19rpx;
  font-weight: 700;
}
.work-title text {
  display: block;
  margin-top: 2rpx;
  font-size: 14rpx;
}
.decor-tray,
.paint-tray {
  position: relative;
  z-index: 8;
