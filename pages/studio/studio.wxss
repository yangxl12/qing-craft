.studio {
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #171c1a;
  display: flex;
  flex-direction: column;
}
.workshop-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  background:
    radial-gradient(ellipse at 52% 34%, rgba(170, 184, 175, 0.16), transparent 36%),
    linear-gradient(180deg, #33413b 0%, #2c3732 48%, #202724 72%, #171c1a 100%);
}
.wall-glow {
  position: absolute;
  left: 50%;
  top: 7%;
  width: 610rpx;
  height: 850rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    ellipse,
    rgba(241, 225, 197, 0.19) 0%,
    rgba(170, 184, 175, 0.07) 42%,
    transparent 72%
  );
}
.window-light {
  position: absolute;
  right: 46rpx;
  top: 132rpx;
  width: 154rpx;
  height: 236rpx;
  opacity: 0.2;
  background: linear-gradient(160deg, rgba(170, 184, 175, 0.55), rgba(170, 184, 175, 0.04));
  border: 6rpx solid rgba(27, 34, 31, 0.66);
  transform: skewY(-5deg);
}
.window-light view:first-child,
.window-light view:last-child {
  position: absolute;
  background: rgba(23, 28, 26, 0.65);
}
.window-light view:first-child {
  left: 48%;
  top: 0;
  bottom: 0;
  width: 5rpx;
}
.window-light view:last-child {
  left: 0;
  right: 0;
  top: 48%;
  height: 5rpx;
}
.timber {
  position: absolute;
  background: linear-gradient(90deg, #32271f, #4b392d 48%, #2a231d);
  box-shadow: 0 10rpx 24rpx rgba(10, 13, 12, 0.24);
  opacity: 0.72;
}
.timber-left {
  left: 26rpx;
  top: 0;
  width: 44rpx;
  height: 63%;
}
.timber-top {
  left: 0;
  right: 0;
  top: 76rpx;
  height: 34rpx;
}
.timber-diagonal {
  right: -92rpx;
  top: 40rpx;
  width: 390rpx;
  height: 30rpx;
  transform: rotate(-35deg);
  transform-origin: right center;
  opacity: 0.42;
}
.kiln-arch {
  position: absolute;
  right: -75rpx;
  top: 35%;
  width: 250rpx;
  height: 290rpx;
  border-radius: 126rpx 126rpx 18rpx 18rpx;
  background: #18201d;
  border: 16rpx solid rgba(75, 57, 45, 0.28);
  opacity: 0.58;
}
.kiln-arch view {
  position: absolute;
  inset: 38rpx 46rpx 0;
  border-radius: 90rpx 90rpx 8rpx 8rpx;
  background: linear-gradient(180deg, #101513, #20221e);
}
.pottery-rack {
  position: absolute;
  left: 68rpx;
  top: 244rpx;
  width: 244rpx;
  height: 238rpx;
  opacity: 0.19;
  filter: blur(1rpx);
}
.rack-shelf {
  position: absolute;
  left: 0;
  width: 100%;
  height: 11rpx;
  border-radius: 6rpx;
  background: #6a5140;
  box-shadow: 0 10rpx 18rpx rgba(9, 12, 11, 0.4);
}
.shelf-upper {
  top: 92rpx;
}
.shelf-lower {
  top: 204rpx;
}
.rack-pot {
  position: absolute;
  bottom: 34rpx;
  background: #675446;
  border-radius: 16rpx 16rpx 34rpx 34rpx;
  box-shadow: inset 8rpx 0 12rpx rgba(241, 225, 197, 0.12);
}
.rack-pot:before {
  content: "";
  position: absolute;
  left: 14%;
  right: 14%;
  top: -7rpx;
  height: 13rpx;
  border-radius: 50%;
  border: 4rpx solid #675446;
}
.rack-pot-one {
  left: 14rpx;
  width: 58rpx;
  height: 50rpx;
}
.rack-pot-two {
  left: 93rpx;
  width: 72rpx;
  height: 64rpx;
}
.rack-pot-three {
  right: 14rpx;
  width: 50rpx;
  height: 42rpx;
}
.table-plane {
  position: absolute;
  left: 0;
  right: 0;
  top: 56%;
  bottom: 0;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(75, 57, 45, 0.58), rgba(23, 28, 26, 0.95));
  border-top: 3rpx solid rgba(151, 125, 101, 0.22);
}
.perspective-line {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: linear-gradient(rgba(170, 184, 175, 0.13), transparent 72%);
  transform-origin: top center;
}
.line-left {
  left: 43%;
  transform: rotate(19deg);
}
.line-right {
  right: 43%;
  transform: rotate(-19deg);
}
.vignette {
  position: absolute;
  inset: -2rpx;
  background: radial-gradient(ellipse at 50% 38%, transparent 35%, rgba(10, 14, 12, 0.52) 100%);
  pointer-events: none;
}
/* 舞台区：顶栏与工序带之间的全部可视区域，flex 自适应高度（兼容任意安全区高度） */
.stage-area {
  position: relative;
  flex: 1;
  min-height: 0;
  z-index: 1;
}
.stage-spacer {
  flex: none;
  height: 442rpx;
}
.pottery-spotlight {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 5%;
  width: 520rpx;
  height: 690rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    ellipse at 43% 40%,
    rgba(241, 225, 197, 0.22),
    rgba(170, 184, 175, 0.07) 48%,
    transparent 73%
  );
  pointer-events: none;
}
.canvas {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  z-index: 2;
}
.fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  pointer-events: auto;
}
/* 页面和 WebGL 共用 72%-75% 的响应式器底接触线。 */
.wheel-root {
  position: absolute;
  left: 50%;
  margin-left: -340rpx;
  width: 680rpx;
  height: 194rpx;
  pointer-events: none;
}
.splash-pan-back {
  position: absolute;
  z-index: 1;
  left: 0;
  top: -30rpx;
  width: 680rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #46514c, #29322e 72%);
  border: 3rpx solid rgba(170, 184, 175, 0.18);
  box-shadow: 0 28rpx 42rpx rgba(4, 7, 6, 0.42);
}
.wheel-head {
  position: absolute;
  z-index: 1;
  left: 80rpx;
  top: 0;
  width: 520rpx;
  height: 138rpx;
  overflow: hidden;
  border-radius: 50%;
  background: linear-gradient(180deg, #b2aea5, #767a76 58%, #5d625e);
  border: 3rpx solid rgba(225, 225, 215, 0.36);
  box-shadow:
    inset 0 11rpx 16rpx rgba(244, 239, 225, 0.26),
    inset 0 -14rpx 20rpx rgba(38, 43, 40, 0.3);
}
.wheel-head-spin {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background-color: #92928b;
  background-image: conic-gradient(
    from 12deg,
    rgba(238, 235, 224, 0.22),
    rgba(75, 80, 76, 0.08) 24%,
    rgba(236, 230, 214, 0.13) 51%,
    rgba(61, 68, 64, 0.14) 76%,
    rgba(238, 235, 224, 0.22)
  );
  transform-origin: center;
  animation: wheel-turn var(--wheel-period) linear infinite;
  will-change: transform;
}
.wheel-paused .wheel-head-spin {
  animation-play-state: paused;
}
.machined-rings {
  position: absolute;
  inset: 13rpx;
  border-radius: 50%;
  background: repeating-radial-gradient(
    circle,
    transparent 0,
    transparent 27rpx,
    rgba(48, 53, 50, 0.18) 29rpx,
    rgba(239, 236, 225, 0.1) 31rpx,
    transparent 34rpx
  );
}
.bat-pin {
  position: absolute;
  top: 252rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4a504d;
  box-shadow: inset 2rpx 2rpx 3rpx rgba(0, 0, 0, 0.5), 0 0 0 3rpx rgba(225, 225, 215, 0.11);
}
.pin-left {
  left: 82rpx;
}
.pin-right {
  right: 82rpx;
}
.slip-mark {
  position: absolute;
  left: 76rpx;
  top: 56rpx;
  width: 350rpx;
  height: 350rpx;
  border-radius: 50%;
  border-top: 18rpx solid rgba(103, 84, 70, 0.18);
  border-right: 8rpx solid transparent;
  transform: rotate(17deg);
}
.contact-shadow {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: -10rpx;
  width: var(--contact-shadow-width);
  height: 52rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(7, 10, 9, 0.53), rgba(7, 10, 9, 0) 72%);
}
.spindle-band {
  position: absolute;
  z-index: 3;
  left: 126rpx;
  top: 112rpx;
  width: 428rpx;
  height: 58rpx;
  border-radius: 0 0 50% 50%;
  background: linear-gradient(180deg, #5e6460, #2b332f 78%);
  box-shadow: 0 22rpx 28rpx rgba(5, 8, 7, 0.42);
}
.splash-pan-front {
  position: absolute;
  z-index: 3;
  left: 0;
  top: 72rpx;
  width: 680rpx;
  height: 104rpx;
  border-radius: 0 0 50% 50%;
  background: linear-gradient(180deg, rgba(57, 68, 63, 0.94), #26302c 75%);
  border-top: 5rpx solid rgba(170, 184, 175, 0.2);
  box-shadow: inset 0 12rpx 18rpx rgba(180, 188, 181, 0.08);
}
@keyframes wheel-turn {
  from {
    transform: translate(-50%, -50%) scaleY(0.265) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) scaleY(0.265) rotate(360deg);
  }
}
.topbar {
  position: relative;
  z-index: 5;
  height: 94rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #f5f7f2;
}
.top-button,
.circle {
  background: rgba(23, 28, 26, 0.78);
  border: 1rpx solid rgba(170, 184, 175, 0.16);
  color: #f5f7f2;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 23rpx;
}
.top-button {
  width: 84rpx;
}
.work-title {
  text-align: center;
}
.work-title view {
  font-size: 28rpx;
}
.work-title text {
  font-size: 18rpx;
  color: #e7bf6c;
}
.work-title text.saved {
  color: #c7d9d0;
}
.top-actions {
  display: flex;
  gap: 8rpx;
}
.circle {
  width: 62rpx;
}
.circle[disabled] {
  opacity: 0.38;
}
.stage-label {
  position: absolute;
  z-index: 4;
  top: 16rpx;
  left: 30rpx;
  color: #f5f7f2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
}
.stage-label .eyebrow {
  color: #d5e4dc;
}
.stage-label .display {
  font-size: 44rpx;
  margin-top: 6rpx;
}
.hint {
  position: absolute;
  z-index: 7;
  top: 96rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  max-width: 360rpx;
  box-shadow: 0 14rpx 34rpx rgba(9, 12, 11, 0.18);
}
.teacher-mark {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #52796a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-family: "Songti SC", serif;
}
.hint text {
  font-size: 22rpx;
}
.hint small {
  display: block;
  font-size: 18rpx;
  color: #78847d;
  margin-top: 5rpx;
}
.sponge-guide {
  position: absolute;
  z-index: 7;
  right: 58rpx;
  top: 36%;
  color: rgba(241, 225, 197, 0.74);
  font-size: 18rpx;
  letter-spacing: 3rpx;
  text-align: center;
  pointer-events: none;
}
.sponge-guide view {
  position: relative;
  width: 2rpx;
  height: 118rpx;
  margin: 0 auto 10rpx;
  background: linear-gradient(
    transparent,
    rgba(241, 225, 197, 0.72) 24%,
    rgba(241, 225, 197, 0.72) 76%,
    transparent
  );
}
.sponge-guide view:before,
.sponge-guide view:after {
  content: "";
  position: absolute;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  border-left: 2rpx solid rgba(241, 225, 197, 0.72);
  border-top: 2rpx solid rgba(241, 225, 197, 0.72);
}
.sponge-guide view:before {
  top: 0;
  transform: translateX(-50%) rotate(45deg);
}
.sponge-guide view:after {
  top: 108rpx;
  transform: translateX(-50%) rotate(225deg);
}
.ring-band {
  position: absolute;
  z-index: 4;
  left: 28rpx;
  right: 28rpx;
  bottom: 348rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ring-band:before {
  content: "";
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 31rpx;
  border-top: 2rpx solid rgba(245, 247, 242, 0.4);
}
.ring-step {
  position: relative;
  text-align: center;
  color: rgba(245, 247, 242, 0.68);
  width: 86rpx;
}
.ring-step view {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #444942;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  margin: 0 auto;
  font-size: 20rpx;
}
.ring-step text {
  font-size: 17rpx;
  display: block;
  margin-top: 7rpx;
  white-space: nowrap;
}
.ring-step.done view {
  background: #52796a;
  color: white;
}
.ring-step.active view {
  background: #84a99a;
  color: #fff;
  box-shadow: 0 0 0 10rpx rgba(132, 169, 154, 0.23);
  transform: scale(1.08);
}
.ring-step.active text {
  color: white;
  font-weight: 700;
}
.tray {
  position: absolute;
  z-index: 6;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 332rpx;
  padding: 24rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f7f2;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -20rpx 50rpx rgba(32, 40, 34, 0.18);
}
.tool-scroll,
.swatch-scroll {
  width: 100%;
}
.tool-row,
.swatch-row {
  display: flex;
  gap: 18rpx;
  padding: 3rpx 4rpx 20rpx;
}
.tool {
  width: 104rpx;
  flex: none;
  text-align: center;
  color: #66716b;
}
.tool view {
  width: 86rpx;
  height: 86rpx;
  margin: auto;
  border-radius: 26rpx;
  background: #e2e8e3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 31rpx;
  border: 2rpx solid transparent;
}
.tool text {
  font-size: 20rpx;
  display: block;
  margin-top: 9rpx;
}
.tool.active view {
  background: #52796a;
  color: #fff;
  border-color: #385c4f;
}
.tool.active text {
  color: #202822;
  font-weight: 700;
}
.swatch-row {
  gap: 24rpx;
}
.swatch-item {
  width: 82rpx;
  flex: none;
  text-align: center;
}
.swatch-item view {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin: auto;
  border: 7rpx solid #f5f7f2;
  box-shadow: 0 0 0 2rpx rgba(32, 40, 34, 0.14);
}
.swatch-item.active view {
  box-shadow: 0 0 0 5rpx #52796a;
}
.swatch-item text {
  font-size: 18rpx;
  display: block;
  margin-top: 7rpx;
}
.paint-row {
  height: 80rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 0 6rpx 16rpx;
}
.paint-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 3rpx #d9dfda;
}
.symmetry {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 22rpx;
  background: #e2e8e3;
  font-size: 21rpx;
  color: #384940;
  margin-left: auto;
}
.tray-bottom {
  height: 94rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  border-top: 1rpx solid rgba(32, 40, 34, 0.09);
  padding-top: 15rpx;
}
.reset {
  height: 70rpx;
  line-height: 70rpx;
  width: 112rpx;
  background: #e3e8e3;
  color: #46524c;
  font-size: 21rpx;
}
.tool-hint {
  font-size: 21rpx;
  color: #66716b;
  flex: 1;
  text-align: center;
}
.complete {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 26rpx;
  background: #202822;
  color: #fff;
  font-size: 23rpx;
  min-width: 230rpx;
}
.fallback-pot {
  position: absolute;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent));
  transform: translateX(-50%);
  width: 250rpx;
  height: 320rpx;
  clip-path: polygon(
    27% 0,
    73% 0,
    80% 16%,
    70% 40%,
    87% 70%,
    84% 100%,
    16% 100%,
    13% 70%,
    30% 40%,
    20% 16%
  );
  border-radius: 40%;
  box-shadow:
    inset 30rpx 0 30rpx rgba(255, 255, 255, 0.34),
    15rpx 28rpx 30rpx rgba(0, 0, 0, 0.25);
}
.fallback-note {
  position: absolute;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent) - 54rpx);
  transform: translateX(-50%);
  color: #fff;
  font-size: 22rpx;
}
.kiln-overlay {
  position: absolute;
  z-index: 20;
  inset: 0;
  background: rgba(24, 22, 20, 0.91);
  display: flex;
  align-items: center;
  justify-content: center;
}
.kiln-door {
  width: 590rpx;
  height: 780rpx;
  border-radius: 300rpx 300rpx 40rpx 40rpx;
  background: #382d29;
  border: 22rpx solid #5b514b;
  position: relative;
  overflow: hidden;
  text-align: center;
  color: #fff;
  box-shadow: inset 0 0 100rpx #0d0c0b;
}
.kiln-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at 50% 70%,
    #ffb04f,
    #e44c23 44%,
    transparent 76%
  );
}
.temperature {
  position: relative;
  font-family: monospace;
  font-size: 80rpx;
  margin-top: 180rpx;
}
.temperature text {
  font-size: 28rpx;
}
.kiln-copy {
  position: relative;
  font-size: 36rpx;
  margin-top: 40rpx;
}
.kiln-progress {
  position: relative;
  width: 400rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 54rpx auto;
  border-radius: 5rpx;
  overflow: hidden;
}
.kiln-progress view {
  height: 100%;
  background: #ffd18e;
}
.kiln-door button {
  position: relative;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  width: 210rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 22rpx;
}
