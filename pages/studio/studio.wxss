  background: #a6563e;
  border-color: #8e432e;
}
.layer-row {
  gap: 8rpx;
  padding: 1rpx 1rpx 8rpx;
}
.layer-chip {
  height: 88rpx;
  padding: 0 15rpx 0 7rpx;
  flex: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #5d6963;
  background: #e2e7e2;
  border: 2rpx solid transparent;
  font-size: 15rpx;
}
.layer-glyph {
  width: 58rpx;
  height: 58rpx;
  border-radius: 11rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(83, 117, 101, 0.1);
  font-family: "Songti SC", serif;
}
.layer-chip.active {
  color: #29463a;
  background: #d6e5dc;
  border-color: #648b78;
  font-weight: 700;
}
.layer-chip.hidden {
  opacity: 0.48;
}
.decor-controls {
  height: 112rpx;
  padding: 7rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(45, 61, 53, 0.08);
}
.control-context {
  width: 190rpx;
  flex: none;
  padding-right: 10rpx;
  box-sizing: border-box;
}
.control-context text,
.control-context small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.control-context text {
  font-size: 18rpx;
  font-weight: 700;
}
.control-context small {
  margin-top: 4rpx;
  color: #7b867f;
  font-size: 13rpx;
}
.control-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 7rpx;
  overflow-x: auto;
}
.control-actions button,
.accent-controls button {
  min-width: 90rpx;
  height: 88rpx;
  padding: 0 13rpx;
  flex: none;
  border-radius: 16rpx;
  color: #4b5c53;
  background: #dfe5df;
  font-size: 15rpx;
  line-height: 88rpx;
}
.control-actions button:after,
.accent-controls button:after,
.decor-bottom button:after,
.inscription-options button:after,
.inscription-actions button:after {
  border: 0;
}
.control-actions button.danger,
.accent-controls button.danger {
  color: #9c4938;
  background: #eee2de;
}
.decor-bottom {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  height: 92rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.decor-bottom > text {
  flex: 1;
  color: #758079;
  font-size: 15rpx;
  text-align: center;
}
.decor-bottom button {
  height: 88rpx;
  padding: 0 21rpx;
  border-radius: 18rpx;
  font-size: 18rpx;
  line-height: 88rpx;
}
.decor-bottom .quiet,
.inscription-actions .quiet {
  color: #5b6861;
  background: #e0e5e0;
}
.decor-bottom .decor-complete,
.inscription-actions .apply-mark {
  color: #fff;
  background: #202b26;
  font-weight: 700;
}
.fallback-decor {
  position: absolute;
  z-index: 5;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent) + 120rpx);
  transform: translateX(-50%);
  width: 148rpx;
  height: 80rpx;
  border-top: 5rpx double #315e73;
  border-bottom: 5rpx double #315e73;
  color: #315e73;
  text-align: center;
  pointer-events: none;
}
.fallback-decor text {
  display: block;
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  line-height: 48rpx;
}
.fallback-decor small {
  display: block;
  font-size: 12rpx;
}
.fallback-decor.fired-true {
  color: #214d6a;
  border-color: #214d6a;
  filter: saturate(1.25);
}
.fallback-inscription {
  position: absolute;
  z-index: 6;
  left: calc(50% + 62rpx);
  bottom: calc(100% - var(--base-screen-percent) + 28rpx);
  max-width: 76rpx;
  padding: 5rpx;
  border: 2rpx solid #a84f43;
  color: #a84f43;
  font-size: 12rpx;
  line-height: 1.15;
  white-space: pre-line;
  pointer-events: none;
}

/* 釉上彩与写款共用一只托盘，不打开第二层页面。 */
.paint-head {
  margin-bottom: 10rpx;
}
.panel-copy {
  padding: 5rpx 4rpx 13rpx;
}
.panel-copy text,
.panel-copy small {
  display: block;
}
.panel-copy text {
  font-family: "Songti SC", serif;
  font-size: 23rpx;
  font-weight: 700;
}
.panel-copy small {
  margin-top: 4rpx;
  color: #7b857f;
  font-size: 15rpx;
}
.accent-panel .paint-row {
  height: 118rpx;
  padding: 0 2rpx 10rpx;
  gap: 10rpx;
  overflow-x: auto;
}
.paint-color {
  width: 96rpx;
  height: 100rpx;
  flex: none;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #67736c;
  background: #e3e8e3;
  border: 2rpx solid transparent;
}
.paint-color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-shadow:
    inset 0 0 0 3rpx rgba(255, 255, 255, 0.38),
    0 0 0 2rpx rgba(40, 50, 45, 0.12);
}
.paint-color text {
  font-size: 14rpx;
}
.paint-color.active {
  color: #2f493d;
  background: #d7e4dc;
  border-color: #5c826f;
  font-weight: 700;
}
.accent-controls {
  display: flex;
  gap: 9rpx;
  padding: 12rpx 2rpx;
  border-top: 1rpx solid #dce1dc;
}
.inscription-scroll {
  height: 536rpx;
  padding: 0 3rpx 108rpx;
  box-sizing: border-box;
}
.inscription-kicker {
  padding: 4rpx 2rpx 10rpx;
  color: #53665c;
  font-family: "Songti SC", serif;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
}
.inscription-types {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.inscription-types > view {
  flex: 1;
  height: 88rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6d7872;
  background: #e2e7e2;
  font-size: 17rpx;
  font-weight: 700;
}
.inscription-types > view.active {
  color: #fff;
  background: #52796a;
}
.inscription-input {
  width: 100%;
  min-height: 74rpx;
  padding: 17rpx 19rpx;
  box-sizing: border-box;
  border: 2rpx solid #cdd7d0;
  border-radius: 18rpx;
  color: #28362f;
  background: #fbfcf9;
  font-family: "Songti SC", serif;
  font-size: 24rpx;
  line-height: 1.35;
}
.inscription-input.invalid {
  border-color: #b55c48;
  background: #fff8f5;
}
.inscription-error {
  padding: 6rpx 4rpx;
  color: #a44d3b;
  font-size: 15rpx;
}
.blessing-row {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 1rpx 11rpx;
}
.blessing-row view {
  height: 88rpx;
  padding: 0 16rpx;
  flex: none;
  border-radius: 16rpx;
  color: #5d6962;
  background: #e2e7e2;
  font-size: 16rpx;
  line-height: 88rpx;
}
.inscription-options {
  margin-top: 10rpx;
}
.option-line {
  height: 96rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #dde2dd;
}
.option-line > text {
  width: 70rpx;
  flex: none;
  color: #66736b;
  font-size: 16rpx;
}
.option-line scroll-view {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.option-line scroll-view > view {
  display: flex;
  gap: 7rpx;
}
.option-line button {
  height: 88rpx;
  padding: 0 15rpx;
  flex: none;
  border-radius: 14rpx;
  color: #5b6961;
  background: #e2e7e2;
  font-size: 15rpx;
  line-height: 88rpx;
}
.option-line button.active {
  color: #fff;
  background: #52796a;
}
.private-marks {
  margin-top: 13rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #dbe1dc;
}
.private-marks > text {
  color: #66736b;
  font-size: 16rpx;
}
.private-row {
  display: flex;
  gap: 9rpx;
  padding-top: 9rpx;
}
.private-row > view {
  width: 190rpx;
  min-height: 88rpx;
  padding: 9rpx 12rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  color: #394b42;
  background: #e1e7e2;
}
.private-mark-text {
  display: block;
  overflow: hidden;
  font-family: "Songti SC", serif;
  font-size: 17rpx;
  white-space: pre-line;
}
.private-row small {
  display: block;
  margin-top: 5rpx;
  color: #9a503f;
  font-size: 13rpx;
}
.inscription-actions {
  display: flex;
  gap: 9rpx;
  margin-top: 14rpx;
}
.inscription-actions button {
  height: 88rpx;
  padding: 0 19rpx;
  border-radius: 17rpx;
  font-size: 17rpx;
  line-height: 88rpx;
}
.inscription-actions .apply-mark {
  margin-left: auto;
}
.inscription-actions .danger {
  color: #a04b39;
  background: #eee1dc;
}
.privacy-note {
  padding: 12rpx 3rpx 24rpx;
  color: #89918d;
  font-size: 13rpx;
}

.reduce-motion .decor-mode-tabs > view,
.reduce-motion .style-chip,
.reduce-motion .template-card,
.reduce-motion .motif-card,
.reduce-motion .layer-chip,
.reduce-motion .fired-peek {
  transition: none;
}

@media (max-height: 700px) {
  .gesture-map {
    top: 8rpx;
  }
  .form-switcher {
    top: 172rpx;
  }
  .material-dock {
    top: 8rpx;
    bottom: auto;
  }
  .wall-caliper {
    top: 78rpx;
  }
  .stage-footer {
    height: calc(72rpx + env(safe-area-inset-bottom));
  }
}

/* 装饰阶段 · 月白瓷光与墨青木作。背景负责空间，控件像薄瓷片悬浮其上。 */
.decor-workshop-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  background: #14201f;
}
.decor-workshop-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  transform: scale(1.012);
}
.decor-workshop-grade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(8, 16, 16, 0.28) 0%,
      rgba(10, 20, 19, 0.02) 30%,
      rgba(8, 15, 15, 0.13) 59%,
      rgba(7, 14, 14, 0.48) 100%
    ),
    radial-gradient(
      ellipse at 51% 33%,
      rgba(235, 237, 217, 0.14),
      transparent 32%
    ),
    radial-gradient(
      ellipse at 50% 45%,
      transparent 32%,
      rgba(4, 10, 10, 0.2) 100%
    );
  pointer-events: none;
}

.decor-stage .stage-area {
  flex: 3 1 0;
  min-height: 0;
}
.decor-stage .top-actions {
  gap: 6rpx;
}
.decor-stage .top-action {
  padding-left: 12rpx;
  padding-right: 12rpx;
}
.decor-stage .pottery-spotlight {
  top: 1%;
  width: 470rpx;
  height: 580rpx;
  background: radial-gradient(
    ellipse at 48% 42%,
    rgba(246, 240, 216, 0.24),
    rgba(187, 207, 195, 0.07) 48%,
    transparent 72%
  );
}
.decor-stage.decor-menu-closed .pottery-spotlight {
  top: 50%;
  transform: translate(-50%, -50%);
}
.decor-stage.decor-menu-closed .fallback-pot {
  top: 50%;
  bottom: auto;
  transform: translate(-50%, -50%);
}
.decor-stage .wheel-root {
  bottom: 8rpx;
  transform: translateX(-50%) scale(0.86);
}

.decor-fullscreen-trigger {
  position: relative;
  z-index: 8;
  flex: none;
  height: 70rpx;
  min-width: 116rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1rpx solid rgba(213, 228, 219, 0.24);
  border-radius: 999rpx;
  color: rgba(246, 244, 233, 0.92);
  background: rgba(12, 31, 30, 0.54);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12),
    0 10rpx 28rpx rgba(1, 7, 7, 0.18);
  backdrop-filter: blur(12rpx);
}
.decor-fullscreen-trigger text {
  font-size: 18rpx;
  letter-spacing: 0.08em;
}
.decor-fullscreen-trigger view {
  font-size: 28rpx;
  line-height: 1;
}

.decor-tool-panel {
  position: absolute;
  z-index: 16;
  top: 98rpx;
  right: 18rpx;
  width: 166rpx;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  color: #233b38;
  background: transparent;
  box-shadow: none;
  animation: decor-tool-arrive 0.3s ease-out both;
}
.decor-tool-panel.collapsed {
  width: 160rpx;
}
.decor-tool-head {
  min-height: 56rpx;
  padding: 2rpx 3rpx 2rpx 9rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  border: 1rpx solid rgba(227, 236, 228, 0.55);
  border-radius: 20rpx;
  background: rgba(226, 235, 226, 0.72);
  box-shadow:
    0 8rpx 22rpx rgba(3, 16, 14, 0.15),
    inset 0 1rpx rgba(255, 255, 255, 0.58);
  backdrop-filter: blur(14rpx);
}
.decor-tool-drag {
  flex: 1;
  min-width: 0;
  align-self: stretch;
  display: flex;
  align-items: center;
  gap: 7rpx;
}
.decor-drag-icon {
  width: 13rpx;
  flex: none;
  display: grid;
  grid-template-columns: repeat(2, 4rpx);
  gap: 3rpx;
  opacity: 0.72;
}
.decor-drag-icon > view {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #42665e;
}
.decor-tool-title text,
.decor-tool-title small {
  display: block;
  white-space: nowrap;
}
.decor-tool-title text {
  font-family: "Songti SC", "STSong", serif;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
}
.decor-tool-title small {
  margin-top: 1rpx;
  color: #71827c;
  font-size: 11rpx;
}
.decor-tool-fold {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  border-radius: 50%;
  color: #f4f5eb;
  background: #345f56;
  display: flex;
  align-items: center;
  justify-content: center;
}
.decor-tool-chevron {
  width: 13rpx;
  height: 13rpx;
  box-sizing: border-box;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transition: transform 0.2s ease;
}
.decor-tool-chevron.up {
  transform: translateY(3rpx) rotate(225deg);
}
.decor-tool-chevron.down {
  transform: translateY(-3rpx) rotate(45deg);
}
.decor-tool-actions {
  max-height: 420rpx;
  padding-top: 8rpx;
  display: grid;
  gap: 7rpx;
  overflow: hidden;
  opacity: 1;
  transition:
    max-height 0.22s ease,
    padding-top 0.22s ease,
    opacity 0.16s ease;
}
.decor-tool-actions.is-collapsed {
  max-height: 0;
  padding-top: 0;
  opacity: 0;
  pointer-events: none;
}
.decor-tool-command,
.decor-axis-command {
  min-height: 54rpx;
  border: 1rpx solid rgba(224, 236, 226, 0.48);
  border-radius: 18rpx;
  background: rgba(228, 237, 228, 0.64);
  box-shadow:
    0 7rpx 18rpx rgba(3, 16, 14, 0.13),
    inset 0 1rpx rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(13rpx);
}
.decor-tool-command {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.decor-tool-command > text {
  color: #38675d;
  font-family: "Songti SC", serif;
  font-size: 31rpx;
  line-height: 1;
  text-align: center;
}
.decor-tool-command > small {
  font-size: 15rpx;
  letter-spacing: 0.08em;
  white-space: nowrap;
}
.decor-tool-command.danger > text,
.decor-tool-command.danger > small {
  color: #9b4f42;
}
.decor-tool-command.disabled {
  opacity: 0.38;
}
.decor-tool-command:active,
.decor-axis-command > view:active,
.decor-tool-fold:active {
  opacity: 0.7;
  transform: scale(0.95);
}
.decor-delete-icon {
  position: relative;
  width: 29rpx;
  height: 32rpx;
  color: #9b4f42;
}
.decor-delete-icon::before {
  content: "";
  position: absolute;
  left: 6rpx;
  right: 4rpx;
  top: 9rpx;
  bottom: 1rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 2rpx 2rpx 5rpx 5rpx;
}
.decor-delete-icon::after {
  content: "";
  position: absolute;
  left: 3rpx;
  right: 1rpx;
  top: 5rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
}
.decor-delete-icon > view {
  position: absolute;
  left: 11rpx;
  top: 0;
  width: 10rpx;
  height: 5rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
}
.decor-copy-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  color: #38675d;
}
.decor-copy-icon > view {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}
.decor-copy-icon > view:first-child {
  left: 2rpx;
  top: 2rpx;
  opacity: 0.58;
}
.decor-copy-icon > view:last-child {
  right: 2rpx;
  bottom: 2rpx;
  background: rgba(232, 240, 232, 0.8);
}
.decor-axis-command {
  height: 58rpx;
  padding: 0 6rpx;
  display: grid;
  grid-template-columns: 43rpx 1fr 43rpx;
  align-items: center;
  gap: 4rpx;
}
.decor-axis-command > view {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #f3f5ec;
  background: #4e766c;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
}
.decor-axis-command > text {
  color: #40665d;
  font-size: 29rpx;
  line-height: 1;
  text-align: center;
}
@keyframes decor-tool-arrive {
  from {
    opacity: 0;
    transform: translateY(10rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.decor-stage .decor-tray {
  position: relative;
  z-index: 12;
  flex: 2 1 0;
  height: auto;
  width: calc(100% - 24rpx);
  min-height: 0;
  max-height: 44vh;
  margin: 0 12rpx;
  padding: 12rpx 12rpx calc(92rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: visible;
  color: #263b37;
  background: transparent;
  border: 0;
  box-shadow: none;
  transition: opacity 0.2s ease;
}
.decor-stage .decor-tray.expanded {
  animation: decor-drawer-rise 0.34s cubic-bezier(0.2, 0.75, 0.2, 1) both;
}
.decor-stage .decor-tray.collapsed {
  flex: 0 0 calc(100rpx + env(safe-area-inset-bottom));
  height: calc(100rpx + env(safe-area-inset-bottom));
  min-height: calc(100rpx + env(safe-area-inset-bottom));
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
}
.decor-tray-toggle {
  position: absolute;
  z-index: 0;
  left: 12rpx;
  top: -40rpx;
  width: 88rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  border: 1rpx solid rgba(224, 235, 227, 0.48);
  border-bottom: 0;
  border-radius: 24rpx 24rpx 8rpx 8rpx;
  color: rgba(249, 248, 237, 0.9);
  background: rgba(25, 55, 51, 0.76);
  box-shadow: 0 -6rpx 18rpx rgba(2, 10, 9, 0.16);
  backdrop-filter: blur(12rpx);
}
.decor-tray.collapsed .decor-tray-toggle {
  top: -31rpx;
  left: 4rpx;
  width: 74rpx;
  opacity: 0.5;
  background: rgba(27, 50, 47, 0.52);
  box-shadow: none;
}
.decor-tray-toggle view {
  font-size: 22rpx;
  line-height: 1;
}
.decor-tray-toggle text {
  font-size: 13rpx;
  letter-spacing: 0.08em;
}

.decor-panel-grid {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  gap: 12rpx;
}
/* 左右两块菜单统一为“薄瓷片”：细边框 + 轻釉底，浮在暗色工坊背景上。 */
.decor-library-panel,
.decor-selected-panel {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border: 1rpx solid rgba(58, 88, 80, 0.34);
  border-radius: 21rpx;
  background: linear-gradient(
    165deg,
    rgba(250, 251, 243, 0.44),
    rgba(234, 241, 236, 0.3)
  );
  box-shadow:
    inset 0 1rpx rgba(255, 255, 255, 0.42),
    0 10rpx 26rpx rgba(6, 18, 15, 0.14);
}
.decor-library-panel {
  display: flex;
  flex-direction: column;
  padding: 8rpx;
  box-sizing: border-box;
}
.decor-catalog-tabs {
  height: 70rpx;
  flex: none;
  padding: 5rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4rpx;
  box-sizing: border-box;
}
.decor-catalog-tabs > view {
  position: relative;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  border: 1rpx solid rgba(49, 76, 69, 0.14);
  border-radius: 14rpx;
  color: #4a5853;
  background: linear-gradient(
    150deg,
    rgba(252, 251, 243, 0.5),
    rgba(234, 240, 236, 0.36)
  );
  transition:
    transform 0.15s ease,
    color 0.15s ease,
    background 0.15s ease,
    box-shadow 0.15s ease;
}
.decor-catalog-tabs > view:active {
  transform: scale(0.95);
}
.decor-catalog-tabs > view small {
  width: 25rpx;
  height: 25rpx;
  border: 1rpx solid currentColor;
  font-family: "Songti SC", serif;
  font-size: 12rpx;
  line-height: 25rpx;
  text-align: center;
}
.decor-catalog-tabs > view text {
  font-family: "Songti SC", serif;
  font-size: 15rpx;
  font-weight: 700;
  white-space: nowrap;
}
.decor-catalog-tabs > view.active {
  color: #f6f6eb;
  background: linear-gradient(145deg, #426c62, #284e47);
  box-shadow: 0 6rpx 16rpx rgba(25, 57, 50, 0.18);
}
.decor-library-body {
  flex: 1;
  min-height: 0;
  display: flex;
}
/* 侧边图标按钮放大到指尖可点的尺寸，并给出清晰的选中态。 */
.decor-side-menu {
  width: 104rpx;
  height: 100%;
  flex: none;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(50, 76, 69, 0.14);
  background: rgba(44, 74, 66, 0.05);
}
.decor-side-menu-item {
  position: relative;
  width: 88rpx;
  min-height: 88rpx;
  margin: 12rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(49, 76, 69, 0.18);
  border-radius: 15rpx;
  color: #37453f;
  background: linear-gradient(
    150deg,
    rgba(252, 251, 243, 0.62),
    rgba(234, 240, 236, 0.44)
  );
  box-shadow: 0 4rpx 12rpx rgba(32, 54, 49, 0.08);
  transition:
    transform 0.15s ease,
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}
.decor-side-menu-item:active {
  transform: scale(0.93);
}
.decor-side-menu-icon {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.55);
}
.decor-side-menu-item.active {
  color: #275246;
  background: linear-gradient(
    150deg,
    rgba(238, 245, 238, 0.8),
    rgba(201, 222, 210, 0.55)
  );
  border-color: rgba(81, 123, 112, 0.62);
  box-shadow:
    inset 3rpx 0 #517b70,
    0 6rpx 14rpx rgba(44, 87, 75, 0.16);
  font-weight: 700;
}
.decor-grid-scroll {
  height: 100%;
  flex: 1;
  min-width: 0;
}

/* ============ 写款页签：题款面板（A 输入 / B 款色 / C 落款） ============ */
.seal-panel {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 6rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.seal-block {
  flex: none;
  box-sizing: border-box;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(58, 88, 80, 0.24);
  border-radius: 15rpx;
  background: linear-gradient(
    160deg,
    rgba(252, 252, 246, 0.55),
    rgba(236, 243, 238, 0.34)
  );
  box-shadow:
    inset 0 1rpx rgba(255, 255, 255, 0.4),
    0 5rpx 14rpx rgba(6, 18, 15, 0.06);
}
.seal-block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 5rpx;
}
.seal-block-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #37453f;
  font-family: "Songti SC", serif;
  font-size: 15rpx;
  font-weight: 700;
}
.seal-block-title small {
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid rgba(65, 108, 96, 0.5);
  border-radius: 6rpx;
  color: #41716a;
  font-size: 12rpx;
  line-height: 24rpx;
  text-align: center;
  background: rgba(65, 108, 96, 0.08);
}
.seal-count {
  color: rgba(71, 88, 82, 0.55);
  font-size: 12rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.04em;
}
.seal-input {
  width: 100%;
  height: 52rpx;
  padding: 0 13rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(49, 76, 69, 0.2);
  border-radius: 12rpx;
  color: #2c3f39;
  font-size: 22rpx;
  background: rgba(252, 252, 246, 0.72);
  box-shadow: inset 0 2rpx 6rpx rgba(24, 48, 42, 0.06);
}
.seal-input-placeholder {
  color: rgba(96, 110, 104, 0.55);
  font-size: 18rpx;
}
.seal-color-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
}
.seal-color {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 4rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(49, 76, 69, 0.18);
  border-radius: 13rpx;
  background: linear-gradient(
    150deg,
    rgba(252, 251, 243, 0.62),
    rgba(234, 240, 236, 0.44)
  );
  transition:
    transform 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease;
}
.seal-color:active {
  transform: scale(0.94);
}
.seal-color-chip {
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.28),
    inset 0 -3rpx 6rpx rgba(0, 0, 0, 0.22),
    0 4rpx 10rpx rgba(24, 48, 42, 0.18);
}
.seal-color-name {
  color: #4a5853;
  font-family: "Songti SC", serif;
  font-size: 14rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}
.seal-color.active {
  border-color: rgba(81, 123, 112, 0.66);
  background: linear-gradient(
    150deg,
    rgba(238, 245, 238, 0.85),
    rgba(201, 222, 210, 0.5)
  );
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.42),
    0 7rpx 17rpx rgba(44, 87, 75, 0.18);
}
.seal-color.active .seal-color-chip {
  box-shadow:
    0 0 0 3rpx rgba(255, 255, 255, 0.6),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.28),
    inset 0 -3rpx 6rpx rgba(0, 0, 0, 0.22),
    0 5rpx 12rpx rgba(24, 48, 42, 0.22);
}
.seal-color.active .seal-color-name {
  color: #275246;
}
.seal-block-final {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 6rpx;
  margin-top: 0;
  padding: 7rpx 9rpx;
  border-color: rgba(58, 88, 80, 0.3);
  background: linear-gradient(
    160deg,
    rgba(250, 251, 243, 0.62),
    rgba(234, 241, 236, 0.42)
  );
}
.seal-apply {
  width: calc(100% - 8rpx);
  max-width: calc(100% - 8rpx);
  height: 54rpx;
  min-height: 54rpx;
  margin: 0 4rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 13rpx;
  color: #f6f6eb;
  font-family: "Songti SC", serif;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.08em;
  background: linear-gradient(145deg, #426c62, #284e47);
  box-shadow:
    inset 0 1rpx rgba(255, 255, 255, 0.22),
    0 5rpx 14rpx rgba(25, 57, 50, 0.24);
  transition: transform 0.15s ease;
}
.seal-apply::after {
  border: 0;
  width: 0;
  height: 0;
}
.seal-apply:active {
  transform: scale(0.97);
}
.seal-hint {
  color: rgba(71, 88, 82, 0.6);
  font-size: 11rpx;
  line-height: 1.25;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.decor-grid {
  padding: 9rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}
.decor-grid-card,
.decor-selected-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(49, 76, 69, 0.16);
  color: #39544d;
  background: linear-gradient(
    150deg,
    rgba(252, 251, 243, 0.56),
    rgba(234, 240, 236, 0.4)
  );
  box-shadow: 0 5rpx 14rpx rgba(32, 54, 49, 0.08);
}
.decor-grid-card {
  aspect-ratio: 1;
  min-height: 88rpx;
  border-radius: 15rpx;
}
.decor-grid-card.checked,
.decor-selected-card.active {
  border-color: rgba(77, 124, 112, 0.6);
  background: linear-gradient(
    145deg,
    rgba(238, 245, 238, 0.62),
    rgba(201, 222, 210, 0.44)
  );
  box-shadow:
    0 7rpx 19rpx rgba(44, 87, 75, 0.16),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.38);
}
.motif-art {
  position: absolute;
  inset: 5rpx 5rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11rpx;
  color: #315e73;
  background:
    radial-gradient(
      circle at 50% 48%,
      rgba(75, 112, 124, 0.08),
      transparent 58%
    ),
    linear-gradient(
      145deg,
      rgba(255, 255, 250, 0.54),
      rgba(208, 223, 216, 0.28)
    );
}
.motif-art text {
  position: relative;
  z-index: 2;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  line-height: 1;
  text-shadow: 0 1rpx rgba(255, 255, 255, 0.7);
}
.motif-art > view {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border: 1rpx solid currentColor;
  opacity: 0.18;
  transform: rotate(45deg);
}
.motif-art > view:first-child {
  left: 9rpx;
  top: 9rpx;
  border-right: 0;
  border-bottom: 0;
}
.motif-art > view:last-child {
  right: 9rpx;
  bottom: 9rpx;
  border-left: 0;
  border-top: 0;
}
.motif-art.seal-mark-art::after {
  content: "";
  position: absolute;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  border: 3rpx double currentColor;
  opacity: 0.5;
}
.motif-art.seal-mark-art text {
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
  font-weight: 700;
}
.motif-ink-2 {
  color: #3b6d78;
}
.motif-ink-3 {
  color: #254f68;
}
.motif-ink-4 {
  color: #567b70;
}
.motif-ink-5 {
  color: #8e5146;
}
.motif-ink-6 {
  color: #665d83;
}
.decor-grid-name {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  bottom: 5rpx;
  overflow: hidden;
  color: #4d5d56;
  font-size: 13rpx;
  line-height: 18rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.decor-check {
  position: absolute;
  z-index: 5;
  top: 5rpx;
  right: 5rpx;
  width: 29rpx;
  height: 29rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 50%;
  color: #fff;
  background: #4b766b;
  box-shadow: 0 3rpx 9rpx rgba(23, 58, 50, 0.22);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 29rpx;
  text-align: center;
}

.decor-selected-panel {
  padding: 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
/* 标题栏加大字号、加深字色，计数改为胶囊徽标，双位数也不拥挤。 */
.decor-selected-head {
  height: 66rpx;
  flex: none;
  padding: 0 6rpx 9rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.decor-selected-head > view small,
.decor-selected-head > view text {
  display: block;
}
.decor-selected-head > view small {
  color: #97744c;
  font-family: "Songti SC", serif;
  font-size: 12rpx;
  letter-spacing: 0.22em;
}
.decor-selected-head > view text {
  margin-top: 2rpx;
  color: #2c4a41;
  font-family: "Songti SC", serif;
  font-size: 19rpx;
  font-weight: 700;
}
.decor-selected-head > text {
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: #f8f6e7;
  background: linear-gradient(145deg, #4d7a6d, #38584d);
  box-shadow: 0 5rpx 12rpx rgba(23, 58, 50, 0.22);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
}
.decor-selected-scroll {
  height: calc(100% - 66rpx);
  flex: 1;
  min-height: 0;
}
.decor-selected-grid {
  padding: 9rpx 2rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}
.decor-selected-card {
  aspect-ratio: 1;
  min-height: 98rpx;
  border-radius: 15rpx;
}
.decor-selected-card .motif-art {
  inset: 5rpx 5rpx 23rpx;
}
.decor-selected-card > text {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 5rpx;
  overflow: hidden;
  color: #4d5d56;
  font-size: 13rpx;
  line-height: 18rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.decor-selected-card.hidden {
  opacity: 0.45;
}
.decor-selected-card .decor-check {
  left: 5rpx;
  right: auto;
}
.decor-copy-badge {
  position: absolute;
  z-index: 6;
  top: 5rpx;
  right: 5rpx;
  min-width: 29rpx;
  height: 29rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  color: #fff;
  background: #9a654d;
  box-shadow: 0 3rpx 9rpx rgba(73, 42, 28, 0.2);
  font-size: 15rpx;
  font-weight: 700;
  line-height: 27rpx;
  text-align: center;
}
.decor-selected-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6d7d77;
  text-align: center;
}
.decor-selected-empty text {
  font-family: "Songti SC", serif;
  font-size: 18rpx;
}
.decor-selected-empty small {
  margin-top: 6rpx;
  font-size: 12rpx;
}

.decor-stage .decor-bottom {
  position: absolute;
  z-index: 5;
  left: 12rpx;
  right: 12rpx;
  bottom: env(safe-area-inset-bottom);
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.decor-stage .decor-bottom > text {
  flex: 1;
  color: #71817b;
  font-size: 14rpx;
  text-align: center;
}
.decor-stage .decor-bottom .decor-previous {
  width: 154rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(57, 83, 76, 0.18);
  border-radius: 999rpx;
  color: #45635c;
  background: rgba(247, 247, 238, 0.62);
  font-family: "Songti SC", serif;
  font-size: 17rpx;
  line-height: 62rpx;
  transition:
    transform 0.15s ease,
    background 0.15s ease;
}
.decor-stage .decor-bottom .decor-previous:active {
  transform: scale(0.96);
  background: rgba(247, 247, 238, 0.85);
}
.decor-stage .decor-bottom .decor-previous::after {
  border: 0;
}
.decor-stage .decor-bottom .decor-previous view {
  font-size: 22rpx;
  line-height: 1;
}
.decor-stage .decor-bottom .decor-complete {
  width: 218rpx;
  height: 66rpx;
  padding: 0 10rpx 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 999rpx;
  color: #f8f6e9;
  background: linear-gradient(145deg, #315d54, #1d403b);
  box-shadow:
    0 9rpx 24rpx rgba(14, 48, 41, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  font-family: "Songti SC", serif;
  font-size: 19rpx;
  line-height: 66rpx;
  letter-spacing: 0.1em;
  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;
}
.decor-stage .decor-bottom .decor-complete:active {
  transform: scale(0.97);
}
.decor-stage .decor-bottom .decor-complete view {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  font-size: 23rpx;
  line-height: 48rpx;
}
.decor-tray.collapsed .decor-bottom {
  left: 4rpx;
  right: 4rpx;
  width: auto;
  justify-content: space-between;
  border: 0;
}
.decor-tray.collapsed .decor-bottom > text {
  display: none;
}
@keyframes decor-drawer-rise {
  from {
    opacity: 0.3;
    transform: translateY(34rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.decor-fullscreen .topbar .work-title,
.decor-fullscreen .topbar .top-actions,
.decor-fullscreen .decor-tray,
.decor-fullscreen .hint {
  display: none;
}
.decor-fullscreen .topbar {
  height: 86rpx;
}
.decor-fullscreen .stage-area {
  flex: 1 1 auto;
}
.decor-fullscreen .wheel-root {
  opacity: 0;
}
.decor-fullscreen .pottery-spotlight {
  top: 4%;
  width: 560rpx;
  height: 760rpx;
}

.reduce-motion .decor-tool-panel,
.reduce-motion .decor-tray.expanded {
  animation: none;
}
.reduce-motion .decor-tray,
.reduce-motion .decor-tool-actions,
.reduce-motion .decor-tool-chevron,
.reduce-motion .decor-side-menu-item,
.reduce-motion .decor-catalog-tabs > view,
.reduce-motion .decor-stage .decor-bottom .decor-previous,
.reduce-motion .decor-stage .decor-bottom .decor-complete {
  transition: none;
}

@media (max-height: 700px) {
  .decor-stage .decor-tray {
    max-height: 46vh;
    padding-bottom: calc(78rpx + env(safe-area-inset-bottom));
  }
  .decor-stage .decor-bottom {
    height: 72rpx;
  }
  .decor-stage .decor-bottom .decor-complete {
    height: 58rpx;
    line-height: 58rpx;
  }
  .decor-catalog-tabs {
    height: 60rpx;
  }
  .seal-panel {
    gap: 4rpx;
    padding: 4rpx;
  }
  .seal-block {
    padding: 5rpx 8rpx;
  }
  .seal-block-head {
    margin-bottom: 3rpx;
  }
  .seal-input {
    height: 44rpx;
  }
  .seal-color {
    padding: 4rpx 3rpx;
  }
  .seal-color-chip {
    width: 25rpx;
    height: 25rpx;
  }
  .seal-apply {
    height: 46rpx;
    min-height: 46rpx;
    font-size: 19rpx;
  }
  .seal-hint {
    display: none;
  }
  .decor-tool-panel {
    top: 70rpx;
  }
}

/* 上釉阶段 · 与装饰工序同处墨青工坊，六枚釉样像薄瓷试片悬在台前。 */
.glaze-stage .stage-area {
  flex: 1 1 auto;
  min-height: 0;
}
.glaze-stage .pottery-spotlight {
  top: 1%;
  width: 500rpx;
  height: 610rpx;
  background: radial-gradient(
    ellipse at 46% 40%,
    rgba(247, 241, 218, 0.27),
    rgba(183, 205, 193, 0.08) 46%,
    transparent 72%
  );
}
.glaze-stage .wheel-root {
  bottom: 8rpx;
  transform: translateX(-50%) scale(0.88);
}

.glaze-tray {
  position: relative;
  z-index: 12;
  flex: 0 0 calc(446rpx + env(safe-area-inset-bottom));
  width: calc(100% - 24rpx);
  height: calc(446rpx + env(safe-area-inset-bottom));
  min-height: calc(446rpx + env(safe-area-inset-bottom));
  margin: 0 12rpx;
  padding: 10rpx 12rpx calc(92rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #263b37;
  background: transparent;
  animation: glaze-tray-rise 0.34s cubic-bezier(0.2, 0.75, 0.2, 1) both;
}
.glaze-panel {
  height: 100%;
  padding: 10rpx 12rpx 13rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(58, 88, 80, 0.34);
  border-radius: 23rpx;
  background: linear-gradient(
    165deg,
    rgba(250, 251, 243, 0.5),
    rgba(230, 239, 233, 0.34)
  );
  box-shadow:
    inset 0 1rpx rgba(255, 255, 255, 0.48),
    0 12rpx 30rpx rgba(4, 16, 13, 0.16);
  backdrop-filter: blur(18rpx);
}
.glaze-title {
  height: 50rpx;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 18rpx;
  color: #284d46;
}
.glaze-title::before,
.glaze-title::after {
  content: "";
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(57, 91, 82, 0.32));
}
.glaze-title::after {
  transform: scaleX(-1);
}
.glaze-title text {
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-indent: 0.22em;
}
.glaze-grid {
  height: calc(100% - 50rpx);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
  gap: 10rpx 11rpx;
}
.glaze-choice {
  position: relative;
  min-width: 0;
  min-height: 0;
  padding: 9rpx 5rpx 7rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(60, 92, 83, 0.13);
  border-radius: 18rpx;
  color: #435c55;
  background: rgba(247, 248, 240, 0.42);
  box-shadow: inset 0 1rpx rgba(255, 255, 255, 0.38);
  transition:
    transform 0.15s ease,
    border-color 0.15s ease,
    background 0.15s ease,
    box-shadow 0.15s ease;
}
.glaze-choice:active {
  transform: scale(0.97);
}
.glaze-choice.active {
  border-color: rgba(47, 89, 78, 0.58);
  color: #203f38;
  background: rgba(248, 250, 243, 0.82);
  box-shadow:
    inset 0 1rpx rgba(255, 255, 255, 0.65),
    0 6rpx 18rpx rgba(25, 66, 56, 0.12);
}
.glaze-sample {
  position: relative;
  width: 92rpx;
  height: 50rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 50% 50% 46% 46%;
  box-shadow:
    inset 0 -8rpx 12rpx rgba(6, 18, 15, 0.2),
    0 0 0 1rpx rgba(32, 61, 54, 0.2),
    0 7rpx 12rpx rgba(6, 24, 19, 0.16);
}
.glaze-sample-sheen {
  position: absolute;
  left: 16rpx;
  top: 5rpx;
  width: 43rpx;
  height: 15rpx;
  border-radius: 50%;
  background: linear-gradient(100deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.05));
  transform: rotate(-8deg);
  filter: blur(1rpx);
}
.glaze-sample-pool {
  position: absolute;
  left: 9rpx;
  right: 9rpx;
  bottom: 3rpx;
  height: 11rpx;
  border-radius: 50%;
  background: rgba(7, 19, 16, 0.14);
  filter: blur(4rpx);
}
.glaze-choice > text {
  display: block;
  max-width: 100%;
  margin-top: 7rpx;
  overflow: hidden;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.glaze-check {
  position: absolute;
  top: 6rpx;
  right: 7rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  color: #f6f7ed;
  background: linear-gradient(145deg, #4d7a6d, #31574d);
  box-shadow: 0 4rpx 10rpx rgba(24, 61, 52, 0.2);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
}

.glaze-bottom {
  position: absolute;
  z-index: 5;
  left: 12rpx;
  right: 12rpx;
  bottom: env(safe-area-inset-bottom);
  height: 84rpx;
}

/* WebGL 不可用时仍按当前单选釉色实时改变器身，而不是退回统一占位色。 */
.fallback-pot.glazed {
  box-shadow:
    inset 38rpx 0 34rpx rgba(255, 255, 255, 0.26),
    inset -28rpx 0 34rpx rgba(8, 20, 16, 0.24),
    inset 0 -24rpx 26rpx rgba(10, 24, 19, 0.18),
    15rpx 28rpx 30rpx rgba(0, 0, 0, 0.28);
}
.fallback-pot.glazed.glaze-celadon {
  background: linear-gradient(104deg, #5d8178 0%, #9abbb1 28%, #c6d8cf 46%, #87aca1 68%, #496f66 100%);
}
.fallback-pot.glazed.glaze-plum {
  background: linear-gradient(104deg, #294d41 0%, #6e9980 26%, #acc5ad 45%, #5f8a72 67%, #203e35 100%);
}
.fallback-pot.glazed.glaze-black {
  background:
    repeating-linear-gradient(98deg, transparent 0 13rpx, rgba(172, 127, 61, 0.17) 15rpx 17rpx, transparent 20rpx 30rpx),
    linear-gradient(104deg, #090b09 0%, #3a3123 28%, #6a5533 44%, #24231c 63%, #070908 100%);
}
.fallback-pot.glazed.glaze-moon {
  background: linear-gradient(104deg, #c9c1b3 0%, #f2ede3 27%, #fffdf7 48%, #e9e2d6 70%, #bcb4a7 100%);
}
.fallback-pot.glazed.glaze-cobalt {
  background: linear-gradient(104deg, #08274b 0%, #1f5b8f 27%, #5b8fb4 45%, #174f83 67%, #061e3d 100%);
}
.fallback-pot.glazed.glaze-cloud {
  background: linear-gradient(104deg, #94aaa4 0%, #d4e4df 28%, #f4f7ef 48%, #c4d9d3 69%, #809a94 100%);
}

@keyframes glaze-tray-rise {
  from {
    opacity: 0.35;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.reduce-motion .glaze-tray {
  animation: none;
}
.reduce-motion .glaze-choice {
  transition: none;
}

@media (max-height: 700px) {
  .glaze-tray {
    flex-basis: calc(408rpx + env(safe-area-inset-bottom));
    height: calc(408rpx + env(safe-area-inset-bottom));
    min-height: calc(408rpx + env(safe-area-inset-bottom));
    padding-bottom: calc(78rpx + env(safe-area-inset-bottom));
  }
  .glaze-title {
    height: 42rpx;
  }
  .glaze-grid {
    height: calc(100% - 42rpx);
  }
  .glaze-sample {
    width: 80rpx;
    height: 42rpx;
  }
  .glaze-bottom {
    height: 72rpx;
  }
}

/* 釉上彩绘阶段 · 沿用装饰工坊的器物舞台，只把左侧材料库换成三类彩绘入口。 */
.paint-stage .pottery-spotlight {
  background:
    radial-gradient(circle at 62% 38%, rgba(182, 91, 65, 0.09), transparent 24%),
    radial-gradient(
      ellipse at 48% 42%,
      rgba(246, 240, 216, 0.24),
      rgba(187, 207, 195, 0.07) 48%,
      transparent 72%
    );
}
.paint-stage .decor-tool-fold {
  background: linear-gradient(145deg, #8d5042, #65382f);
}
.paint-stage .decor-tool-head {
  border-color: rgba(239, 223, 207, 0.58);
  background: rgba(234, 233, 218, 0.74);
}
.paint-catalog-tabs {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.paint-library-body,
.paint-grid-scroll {
  width: 100%;
}
.paint-panel-grid .decor-library-panel {
  background: linear-gradient(
    165deg,
    rgba(251, 248, 237, 0.48),
    rgba(235, 239, 229, 0.3)
  );
}
.paint-fired-peek {
  position: absolute;
  z-index: 5;
  right: 12rpx;
  top: -40rpx;
  min-width: 190rpx;
  height: 50rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  border: 1rpx solid rgba(224, 235, 227, 0.48);
  border-bottom: 0;
  border-radius: 24rpx 24rpx 8rpx 8rpx;
  color: rgba(249, 248, 237, 0.9);
  background: rgba(25, 55, 51, 0.76);
  box-shadow: 0 -6rpx 18rpx rgba(2, 10, 9, 0.16);
  backdrop-filter: blur(12rpx);
  transition:
    color 0.18s ease,
    background 0.18s ease,
    transform 0.15s ease;
}
.paint-fired-peek:active {
  transform: scale(0.97);
}
.paint-fired-peek > view {
  width: 28rpx;
  height: 28rpx;
  border: 1rpx solid currentColor;
  border-radius: 8rpx 8rpx 11rpx 11rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 14rpx;
  line-height: 28rpx;
  text-align: center;
}
.paint-fired-peek > text {
  font-size: 13rpx;
  letter-spacing: 0.08em;
}
.paint-fired-peek.active {
  color: #fff4df;
  background: rgba(143, 70, 52, 0.88);
}
.paint-tray.collapsed .paint-fired-peek {
  top: -31rpx;
  right: 4rpx;
  opacity: 0.58;
  box-shadow: none;
}
.paint-grid-card .paint-motif-art,
.paint-selected-card .paint-motif-art {
  background:
    radial-gradient(circle at 50% 48%, currentColor 0 1rpx, transparent 2rpx),
    radial-gradient(circle at 50% 48%, rgba(255, 250, 236, 0.7), transparent 62%),
    linear-gradient(145deg, rgba(255, 253, 245, 0.6), rgba(218, 225, 211, 0.3));
}
.paint-grid-card.pigment-card {
  border-color: rgba(122, 86, 64, 0.2);
  background: linear-gradient(150deg, rgba(253, 248, 234, 0.66), rgba(226, 230, 216, 0.42));
}
.paint-grid-card.pigment-card.checked {
  border-color: rgba(151, 85, 63, 0.66);
  background: linear-gradient(145deg, rgba(249, 237, 218, 0.76), rgba(225, 210, 188, 0.5));
  box-shadow:
    0 7rpx 19rpx rgba(80, 45, 31, 0.16),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.42);
}
.paint-pigment-art {
  position: absolute;
  inset: 4rpx 4rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.paint-pigment-dish {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  box-sizing: border-box;
  border: 6rpx solid rgba(245, 241, 224, 0.92);
  border-radius: 50%;
  background: #d4d0c1;
  box-shadow:
    inset 0 -5rpx 9rpx rgba(36, 29, 24, 0.18),
    0 7rpx 12rpx rgba(46, 36, 29, 0.16),
    0 0 0 1rpx rgba(77, 64, 54, 0.17);
}
.paint-pigment-dish > view {
  position: absolute;
  inset: 5rpx;
  border-radius: 50%;
  box-shadow:
    inset 5rpx 6rpx 9rpx rgba(255, 255, 255, 0.24),
    inset -6rpx -8rpx 10rpx rgba(16, 12, 10, 0.22);
}
.paint-pigment-dish > view::after {
  content: "";
  position: absolute;
  left: 17%;
  top: 13%;
  width: 34%;
  height: 20%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  transform: rotate(-24deg);
}
.paint-pigment-art > text {
  position: absolute;
  right: 8rpx;
  bottom: 3rpx;
  width: 25rpx;
  height: 25rpx;
  border: 1rpx solid rgba(132, 74, 55, 0.55);
  color: #8f4e3e;
  background: rgba(251, 244, 225, 0.84);
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 12rpx;
  line-height: 25rpx;
  text-align: center;
}
.paint-layer-swatch {
  position: absolute;
  z-index: 5;
  right: 7rpx;
  bottom: 27rpx;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  box-shadow: 0 3rpx 8rpx rgba(31, 24, 20, 0.24);
}
.paint-selected-empty small {
  max-width: 150rpx;
  line-height: 1.45;
}
.paint-stage .paint-bottom > text {
  color: rgba(225, 231, 220, 0.74);
}
.paint-stage .paint-bottom .decor-complete {
  background: linear-gradient(145deg, #6f483f, #3f302c);
  box-shadow:
    0 9rpx 24rpx rgba(42, 20, 15, 0.25),
    inset 0 1rpx rgba(255, 255, 255, 0.13);
}
.reduce-motion .paint-fired-peek,
.reduce-motion .paint-grid-card,
.reduce-motion .paint-stage .paint-bottom .decor-complete {
  transition: none;
}
