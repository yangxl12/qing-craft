  overflow: hidden;
  opacity: 1;
  transition: max-height .22s ease, padding-top .22s ease, opacity .16s ease;
}
.decor-tool-actions.is-collapsed {
  max-height: 0;
  padding-top: 0;
  opacity: 0;
  pointer-events: none;
}
.decor-tool-command,
.decor-axis-command {
  min-height: 54rpx;
  border: 1rpx solid rgba(224,236,226,.48);
  border-radius: 18rpx;
  background: rgba(228,237,228,.64);
  box-shadow: 0 7rpx 18rpx rgba(3,16,14,.13), inset 0 1rpx rgba(255,255,255,.5);
  backdrop-filter: blur(13rpx);
}
.decor-tool-command {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.decor-tool-command > text { color: #38675d; font-family: "Songti SC", serif; font-size: 31rpx; line-height: 1; text-align: center; }
.decor-tool-command > small { font-size: 15rpx; letter-spacing: .08em; white-space: nowrap; }
.decor-tool-command.danger > text,
.decor-tool-command.danger > small { color: #9b4f42; }
.decor-tool-command.disabled { opacity: .38; }
.decor-tool-command:active,
.decor-axis-command > view:active,
.decor-tool-fold:active { opacity: .7; transform: scale(.95); }
.decor-delete-icon { position: relative; width: 29rpx; height: 32rpx; color: #9b4f42; }
.decor-delete-icon::before {
  content: "";
  position: absolute;
  left: 6rpx;
  right: 4rpx;
  top: 9rpx;
  bottom: 1rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 2rpx 2rpx 5rpx 5rpx;
}
.decor-delete-icon::after {
  content: "";
  position: absolute;
  left: 3rpx;
  right: 1rpx;
  top: 5rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
}
.decor-delete-icon > view { position: absolute; left: 11rpx; top: 0; width: 10rpx; height: 5rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 4rpx 4rpx 0 0; }
.decor-copy-icon { position: relative; width: 32rpx; height: 32rpx; color: #38675d; }
.decor-copy-icon > view { position: absolute; width: 20rpx; height: 20rpx; box-sizing: border-box; border: 3rpx solid currentColor; border-radius: 4rpx; }
.decor-copy-icon > view:first-child { left: 2rpx; top: 2rpx; opacity: .58; }
.decor-copy-icon > view:last-child { right: 2rpx; bottom: 2rpx; background: rgba(232,240,232,.8); }
.decor-axis-command {
  height: 58rpx;
  padding: 0 6rpx;
  display: grid;
  grid-template-columns: 43rpx 1fr 43rpx;
  align-items: center;
  gap: 4rpx;
}
.decor-axis-command > view {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #f3f5ec;
  background: #4e766c;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
}
.decor-axis-command > text { color: #40665d; font-size: 29rpx; line-height: 1; text-align: center; }
@keyframes decor-tool-arrive {
  from { opacity: 0; transform: translateY(10rpx) scale(.96); }
  to { opacity: 1; transform: none; }
}

.decor-stage .decor-tray {
  position: relative;
  z-index: 12;
  flex: 2 1 0;
  height: auto;
  width: calc(100% - 24rpx);
  min-height: 0;
  max-height: 44vh;
  margin: 0 12rpx;
  padding: 12rpx 12rpx calc(92rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: visible;
  color: #263b37;
  background:
    linear-gradient(145deg, rgba(243,244,232,.93), rgba(208,220,212,.88)),
    rgba(231,235,224,.9);
  border: 1rpx solid rgba(238,242,231,.7);
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -15rpx 44rpx rgba(3,13,12,.27), inset 0 1rpx 0 rgba(255,255,255,.8);
  backdrop-filter: blur(22rpx);
  transition: opacity .2s ease;
}
.decor-stage .decor-tray.expanded { animation: decor-drawer-rise .34s cubic-bezier(.2,.75,.2,1) both; }
.decor-stage .decor-tray.collapsed {
  flex: 0 0 calc(100rpx + env(safe-area-inset-bottom));
  height: calc(100rpx + env(safe-area-inset-bottom));
  min-height: calc(100rpx + env(safe-area-inset-bottom));
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
}
.decor-tray-toggle {
  position: absolute;
  z-index: 0;
  left: -2rpx;
  top: -40rpx;
  width: 88rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  border: 1rpx solid rgba(224,235,227,.48);
  border-bottom: 0;
  border-radius: 24rpx 24rpx 8rpx 8rpx;
  color: rgba(249,248,237,.9);
  background: rgba(25,55,51,.76);
  box-shadow: 0 -6rpx 18rpx rgba(2,10,9,.16);
  backdrop-filter: blur(12rpx);
}
.decor-tray.collapsed .decor-tray-toggle {
  top: -31rpx;
  left: -12rpx;
  width: 74rpx;
  opacity: .5;
  background: rgba(27,50,47,.52);
  box-shadow: none;
}
.decor-tray-toggle view { font-size: 22rpx; line-height: 1; }
.decor-tray-toggle text { font-size: 13rpx; letter-spacing: .08em; }

.decor-panel-grid {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  gap: 12rpx;
}
.decor-library-panel,
.decor-selected-panel {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border: 1rpx solid rgba(53,80,74,.1);
  border-radius: 21rpx;
  background: rgba(250,249,240,.48);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.66), 0 8rpx 22rpx rgba(35,57,52,.06);
}
.decor-library-panel { display: flex; flex-direction: column; }
.decor-catalog-tabs {
  height: 70rpx;
  flex: none;
  padding: 5rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 4rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(55,78,73,.08);
}
.decor-catalog-tabs > view {
  position: relative;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  border-radius: 14rpx;
  color: #64736e;
}
.decor-catalog-tabs > view small {
  width: 25rpx;
  height: 25rpx;
  border: 1rpx solid currentColor;
  font-family: "Songti SC", serif;
  font-size: 12rpx;
  line-height: 25rpx;
  text-align: center;
}
.decor-catalog-tabs > view text { font-family: "Songti SC", serif; font-size: 15rpx; font-weight: 700; white-space: nowrap; }
.decor-catalog-tabs > view.active {
  color: #f6f6eb;
  background: linear-gradient(145deg, #426c62, #284e47);
  box-shadow: 0 6rpx 16rpx rgba(25,57,50,.18);
}
.decor-library-body { flex: 1; min-height: 0; display: flex; }
.decor-side-menu {
  width: 82rpx;
  height: 100%;
  flex: none;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(50,76,69,.08);
}
.decor-side-menu > view {
  position: relative;
  width: 68rpx;
  min-height: 60rpx;
  margin: 7rpx;
  padding: 8rpx 5rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #6d7a75;
  background: rgba(222,229,222,.54);
}
.decor-side-menu-icon { font-family: "Songti SC", serif; font-size: 28rpx; line-height: 1; text-align: center; }
.decor-side-menu > view.active {
  color: #2e554c;
  background: #d0dfd6;
  box-shadow: inset 3rpx 0 #517b70;
  font-weight: 700;
}
.decor-grid-scroll { height: 100%; flex: 1; min-width: 0; }
.decor-grid {
  padding: 9rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}
.decor-grid-card,
.decor-selected-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(49,76,69,.11);
  color: #39544d;
  background: rgba(252,251,243,.72);
  box-shadow: 0 5rpx 14rpx rgba(32,54,49,.07);
}
.decor-grid-card {
  aspect-ratio: 1;
  min-height: 88rpx;
  border-radius: 15rpx;
}
.decor-grid-card.checked,
.decor-selected-card.active {
  border-color: #4d7c70;
  background: linear-gradient(145deg, rgba(238,245,238,.96), rgba(201,222,210,.88));
  box-shadow: 0 7rpx 19rpx rgba(44,87,75,.16), inset 0 0 0 2rpx rgba(255,255,255,.48);
}
.motif-art {
  position: absolute;
  inset: 5rpx 5rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11rpx;
  color: #315e73;
  background:
    radial-gradient(circle at 50% 48%, rgba(75,112,124,.08), transparent 58%),
    linear-gradient(145deg, rgba(255,255,250,.54), rgba(208,223,216,.28));
}
.motif-art text { position: relative; z-index: 2; font-family: "Songti SC", "STSong", serif; font-size: 30rpx; line-height: 1; text-shadow: 0 1rpx rgba(255,255,255,.7); }
.motif-art > view { position: absolute; width: 36rpx; height: 36rpx; border: 1rpx solid currentColor; opacity: .18; transform: rotate(45deg); }
.motif-art > view:first-child { left: 9rpx; top: 9rpx; border-right: 0; border-bottom: 0; }
.motif-art > view:last-child { right: 9rpx; bottom: 9rpx; border-left: 0; border-top: 0; }
.motif-ink-2 { color: #3b6d78; }
.motif-ink-3 { color: #254f68; }
.motif-ink-4 { color: #567b70; }
.motif-ink-5 { color: #8e5146; }
.motif-ink-6 { color: #665d83; }
.decor-grid-name {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  bottom: 5rpx;
  overflow: hidden;
  color: #53635e;
  font-size: 12rpx;
  line-height: 16rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.decor-check {
  position: absolute;
  z-index: 5;
  top: 5rpx;
  right: 5rpx;
  width: 29rpx;
  height: 29rpx;
  border: 2rpx solid rgba(255,255,255,.86);
  border-radius: 50%;
  color: #fff;
  background: #4b766b;
  box-shadow: 0 3rpx 9rpx rgba(23,58,50,.22);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 29rpx;
  text-align: center;
}

.decor-selected-panel { padding: 7rpx; box-sizing: border-box; display: flex; flex-direction: column; }
.decor-selected-head {
  height: 55rpx;
  flex: none;
  padding: 0 4rpx 7rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(51,78,70,.09);
}
.decor-selected-head > view small,
.decor-selected-head > view text { display: block; }
.decor-selected-head > view small { color: #8b6a4e; font-family: "Songti SC", serif; font-size: 10rpx; letter-spacing: .22em; }
.decor-selected-head > view text { margin-top: 1rpx; font-family: "Songti SC", serif; font-size: 16rpx; font-weight: 700; }
.decor-selected-head > text {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #f4f4e9;
  background: #456d63;
  font-size: 15rpx;
  line-height: 34rpx;
  text-align: center;
}
.decor-selected-scroll { height: calc(100% - 55rpx); flex: 1; min-height: 0; }
.decor-selected-grid { padding: 9rpx 2rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; }
.decor-selected-card { aspect-ratio: 1; min-height: 98rpx; border-radius: 15rpx; }
.decor-selected-card .motif-art { inset: 5rpx 5rpx 23rpx; }
.decor-selected-card > text {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 5rpx;
  overflow: hidden;
  color: #53635e;
  font-size: 12rpx;
  line-height: 16rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.decor-selected-card.hidden { opacity: .45; }
.decor-selected-card .decor-check { left: 5rpx; right: auto; }
.decor-copy-badge {
  position: absolute;
  z-index: 6;
  top: 5rpx;
  right: 5rpx;
  min-width: 29rpx;
  height: 29rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255,255,255,.82);
  border-radius: 999rpx;
  color: #fff;
  background: #9a654d;
  box-shadow: 0 3rpx 9rpx rgba(73,42,28,.2);
  font-size: 15rpx;
  font-weight: 700;
  line-height: 27rpx;
  text-align: center;
}
.decor-selected-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6d7d77; text-align: center; }
.decor-selected-empty text { font-family: "Songti SC", serif; font-size: 18rpx; }
.decor-selected-empty small { margin-top: 6rpx; font-size: 12rpx; }

.decor-stage .decor-bottom {
  position: absolute;
  z-index: 5;
  left: 12rpx;
  right: 12rpx;
  bottom: env(safe-area-inset-bottom);
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  border-top: 1rpx solid rgba(45,72,65,.09);
}
.decor-stage .decor-bottom > text {
  flex: 1;
  color: #71817b;
  font-size: 14rpx;
  text-align: center;
}
.decor-stage .decor-bottom .decor-previous {
  width: 154rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(57,83,76,.18);
  border-radius: 999rpx;
  color: #45635c;
  background: rgba(247,247,238,.62);
  font-family: "Songti SC", serif;
  font-size: 17rpx;
  line-height: 62rpx;
}
.decor-stage .decor-bottom .decor-previous::after { border: 0; }
.decor-stage .decor-bottom .decor-previous view { font-size: 22rpx; line-height: 1; }
.decor-stage .decor-bottom .decor-complete {
  width: 218rpx;
  height: 66rpx;
  padding: 0 10rpx 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 999rpx;
  color: #f8f6e9;
  background: linear-gradient(145deg, #315d54, #1d403b);
  box-shadow: 0 9rpx 24rpx rgba(14,48,41,.22), inset 0 1rpx 0 rgba(255,255,255,.12);
  font-family: "Songti SC", serif;
  font-size: 19rpx;
  line-height: 66rpx;
  letter-spacing: .1em;
}
.decor-stage .decor-bottom .decor-complete view {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
  font-size: 23rpx;
  line-height: 48rpx;
}
.decor-tray.collapsed .decor-bottom {
  left: 4rpx;
  right: 4rpx;
  width: auto;
  justify-content: space-between;
  border: 0;
}
.decor-tray.collapsed .decor-bottom > text { display: none; }
@keyframes decor-drawer-rise {
  from { opacity: .3; transform: translateY(34rpx); }
  to { opacity: 1; transform: none; }
}

.decor-fullscreen .topbar .work-title,
.decor-fullscreen .topbar .top-actions,
.decor-fullscreen .decor-tray,
.decor-fullscreen .decor-selection-label,
.decor-fullscreen .hint { display: none; }
.decor-fullscreen .topbar { height: 86rpx; }
.decor-fullscreen .stage-area { flex: 1 1 auto; }
.decor-fullscreen .wheel-root { opacity: 0; }
.decor-fullscreen .pottery-spotlight { top: 4%; width: 560rpx; height: 760rpx; }

.reduce-motion .decor-tool-panel,
.reduce-motion .decor-tray.expanded { animation: none; }
.reduce-motion .decor-tray,
.reduce-motion .decor-tool-actions,
.reduce-motion .decor-tool-chevron { transition: none; }

@media (max-height: 700px) {
  .decor-stage .decor-tray { max-height: 46vh; padding-bottom: calc(78rpx + env(safe-area-inset-bottom)); }
  .decor-stage .decor-bottom { height: 72rpx; }
  .decor-stage .decor-bottom .decor-complete { height: 58rpx; line-height: 58rpx; }
  .decor-catalog-tabs { height: 60rpx; }
  .decor-side-menu > view { min-height: 51rpx; margin-top: 5rpx; margin-bottom: 5rpx; }
  .decor-tool-panel { top: 70rpx; }
}
