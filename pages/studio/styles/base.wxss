.studio {
  position: relative;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--ui-text);
  background: var(--color-workshop-bg);
  isolation: isolate;
}

.studio button {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  background: transparent;
  font-family: var(--font-body);
  font-size: var(--type-body-size);
  line-height: var(--type-body-line);
}

.studio button::after { border: 0; }
.studio button:active { transform: translateY(2rpx) scale(0.98); }
.studio button[disabled] { opacity: var(--ui-disabled-opacity); pointer-events: none; }

.shaping-workshop-bg,
.decor-workshop-bg,
.workshop-bg,
.kiln-backdrop {
  position: absolute;
  z-index: 0;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.shaping-workshop-image,
.decor-workshop-image,
.kiln-background-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.shaping-workshop-grade,
.decor-workshop-grade {
  position: absolute;
  inset: 0;
}

.shaping-workshop-grade {
  background:
    linear-gradient(180deg, var(--ui-workshop-scrim) 0, transparent 26%, transparent 62%, var(--ui-workshop-scrim-strong) 100%),
    radial-gradient(58% 54% at 50% 54%, transparent 0, transparent 58%, var(--ui-workshop-scrim) 100%);
}

.decor-workshop-grade {
  background:
    linear-gradient(180deg, var(--ui-workshop-scrim-strong) 0, transparent 24%, transparent 58%, var(--ui-workshop-scrim-strong) 100%),
    radial-gradient(60% 58% at 50% 48%, transparent 0, transparent 58%, var(--ui-workshop-scrim) 100%);
}

.workshop-bg {
  background:
    radial-gradient(70% 54% at 50% 42%, var(--color-workshop-surface) 0, var(--color-workshop-bg) 72%),
    var(--color-workshop-bg);
}

.workshop-bg > view { display: none; }

.safe-top {
  position: relative;
  z-index: 40;
  width: 100%;
  min-height: 20px;
  flex: none;
  background: linear-gradient(180deg, var(--ui-workshop-scrim-strong), transparent);
}

.topbar {
  position: relative;
  z-index: 40;
  min-height: 88rpx;
  padding: 0 var(--space-4);
  box-sizing: border-box;
  flex: none;
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr) 112rpx;
  align-items: center;
  background: linear-gradient(180deg, var(--ui-workshop-scrim-strong), var(--ui-workshop-panel-muted));
  border-bottom: 1rpx solid var(--ui-workshop-border);
}

.top-exit {
  min-width: 104rpx !important;
  min-height: 80rpx;
  gap: var(--space-2);
  justify-self: start;
  color: var(--color-on-dark);
  font-size: var(--type-body-sm-size) !important;
}

.work-title {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-3);
  text-align: center;
}

.work-title-main {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
}

.work-title-main > text {
  overflow: hidden;
  color: var(--color-on-dark);
  font-family: var(--font-display);
  font-size: var(--type-h3-size);
  font-weight: 500;
  line-height: var(--type-h3-line);
  letter-spacing: 0.04em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-title-main > small {
  color: var(--color-on-dark-muted);
  font-family: var(--font-data);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
  white-space: nowrap;
}

.save-state {
  min-width: 80rpx;
  color: var(--color-on-dark-muted);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
  white-space: nowrap;
}

.save-state.saved { color: var(--color-celadon-300); }
.topbar-balance { width: 112rpx; }

.stage-progress {
  position: relative;
  z-index: 39;
  height: 60rpx;
  padding: 0 var(--space-8);
  box-sizing: border-box;
  flex: none;
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  align-items: center;
  background: var(--ui-workshop-panel-muted);
}

.stage-progress-line {
  position: absolute;
  left: calc(var(--space-8) + 22rpx);
  right: calc(var(--space-8) + 22rpx);
  top: 50%;
  height: 3rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(90deg, var(--color-on-dark-muted), var(--color-celadon-300));
  opacity: 0.38;
  transform: translateY(-50%);
}

.stage-progress-step {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-progress-mark {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--ui-workshop-border);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-on-dark-muted);
  background: var(--color-workshop-bg);
  font-family: var(--font-display);
  font-size: var(--type-micro-size);
  font-weight: 500;
  line-height: var(--type-micro-line);
}

.stage-progress-step.is-done .stage-progress-mark {
  color: var(--ui-action-text);
  background: var(--color-celadon-300);
  border-color: var(--color-celadon-300);
}

.stage-progress-step.is-current .stage-progress-mark {
  color: var(--color-on-dark);
  background: var(--color-celadon-700);
  border-color: var(--color-celadon-300);
  box-shadow: 0 0 0 6rpx var(--ui-workshop-highlight);
}

.stage-area {
  position: relative;
  z-index: 10;
  min-height: 0;
  flex: 1;
  overflow: hidden;
}

.canvas,
.fallback {
  position: absolute;
  z-index: 10;
  inset: 0;
  width: 100%;
  height: 100%;
}

.pottery-spotlight {
  position: absolute;
  z-index: 2;
  left: 50%;
  top: 8%;
  width: 66%;
  height: 78%;
  border-radius: 50%;
  background: radial-gradient(ellipse, var(--ui-workshop-highlight) 0, transparent 68%);
  filter: blur(12rpx);
  transform: translateX(-50%);
  pointer-events: none;
}

.stage-tool-rail {
  position: absolute;
  z-index: 32;
  left: var(--space-4);
  top: var(--space-4);
  display: flex;
  gap: var(--space-2);
}

.stage-tool {
  width: 80rpx !important;
  min-width: 80rpx !important;
  height: 80rpx;
  border: 1rpx solid var(--ui-workshop-border) !important;
  border-radius: var(--radius-sm) !important;
  color: var(--color-on-dark);
  background: var(--ui-workshop-panel-soft) !important;
  box-shadow: var(--elevation-1);
  backdrop-filter: blur(14rpx);
  transition: transform var(--motion-fast) var(--ease-enter), background var(--motion-fast) var(--ease-enter);
}

.stage-tool.is-active { background: var(--color-celadon-700) !important; }

.decor-fullscreen-trigger {
  position: absolute;
  z-index: 33;
  top: var(--space-4);
  right: var(--space-4);
  min-width: 136rpx !important;
  min-height: 80rpx;
  padding: 0 var(--space-4) !important;
  gap: var(--space-2);
  color: var(--color-on-dark);
  background: var(--ui-workshop-panel-soft) !important;
  border: 1rpx solid var(--ui-workshop-border) !important;
  box-shadow: var(--elevation-1);
  backdrop-filter: blur(14rpx);
  font-size: var(--type-caption-size) !important;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.fallback-pot {
  position: absolute;
  left: 50%;
  bottom: calc(100% - var(--base-screen-percent) + 46rpx);
  width: 300rpx;
  height: 430rpx;
  border-radius: 34% 34% 42% 42% / 18% 18% 42% 42%;
  background: linear-gradient(100deg, var(--color-celadon-300), var(--color-on-dark) 48%, var(--color-celadon-500));
  box-shadow: inset 22rpx 0 32rpx var(--ui-workshop-highlight), 0 26rpx 54rpx var(--ui-workshop-shadow);
  transform: translateX(-50%);
}

.fallback-pot::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -18rpx;
  width: 112rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-workshop-surface);
  box-shadow: inset 0 10rpx 12rpx var(--ui-workshop-shadow), 0 0 0 10rpx var(--color-on-dark-muted);
  transform: translateX(-50%);
}

.fallback-pot.shape-bowl { width: 390rpx; height: 260rpx; border-radius: 18% 18% 48% 48% / 12% 12% 70% 70%; }
.fallback-pot.shape-cup { width: 250rpx; height: 330rpx; border-radius: 24% 24% 36% 36%; }
.fallback-pot.shape-jar { width: 360rpx; height: 390rpx; border-radius: 28% 28% 44% 44% / 16% 16% 40% 40%; }
.fallback-pot.shape-plate { width: 440rpx; height: 150rpx; border-radius: 50%; }

.fallback-note {
  position: absolute;
  right: var(--space-4);
  bottom: var(--space-4);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  color: var(--color-on-dark-muted);
  background: var(--ui-workshop-panel-muted);
  font-size: var(--type-caption-size);
  line-height: var(--type-caption-line);
}

.fallback-decor {
  position: absolute;
  z-index: 13;
  left: 50%;
  top: 48%;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--color-cobalt);
  transform: translate(-50%, -50%);
}

.fallback-decor > text { font-family: var(--font-display); font-size: var(--type-display-size); line-height: var(--type-display-line); }
.fallback-decor > small { margin-top: var(--space-2); font-size: var(--type-caption-size); line-height: var(--type-caption-line); }
.fallback-inscription { position: absolute; z-index: 14; right: 30%; bottom: 24%; color: var(--color-cinnabar); font-family: var(--font-display); font-size: var(--type-body-sm-size); }

.wheel-root {
  position: absolute;
  z-index: 12;
  left: 50%;
  bottom: var(--space-2);
  width: 560rpx;
  height: 132rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.wheel-contact-anchor { position: absolute; left: 50%; top: 18rpx; width: 2rpx; height: 2rpx; }
.contact-shadow { position: absolute; z-index: 2; left: 50%; top: 8rpx; width: var(--contact-shadow-width); height: 30rpx; border-radius: 50%; background: var(--ui-workshop-shadow); filter: blur(8rpx); transform: translateX(-50%); }
.wheel-head { position: absolute; inset: 10rpx 0 auto; height: 104rpx; border: 2rpx solid var(--ui-workshop-border); border-radius: 50%; overflow: hidden; background: radial-gradient(ellipse, var(--color-on-dark-muted) 0, var(--color-celadon-700) 42%, var(--color-workshop-surface) 76%); box-shadow: 0 18rpx 30rpx var(--ui-workshop-shadow); }
.wheel-head-spin { position: absolute; inset: 0; border-radius: inherit; }
.machined-rings { position: absolute; inset: 12rpx 34rpx; border: 2rpx solid var(--ui-workshop-highlight); border-radius: 50%; box-shadow: inset 0 0 0 12rpx transparent, inset 0 0 0 14rpx var(--ui-workshop-highlight); }
.slip-mark { position: absolute; left: 50%; top: 50%; width: 62%; height: 2rpx; background: var(--ui-workshop-highlight); transform: translate(-50%, -50%) rotate(7deg); }
.wheel-glint { position: absolute; left: 18%; top: 20%; width: 48%; height: 18%; border-radius: 50%; background: var(--ui-workshop-highlight); filter: blur(6rpx); }
.wheel-spinning .wheel-head-spin { animation: wheel-turn var(--wheel-period) linear infinite; }
.wheel-paused .wheel-head-spin,
.reduce-motion .wheel-head-spin { animation-play-state: paused; }

@keyframes wheel-turn { to { transform: rotate(360deg); } }

.stage-footer,
.glaze-bottom,
.tray-bottom {
  position: relative;
  z-index: 40;
  min-height: 112rpx;
  padding: var(--space-2) var(--space-4) calc(var(--space-2) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  flex: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: var(--space-3);
  color: var(--color-on-dark);
  background: var(--ui-workshop-panel);
  border-top: 1rpx solid var(--ui-workshop-border);
  box-shadow: 0 -16rpx 40rpx var(--ui-workshop-shadow);
  backdrop-filter: blur(18rpx);
}

.stagebar-prev,
.stagebar-next {
  min-height: 80rpx;
  padding: 0 var(--space-4) !important;
  gap: var(--space-2);
  font-size: var(--type-body-size) !important;
}

.stagebar-prev { justify-self: start; color: var(--color-on-dark-muted) !important; border: 1rpx solid var(--ui-workshop-border) !important; }
.stagebar-next { justify-self: end; color: var(--ui-action-text) !important; background: var(--color-celadon-300) !important; font-weight: 600; }
.stage-footer-title { min-width: 120rpx; color: var(--color-on-dark); font-family: var(--font-display); font-size: var(--type-h3-size); line-height: var(--type-h3-line); text-align: center; }
.stagebar-info,
.tool-hint { max-width: 260rpx; overflow: hidden; color: var(--color-on-dark-muted); font-size: var(--type-caption-size); line-height: var(--type-caption-line); text-align: center; text-overflow: ellipsis; white-space: nowrap; }

.tray { position: relative; z-index: 40; flex: none; background: var(--ui-workshop-panel); border-top: 1rpx solid var(--ui-workshop-border); }
.tool-scroll { width: 100%; max-height: 120rpx; }
.tool-row { min-height: 112rpx; padding: var(--space-2) var(--space-4); box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: var(--space-3); }
.tool { min-width: 152rpx !important; min-height: 88rpx; padding: 0 var(--space-4) !important; gap: var(--space-2); color: var(--color-on-dark-muted) !important; border: 1rpx solid var(--ui-workshop-border) !important; }
.tool.active { color: var(--ui-action-text) !important; background: var(--color-celadon-300) !important; border-color: var(--color-celadon-300) !important; }

.hint {
  position: absolute;
  z-index: 35;
  left: 50%;
  bottom: var(--space-6);
  width: calc(100% - 64rpx);
  max-width: 620rpx;
  min-height: 80rpx;
  padding: var(--space-3) var(--space-3) var(--space-3) var(--space-6);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  color: var(--color-on-dark);
  background: var(--ui-workshop-panel);
  border: 1rpx solid var(--ui-workshop-border);
  border-radius: var(--radius-md);
  box-shadow: var(--elevation-2);
  transform: translateX(-50%);
}

.hint > text { min-width: 0; flex: 1; font-size: var(--type-body-sm-size); line-height: var(--type-body-sm-line); }
.hint > button { width: 80rpx !important; min-width: 80rpx !important; height: 80rpx; }

.decor-fullscreen .safe-top,
.decor-fullscreen .topbar,
.decor-fullscreen .stage-progress,
.decor-fullscreen .stage-tool-rail,
.decor-fullscreen .decor-tray { display: none; }
.decor-fullscreen .stage-area { flex: 1; }
.decor-fullscreen .decor-fullscreen-trigger { top: calc(env(safe-area-inset-top) + var(--space-4)); }

.reduce-motion .stage-tool,
.reduce-motion .decor-fullscreen-trigger,
.reduce-motion .hint,
.reduce-motion .wheel-head-spin { animation: none !important; transition: none !important; }

@media (max-width: 340px) {
  .topbar { grid-template-columns: 96rpx minmax(0, 1fr) 96rpx; padding: 0 var(--space-3); }
  .top-exit { min-width: 88rpx !important; }
  .topbar-balance { width: 96rpx; }
  .save-state { display: none; }
  .stage-progress { padding: 0 var(--space-4); }
  .stage-progress-line { left: calc(var(--space-4) + 20rpx); right: calc(var(--space-4) + 20rpx); }
  .stage-tool-rail { left: var(--space-3); }
  .decor-fullscreen-trigger { right: var(--space-3); }
  .stage-footer,
  .glaze-bottom,
  .tray-bottom { padding-left: var(--space-3); padding-right: var(--space-3); gap: var(--space-2); }
  .stagebar-prev,
  .stagebar-next { padding: 0 var(--space-3) !important; }
}

@media (max-height: 700px) {
  .topbar { min-height: 80rpx; }
  .stage-progress { height: 48rpx; }
  .stage-progress-mark { width: 34rpx; height: 34rpx; }
  .stage-tool-rail,
  .decor-fullscreen-trigger { top: var(--space-2); }
  .wheel-root { width: 500rpx; height: 112rpx; }
  .stage-footer,
  .glaze-bottom,
  .tray-bottom { min-height: 96rpx; padding-top: var(--space-1); padding-bottom: calc(var(--space-1) + env(safe-area-inset-bottom)); }
}
