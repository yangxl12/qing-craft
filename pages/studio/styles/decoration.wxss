  line-height: var(--type-micro-line);
}

.decor-selected-panel { display: grid; grid-template-rows: 80rpx minmax(0, 1fr); }
.decor-selected-head { min-width: 0; padding: 0 var(--space-3); display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); border-bottom: 1rpx solid var(--ui-border); }
.decor-selected-head > view { min-width: 0; display: flex; flex-direction: column; }
.decor-selected-head > view > small { color: var(--color-text-secondary); font-size: var(--type-micro-size); line-height: var(--type-micro-line); }
.decor-selected-head > view > text { overflow: hidden; font-family: var(--font-display); font-size: var(--type-body-size); line-height: var(--type-body-line); text-overflow: ellipsis; white-space: nowrap; }
.decor-selected-head > text { min-width: 48rpx; height: 48rpx; padding: 0 var(--space-2); box-sizing: border-box; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; color: var(--ui-action-text); background: var(--ui-action); font-family: var(--font-data); font-size: var(--type-caption-size); line-height: var(--type-caption-line); }
.decor-selected-empty { height: 100%; padding: var(--space-4); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--color-text-secondary); text-align: center; }
