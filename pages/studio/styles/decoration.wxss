.decor-stage .pottery-spotlight { width: 58%; height: 72%; }

.decor-tool-panel {
  position: absolute;
  z-index: 36;
  left: auto;
  right: var(--space-4);
  top: 120rpx;
  width: 132rpx;
  box-sizing: border-box;
  color: var(--color-on-dark);
  background: var(--ui-workshop-panel);
  border: 1rpx solid var(--ui-workshop-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--elevation-2);
  backdrop-filter: blur(18rpx);
  overflow: hidden;
  animation: decor-tool-enter var(--motion-overlay) var(--ease-enter) both;
}

.decor-tool-panel.collapsed { width: 132rpx; }
.decor-tool-head {
  min-height: 0;
  height: 56rpx;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border-bottom: 1rpx solid var(--ui-workshop-border);
}
.decor-tool-drag {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
.decor-drag-icon {
  width: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, 6rpx);
  grid-auto-rows: 6rpx;
  gap: 5rpx;
  transform: rotate(90deg);
}
.decor-drag-icon > view { width: 6rpx; height: 6rpx; border-radius: var(--radius-full); background: var(--color-on-dark-muted); }
.decor-tool-title { display: none; }
.decor-tool-fold {
  flex: none;
  width: 56rpx !important;
  min-width: 0 !important;
  height: 100% !important;
  border-left: 1rpx solid var(--ui-workshop-border) !important;
  border-top: 0 !important;
  border-radius: 0 !important;
  padding: 0 !important;
}
.decor-tool-actions {
  padding: var(--space-1);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-1);
}
.decor-tool-actions.is-collapsed { display: none; }

.decor-tool-command,
.decor-axis-command {
  min-height: 56rpx;
  color: var(--color-text) !important;
  background: var(--ui-porcelain-panel-solid) !important;
  border: 1rpx solid var(--ui-porcelain-border) !important;
  border-radius: var(--radius-sm);
}

.decor-tool-command {
  width: 100% !important;
  min-width: 0 !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
.decor-tool-command.danger { color: var(--color-danger) !important; }
.decor-axis-command {
  grid-column: 1 / -1;
  width: 100%;
  padding: 0 !important;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-1);
}
.decor-axis-command > button {
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
  height: 48rpx;
  padding: 0 !important;
  color: var(--color-text) !important;
  font-family: var(--font-data);
  font-size: var(--type-body-sm-size) !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
.decor-axis-command > ui-icon { flex: none; }

.decor-tray {
  position: relative;
  z-index: 40;
  flex: none;
  color: var(--color-text);
  background: var(--ui-workshop-panel);
  border-top: 1rpx solid var(--ui-workshop-border);
  box-shadow: 0 -18rpx 46rpx var(--ui-workshop-shadow);
}

.decor-tray-toggle {
  position: absolute;
  z-index: 3;
  right: var(--space-4);
  top: -80rpx;
  min-width: 132rpx !important;
  min-height: 80rpx;
  padding: 0 var(--space-4) !important;
  gap: var(--space-2);
  color: var(--color-on-dark) !important;
  background: var(--ui-workshop-panel) !important;
  border: 1rpx solid var(--ui-workshop-border) !important;
  border-bottom: 0 !important;
  border-radius: var(--radius-md) var(--radius-md) 0 0 !important;
  font-size: var(--type-caption-size) !important;
}

.decor-panel-grid {
  height: 440rpx;
  padding: var(--space-3) var(--space-4);
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  gap: var(--space-3);
  animation: decor-tray-enter var(--motion-overlay) var(--ease-enter) both;
}

.decor-library-panel,
.decor-selected-panel {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  color: var(--color-text);
  background: var(--ui-porcelain-panel);
  border: 1rpx solid var(--ui-porcelain-border);
  border-radius: var(--radius-md);
  box-shadow: 0 10rpx 28rpx var(--ui-porcelain-shadow);
  /* 这两个面板嵌套在 tone-dark 的工坊页面内，需要显式重置为浅色 Token，
     否则侧栏、图案卡片、写款项等会继承到深色背景。 */
  --ui-surface: var(--color-surface);
  --ui-surface-subtle: var(--color-surface-subtle);
  --ui-text: var(--color-text);
  --ui-text-secondary: var(--color-text-secondary);
  --ui-text-tertiary: var(--color-text-tertiary);
  --ui-border: var(--color-border);
  --ui-action: var(--color-celadon-700);
  --ui-action-text: #f8faf6;
  --ui-focus: var(--color-cobalt);
}

.decor-library-panel { display: grid; grid-template-rows: 80rpx minmax(0, 1fr); }
.decor-catalog-tabs { min-width: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1rpx solid var(--ui-border); }
.paint-catalog-tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.decor-catalog-tabs > button { position: relative; min-width: 0; min-height: 80rpx; gap: var(--space-1); border-radius: 0 !important; color: var(--color-text-secondary) !important; font-size: var(--type-caption-size) !important; }
.decor-catalog-tabs > button > small { width: 32rpx; height: 32rpx; border: 1rpx solid var(--ui-border); border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: var(--type-micro-size); line-height: var(--type-micro-line); }
.decor-catalog-tabs > button > text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.decor-catalog-tabs > button.active { color: var(--ui-action) !important; font-weight: 600; }
.decor-catalog-tabs > button.active::after { content: ""; position: absolute; left: var(--space-3); right: var(--space-3); bottom: 0; height: 4rpx; border-radius: var(--radius-full); background: linear-gradient(90deg, var(--color-text), var(--color-celadon-300)); }

.decor-library-body { min-width: 0; min-height: 0; display: grid; grid-template-columns: 108rpx minmax(0, 1fr); }
.decor-side-menu { height: 100%; background: var(--ui-surface-subtle); border-right: 1rpx solid var(--ui-border); }
.decor-side-menu-item { width: 100% !important; min-width: 0 !important; min-height: 88rpx; padding: var(--space-2) 0 !important; display: flex !important; flex-direction: column; gap: var(--space-1); border-radius: 0 !important; color: var(--color-text-secondary) !important; font-size: var(--type-micro-size) !important; }
.decor-side-menu-item > text { font-size: var(--type-micro-size); line-height: var(--type-micro-line); }
.decor-side-menu-icon { width: 48rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.decor-side-menu-item.active { color: var(--ui-action-text) !important; background: var(--ui-action) !important; }

.decor-grid-scroll,
.decor-selected-scroll,
.paint-grid-scroll { height: 100%; min-height: 0; }
.decor-grid { padding: var(--space-2); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
.decor-selected-grid { padding: var(--space-2); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }

.decor-grid-card,
.decor-selected-card {
  position: relative;
  min-width: 0 !important;
  min-height: 112rpx;
  padding: var(--space-2) !important;
  display: flex !important;
  flex-direction: column;
  gap: var(--space-1);
  color: var(--color-text) !important;
  background: var(--ui-surface) !important;
  border: 1rpx solid var(--ui-border) !important;
  border-radius: var(--radius-sm) !important;
  overflow: hidden;
}

.decor-grid-card.checked,
.decor-selected-card.active {
  color: var(--ui-action) !important;
  background: var(--color-celadon-100) !important;
  border: 2rpx solid var(--ui-action) !important;
  box-shadow: inset 0 0 0 2rpx var(--ui-surface);
}

.decor-selected-card.hidden { opacity: 0.46; }
.motif-art { position: relative; width: 64rpx; height: 58rpx; flex: none; display: flex; align-items: center; justify-content: center; color: var(--color-cobalt); }
.motif-art > text { position: relative; z-index: 2; font-family: var(--font-display); font-size: var(--type-h2-size); line-height: var(--type-h2-line); }
.motif-art > view { position: absolute; width: 42rpx; height: 42rpx; border: 2rpx solid currentColor; border-radius: 42% 58% 44% 56%; opacity: 0.36; transform: rotate(22deg); }
.motif-art > view:last-child { transform: rotate(-22deg); }
.motif-ink-2 { color: var(--color-celadon-700); }
.motif-ink-3 { color: var(--color-cobalt); }
.motif-ink-4 { color: var(--color-warning); }
.motif-ink-5 { color: var(--color-cinnabar); }
.motif-ink-6 { color: var(--color-success); }
.decor-grid-name,
.decor-selected-card > text { width: 100%; overflow: hidden; font-size: var(--type-micro-size); line-height: var(--type-micro-line); text-align: center; text-overflow: ellipsis; white-space: nowrap; }

.decor-check {
  position: absolute;
  z-index: 3;
  right: var(--space-1);
  top: var(--space-1);
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-action-text);
  background: var(--ui-action);
}

.decor-copy-badge {
  position: absolute;
  z-index: 4;
  left: var(--space-1);
  top: var(--space-1);
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 var(--space-1);
  box-sizing: border-box;
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-danger-text);
  background: var(--ui-accent);
  font-family: var(--font-data);
  font-size: var(--type-micro-size);
  line-height: var(--type-micro-line);
}

.decor-selected-panel { display: grid; grid-template-rows: 80rpx minmax(0, 1fr); }
.decor-selected-head { min-width: 0; padding: 0 var(--space-3); display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); border-bottom: 1rpx solid var(--ui-border); }
.decor-selected-head > view { min-width: 0; display: flex; flex-direction: column; }
.decor-selected-head > view > small { color: var(--color-text-secondary); font-size: var(--type-micro-size); line-height: var(--type-micro-line); }
.decor-selected-head > view > text { overflow: hidden; font-family: var(--font-display); font-size: var(--type-body-size); line-height: var(--type-body-line); text-overflow: ellipsis; white-space: nowrap; }
.decor-selected-head > text { min-width: 48rpx; height: 48rpx; padding: 0 var(--space-2); box-sizing: border-box; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; color: var(--ui-action-text); background: var(--ui-action); font-family: var(--font-data); font-size: var(--type-caption-size); line-height: var(--type-caption-line); }
.decor-selected-empty { height: 100%; padding: var(--space-4); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--color-text-secondary); text-align: center; }
.decor-selected-empty > text { font-family: var(--font-display); font-size: var(--type-body-size); line-height: var(--type-body-line); }
.decor-selected-empty > small { margin-top: var(--space-2); font-size: var(--type-caption-size); line-height: var(--type-caption-line); }

.seal-panel { grid-column: 1 / -1; min-height: 0; padding: var(--space-3); box-sizing: border-box; display: flex; flex-direction: column; align-items: stretch; gap: var(--space-3); overflow-y: auto; }
.seal-input { width: 100%; height: 80rpx; padding: 0 var(--space-3); box-sizing: border-box; color: var(--color-text); background: var(--ui-surface); border: 1rpx solid var(--ui-border); border-radius: var(--radius-sm); font-family: var(--font-display); font-size: var(--type-body-size); }
.seal-input-placeholder { color: var(--color-text-tertiary); }
.seal-color-row { display: flex; flex-wrap: nowrap; gap: var(--space-2); }
.seal-color { flex: 1; min-width: 0 !important; min-height: 80rpx; padding: var(--space-1) !important; display: flex !important; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-1); color: var(--color-text-secondary) !important; background: var(--ui-surface) !important; border: 1rpx solid var(--ui-border) !important; border-radius: var(--radius-sm) !important; }
.seal-color.active { color: var(--ui-action) !important; border: 2rpx solid var(--ui-action) !important; }
.seal-color-chip { width: 28rpx; height: 28rpx; border: 1rpx solid var(--ui-border); border-radius: var(--radius-full); }
.seal-color-name { max-width: 100%; overflow: hidden; font-size: var(--type-micro-size); line-height: var(--type-micro-line); text-overflow: ellipsis; white-space: nowrap; }
.seal-apply { width: 66%; min-height: 72rpx; padding: 0 var(--space-4) !important; align-self: center; color: var(--ui-action-text) !important; background: var(--ui-action) !important; border-radius: var(--radius-sm) !important; font-size: var(--type-body-sm-size) !important; font-weight: 600; }

.decor-bottom {
  min-height: 104rpx;
  padding: var(--space-2) var(--space-4) calc(var(--space-2) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: var(--space-3);
  border-top: 1rpx solid var(--ui-workshop-border);
}

.decor-previous,
.decor-complete { width: 88rpx !important; min-width: 88rpx !important; min-height: 88rpx; padding: 0 !important; gap: 0; }
.decor-previous { justify-self: start; color: var(--color-on-dark-muted) !important; border: 1rpx solid var(--ui-workshop-border) !important; }
.decor-complete { justify-self: end; color: var(--ui-action-text) !important; background: var(--color-celadon-300) !important; font-weight: 600; }
.decor-tray.collapsed .decor-bottom { min-height: 112rpx; }

.paint-fired-peek {
  position: absolute;
  z-index: 4;
  left: var(--space-4);
  top: -80rpx;
  min-width: 190rpx !important;
  min-height: 80rpx;
  padding: 0 var(--space-4) !important;
  gap: var(--space-2);
  color: var(--ui-kiln-muted) !important;
  background: var(--ui-kiln-panel) !important;
  border: 1rpx solid var(--ui-kiln-border) !important;
  border-bottom: 0 !important;
  border-radius: var(--radius-md) var(--radius-md) 0 0 !important;
  font-size: var(--type-caption-size) !important;
}
.paint-fired-peek.active { color: var(--ui-kiln-text) !important; background: var(--color-kiln) !important; }
.paint-library-body { grid-template-columns: minmax(0, 1fr); }
.paint-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.paint-pigment-art { width: 64rpx; height: 58rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.paint-pigment-dish { width: 48rpx; height: 28rpx; padding: 4rpx; box-sizing: border-box; border: 1rpx solid var(--ui-border); border-radius: 50%; background: var(--ui-surface-subtle); }
.paint-pigment-dish > view { width: 100%; height: 100%; border-radius: 50%; }
.paint-pigment-art > text { font-size: var(--type-micro-size); line-height: var(--type-micro-line); }
.paint-layer-swatch { position: absolute; left: var(--space-1); bottom: var(--space-1); width: 24rpx; height: 24rpx; border: 1rpx solid var(--ui-border); border-radius: var(--radius-full); }

@keyframes decor-tool-enter { from { opacity: 0; transform: translateY(-12rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes decor-tray-enter { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }

@media (max-width: 340px) {
  .decor-tool-panel { right: var(--space-3); width: 124rpx; }
  .decor-tool-panel.collapsed { width: 124rpx; }
  .decor-tool-head { height: 52rpx; }
  .decor-tool-fold { width: 52rpx !important; }
  .decor-tool-command,
  .decor-axis-command { min-height: 52rpx; }
  .decor-axis-command > button { height: 44rpx; }
  .decor-panel-grid { padding-left: var(--space-3); padding-right: var(--space-3); gap: var(--space-2); }
  .decor-library-body { grid-template-columns: 96rpx minmax(0, 1fr); }
  .decor-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .paint-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .decor-bottom { padding-left: var(--space-3); padding-right: var(--space-3); gap: var(--space-2); }
  .decor-previous,
  .decor-complete { width: 80rpx !important; min-width: 80rpx !important; min-height: 80rpx; }
}

@media (max-height: 700px) {
  .decor-tool-panel { top: 104rpx; }
  .decor-tool-head { height: 52rpx; }
  .decor-tool-fold { width: 52rpx !important; }
  .decor-tool-command,
  .decor-axis-command { min-height: 52rpx; }
  .decor-axis-command > button { height: 44rpx; }
  .decor-panel-grid { height: 300rpx; }
  .decor-library-panel,
  .decor-selected-panel { grid-template-rows: 72rpx minmax(0, 1fr); }
  .decor-catalog-tabs > button { min-height: 72rpx; }
  .decor-selected-head { min-height: 72rpx; }
  .decor-grid-card,
  .decor-selected-card { min-height: 96rpx; }
  .decor-bottom { min-height: 96rpx; padding-top: var(--space-1); padding-bottom: calc(var(--space-1) + env(safe-area-inset-bottom)); }
  .seal-panel { padding: var(--space-2); gap: var(--space-2); }
}
