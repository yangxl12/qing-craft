  color: var(--color-on-dark);
  background: var(--ui-workshop-panel);
  border: 1rpx solid var(--ui-workshop-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--elevation-2);
  backdrop-filter: blur(18rpx);
  overflow: hidden;
  animation: decor-tool-enter var(--motion-overlay) var(--ease-enter) both;
}

.decor-tool-panel.collapsed { width: 165rpx; }
.decor-tool-head {
  min-height: 0;
  height: 70rpx;
