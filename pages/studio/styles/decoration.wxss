  align-items: center;
  justify-content: center;
}
.decor-tool-command.danger { color: var(--color-danger) !important; }
.decor-axis-command {
  grid-column: 1 / -1;
  width: 100%;
  padding: 0 !important;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-2);
}
.decor-axis-command > button {
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
  height: 60rpx;
  padding: 0 !important;
  color: var(--color-text) !important;
  font-family: var(--font-data);
  font-size: var(--type-body-sm-size) !important;
  display: flex;
  align-items: center;
  justify-content: center;
