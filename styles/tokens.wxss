page {
  /* Brand and material palette */
  --color-celadon-100: #dce7e2;
  --color-celadon-300: #9cb9ac;
  --color-celadon-500: #648b7d;
  --color-celadon-700: #365a51;
  --color-cobalt: #35657a;
  --color-cinnabar: #984b42;
  --color-kiln: #b36a3c;

  /* Neutral and workshop palette */
  --color-bg: #f2f4ef;
  --color-surface: #fafbf7;
  --color-surface-subtle: #e5eae5;
  --color-border: #cbd3cd;
  --color-text: #202923;
  --color-text-secondary: #53615a;
  --color-text-tertiary: #657269;
  --color-workshop-bg: #16211e;
  --color-workshop-surface: #22322d;
  --color-on-dark: #f2f4ee;
  --color-on-dark-muted: #c4cec8;

  /* Functional palette */
  --color-success: #3f745b;
  --color-warning: #8b5a1f;
  --color-danger: #9c3f38;
  --color-info: #35657a;

  /* Semantic light scene */
  --ui-bg: var(--color-bg);
  --ui-surface: var(--color-surface);
  --ui-surface-subtle: var(--color-surface-subtle);
  --ui-text: var(--color-text);
  --ui-text-secondary: var(--color-text-secondary);
  --ui-text-tertiary: var(--color-text-tertiary);
  --ui-border: var(--color-border);
  --ui-action: var(--color-celadon-700);
  --ui-action-text: #f8faf6;
  --ui-accent: var(--color-cinnabar);
  --ui-accent-text: #fff9f4;
  --ui-danger: var(--color-danger);
  --ui-danger-text: #fff9f4;
  --ui-focus: var(--color-cobalt);
  --ui-overlay: rgba(12, 22, 19, 0.58);
  --ui-disabled-opacity: 0.46;

  /* Stable semantic surfaces for immersive workshop scenes. */
  --ui-workshop-panel: rgba(34, 50, 45, 0.94);
  --ui-workshop-panel-soft: rgba(34, 50, 45, 0.86);
  --ui-workshop-panel-muted: rgba(22, 33, 30, 0.72);
  --ui-workshop-border: rgba(196, 206, 200, 0.28);
  --ui-workshop-highlight: rgba(242, 244, 238, 0.12);
  --ui-workshop-shadow: rgba(5, 12, 10, 0.42);
  --ui-workshop-scrim: rgba(10, 20, 17, 0.66);
  --ui-workshop-scrim-strong: rgba(8, 16, 14, 0.82);
  --ui-porcelain-panel: rgba(250, 251, 247, 0.94);
  --ui-porcelain-panel-solid: #fafbf7;
  --ui-porcelain-panel-muted: rgba(242, 244, 239, 0.9);
  --ui-porcelain-border: rgba(54, 90, 81, 0.24);
  --ui-porcelain-shadow: rgba(9, 24, 20, 0.26);
  --ui-kiln-panel: rgba(33, 24, 20, 0.9);
  --ui-kiln-border: rgba(244, 210, 174, 0.28);
  --ui-kiln-text: #fff4e7;
  --ui-kiln-muted: #e7cfb6;
  --ui-kiln-track: rgba(255, 241, 222, 0.18);

  /* Content-scene surfaces and artwork */
  --ui-content-backdrop: radial-gradient(140% 64% at 50% -14%, #fafbf7 0%, #f2f4ef 66%, #e9eee9 100%);
  --ui-selected-surface: #e7efeb;
  --ui-pressed-surface: #edf1ed;
  --ui-paper-grain: repeating-linear-gradient(17deg, rgba(32, 41, 35, 0.018) 0, rgba(32, 41, 35, 0.018) 1rpx, transparent 1rpx, transparent 10rpx), repeating-linear-gradient(103deg, rgba(255, 255, 255, 0.2) 0, rgba(255, 255, 255, 0.2) 1rpx, transparent 1rpx, transparent 14rpx);
  --ui-media-overlay: linear-gradient(180deg, rgba(18, 33, 29, 0) 52%, rgba(18, 33, 29, 0.78) 100%);
  --ui-media-chip: rgba(22, 33, 30, 0.84);
  --ui-media-text: #f2f4ee;
  --ui-media-text-muted: #dce4df;
  --ui-preview-background: radial-gradient(130% 100% at 50% 0%, #f1f4f0 0%, #dce4de 100%);
  --ui-preview-background-complete: radial-gradient(130% 100% at 50% 0%, #405149 0%, #1d2a26 100%);
  --ui-pottery-preview: linear-gradient(100deg, #7f9f91 0%, #e2ebe5 48%, #6d8f81 100%);
  --ui-pottery-preview-complete: linear-gradient(100deg, #b8c9c0 0%, #f1f5ef 48%, #96ac9f 100%);
  --ui-pottery-shadow: rgba(32, 41, 35, 0.28);
  --ui-hero-placeholder: #d7e1dc;

  /* 成品展台：与展柜主光（左上）对应的圆柱配色与渐变 */
  --ui-plinth-floor-shadow: rgba(2, 6, 5, 0.55);
  --ui-plinth-wall-grad: linear-gradient(90deg, #4a6056 0%, #6a8077 10%, #5f7569 24%, #566c62 40%, #4a6056 50%, #3a4d44 64%, #2c3c36 78%, #243330 92%, #1e2a27 100%);
  --ui-plinth-wall-shade: linear-gradient(180deg, rgba(0, 0, 0, 0) 52%, rgba(0, 0, 0, 0.18) 80%, rgba(0, 0, 0, 0.36) 100%);
  --ui-plinth-top-grad: linear-gradient(180deg, #3a4f45 0%, #2c3e37 60%, #243330 100%);
  --ui-plinth-top-warm: radial-gradient(70% 80% at 28% 24%, rgba(248, 238, 212, 0.32) 0%, rgba(248, 238, 212, 0.10) 30%, rgba(0, 0, 0, 0) 58%);
  --ui-plinth-top-dark: radial-gradient(50% 55% at 80% 80%, rgba(0, 0, 0, 0.20) 0%, rgba(0, 0, 0, 0) 72%);
  --ui-plinth-rim: rgba(242, 244, 238, 0.28);
  --ui-plinth-back-shade: rgba(0, 0, 0, 0.22);
  --ui-plinth-groove: rgba(242, 244, 238, 0.16);
  --ui-plinth-groove-shade: rgba(0, 0, 0, 0.30);
  --ui-plinth-cast: rgba(4, 8, 7, 0.32);
  --ui-plinth-ao: rgba(4, 8, 7, 0.5);

  /* 制坯陶轮：与工坊主光（右上）对应的圆盘配色与渐变 */
  --ui-wheel-edge-grad: linear-gradient(180deg, #1a2522 0%, #131d1a 58%, #0b1411 100%);
  --ui-wheel-edge-shadow: 0 20rpx 30rpx rgba(0, 0, 0, 0.55);
  --ui-wheel-face-grad: linear-gradient(158deg, #3d5249 0%, #2c3b35 48%, #1d2724 100%);
  --ui-wheel-face-warm: radial-gradient(95% 80% at 72% 24%, rgba(230, 240, 232, 0.28) 0%, rgba(230, 240, 232, 0.08) 30%, rgba(0, 0, 0, 0) 58%);
  --ui-wheel-face-dark: radial-gradient(70% 60% at 22% 78%, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0) 64%);
  --ui-wheel-rim: rgba(242, 244, 238, 0.22);
  --ui-wheel-back-shade: rgba(0, 0, 0, 0.38);
  --ui-wheel-spin-grad: conic-gradient(from 0deg, rgba(255, 255, 255, 0) 0deg, rgba(238, 246, 238, 0.22) 36deg, rgba(255, 255, 255, 0.04) 84deg, rgba(0, 0, 0, 0.18) 168deg, rgba(0, 0, 0, 0.02) 224deg, rgba(238, 246, 238, 0.10) 300deg, rgba(255, 255, 255, 0) 360deg);
  --ui-wheel-contact: rgba(4, 8, 7, 0.5);

  /* Type roles */
  --font-display: "Songti SC", "STSong", "SimSun", serif;
  --font-body: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-data: SFMono-Regular, Menlo, Consolas, monospace;
  --type-display-size: 52rpx;
  --type-display-line: 68rpx;
  --type-h1-size: 44rpx;
  --type-h1-line: 60rpx;
  --type-h2-size: 36rpx;
  --type-h2-line: 52rpx;
  --type-h3-size: 32rpx;
  --type-h3-line: 46rpx;
  --type-body-lg-size: 30rpx;
  --type-body-lg-line: 46rpx;
  --type-body-size: 28rpx;
  --type-body-line: 42rpx;
  --type-body-sm-size: 26rpx;
  --type-body-sm-line: 38rpx;
  --type-caption-size: 24rpx;
  --type-caption-line: 34rpx;
  --type-micro-size: 22rpx;
  --type-micro-line: 30rpx;

  /* Spacing */
  --space-1: 4rpx;
  --space-2: 8rpx;
  --space-3: 12rpx;
  --space-4: 16rpx;
  --space-6: 24rpx;
  --space-8: 32rpx;
  --space-10: 40rpx;
  --space-12: 48rpx;
  --space-16: 64rpx;
  --page-gutter: 32rpx;

  /* Shape and depth */
  --radius-xs: 8rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-hero: 40rpx;
  --radius-full: 999rpx;
  --elevation-1: 0 10rpx 28rpx rgba(32, 41, 35, 0.08);
  --elevation-2: 0 16rpx 40rpx rgba(22, 33, 30, 0.16);
  --elevation-3: 0 24rpx 72rpx rgba(10, 18, 16, 0.28);

  /* Motion and layers */
  --motion-instant: 80ms;
  --motion-fast: 120ms;
  --motion-base: 180ms;
  --motion-overlay: 280ms;
  --motion-stage: 420ms;
  --ease-enter: cubic-bezier(0.2, 0, 0, 1);
  --ease-exit: cubic-bezier(0.4, 0, 1, 1);
  --z-nav: 60;
  --z-overlay: 80;
  --z-modal: 100;

  /* Migration aliases. Pages must not redefine these with new meanings. */
  --paper: var(--ui-bg);
  --ash: var(--ui-surface-subtle);
  --ink: var(--ui-text);
  --ink-soft: var(--ui-text-secondary);
  --celadon: var(--color-celadon-500);
  --celadon-deep: var(--ui-action);
  --clay: #b59d83;
  --ember: var(--color-kiln);
  --cobalt: var(--color-cobalt);
}

.tone-dark {
  --ui-bg: var(--color-workshop-bg);
  --ui-surface: var(--color-workshop-surface);
  --ui-surface-subtle: #2d3e38;
  --ui-text: var(--color-on-dark);
  --ui-text-secondary: var(--color-on-dark-muted);
  --ui-text-tertiary: #aebbb4;
  --ui-border: rgba(196, 206, 200, 0.24);
  --ui-action: var(--color-celadon-300);
  --ui-action-text: var(--color-workshop-bg);
  --ui-focus: var(--color-celadon-300);
  --ui-overlay: rgba(4, 10, 9, 0.7);
  color: var(--ui-text);
}

/* Nested light surfaces, such as export preview, can reset a dark page. */
.tone-light {
  --ui-bg: var(--color-bg);
  --ui-surface: var(--color-surface);
  --ui-surface-subtle: var(--color-surface-subtle);
  --ui-text: var(--color-text);
  --ui-text-secondary: var(--color-text-secondary);
  --ui-text-tertiary: var(--color-text-tertiary);
  --ui-border: var(--color-border);
  --ui-action: var(--color-celadon-700);
  --ui-action-text: #f8faf6;
  --ui-focus: var(--color-cobalt);
  color: var(--ui-text);
}
